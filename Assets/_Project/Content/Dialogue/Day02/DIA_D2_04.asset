%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_04
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_04
  lines:
  - id: D2-04_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uBCF4\uC548\uC2E4 \uBCBD\uC5D0\uB294 \uAC19\uC740 \uBCF5\uB3C4\uAC00
      \uC11C\uB85C \uB2E4\uB978 \uC2DC\uAC04\uC73C\uB85C \uBC18\uBCF5\uB418\uACE0
      \uC788\uC5C8\uB2E4. \uB9C8\uCEE4\uC2A4\uB294 \uC601\uC0C1\uB9CC\uC73C\uB85C
      \uACB0\uB860 \uB0B4\uB9AC\uB824\uB294 \uC0AC\uB78C\uCC98\uB7FC \uD0C0\uC784\uB77C\uC778\uC744
      \uBE60\uB974\uAC8C \uB118\uACBC\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_002
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "21\uC2DC\uBD80\uD130 \uBC1C\uACAC\uAE4C\uC9C0 \uD638\uB77C\uC774\uC98C
      \uB8F8 \uBCF5\uB3C4\uC5D0 \uCD9C\uC785\uC790\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB9AC\uCC98\uB4DC\uC640 \uB2F9\uC2E0\uC774 22\uC2DC 43\uBD84\uC5D0 \uB3C4\uCC29\uD55C
      \uAC8C \uC804\uBD80\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC601\uC0C1\uC774 \uBCF4\uC9C0 \uBABB\uD55C \uAC74 \uBB61\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_004
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uBB38 \uC704\uCABD \uCC9C\uC7A5, \uC11C\uBE44\uC2A4 \uC124\uBE44, \uCE74\uBA54\uB77C
      \uB4A4\uD3B8. \uD558\uC9C0\uB9CC \uC0AC\uB78C\uC740 \uBABB \uC9C0\uB098\uAC11\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D2-04_C1
      text: "\uC601\uC0C1\uB9CC \uBCF4\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 5be9fe33242376743b50de0ce9646732, type: 2}
      nextLineId: D2-04_007
    - id: D2-04_C2
      text: "\uC124\uBE44 \uB85C\uADF8 \uB300\uC870"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 8ea96230c13708c49bc2981c607359b0, type: 2}
      nextLineId: D2-04_010
  - id: D2-04_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "22\uC2DC 15\uBD84\uBD80\uD130 \uB2E4\uC2DC. \uD504\uB808\uC784 \uB2E8\uC704\uB85C
      \uBCF4\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 3390b272f8310c245ab50580791ea1fb, type: 2}
    effects: []
    choices: []
  - id: D2-04_008
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC601\uC0C1\uC5D0\uB294 \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB300\uC2E0 \uC138 \uC2DC\uAC04\uC744 \uC4F0\uAC8C \uB418\uACA0\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 3390b272f8310c245ab50580791ea1fb, type: 2}
    effects: []
    choices: []
  - id: D2-04_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB300\uCCB4 \uD68C\uC218: \uBC18\uBCF5 \uAC80\uD1A0 \uD6C4 \uC790\uB3D9
      \uACBD\uBCF4 \uC544\uC774\uCF58\uC774 \uAC15\uC870\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 3390b272f8310c245ab50580791ea1fb, type: 2}
    effects: []
    choices: []
  - id: D2-04_010
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC601\uC0C1 \uC2DC\uAC04\uCD95 \uC704\uC5D0 \uD654\uC7AC\uAC10\uC9C0\uAE30\uC640
      \uC124\uBE44 \uC774\uBCA4\uD2B8\uB97C \uACB9\uCE69\uC2DC\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ac80fcd1a643e394d91b4a65dcb40406, type: 2}
    effects: []
    choices: []
  - id: D2-04_011
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC124\uBE44 \uAE30\uB85D\uC740 \uBCF4\uC548 \uC601\uC0C1\uACFC \uBCC4\uB3C4
      \uC2DC\uC2A4\uD15C\uC785\uB2C8\uB2E4. \uAC19\uC740 \uC2DC\uAC04\uCD95\uC5D0
      \uB9DE\uCDB0 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ac80fcd1a643e394d91b4a65dcb40406, type: 2}
    effects: []
    choices: []
  - id: D2-04_012
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uBD84\uC11D \uCF58\uC194: \uD3D0\uC1C4\uD68C\uB85C \uD654\uBA74\uACFC
      \uC124\uBE44 \uAE30\uB85D \uB3D9\uAE30\uD654]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ac80fcd1a643e394d91b4a65dcb40406, type: 2}
    effects: []
    choices: []
  - id: D2-04_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC601\uC0C1\uC5D0 \uC5C6\uB294 \uBCC0\uD654\uAC00 \uB2E4\uB978 \uC2DC\uC2A4\uD15C\uC5D0\uB294
      \uB0A8\uC558\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC9C1\uC811 \uC2DC\uAC04\uB300\uB97C
      \uC881\uD600 \uBCF4\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ac80fcd1a643e394d91b4a65dcb40406, type: 2}
    effects: []
    choices: []
  - id: D2-04_014
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uBD84\uC11D \uCF58\uC194\uC5D0 \uC124\uBE44 \uB85C\uADF8 \uCC44\uB110\uC774
      \uC5F0\uACB0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ac80fcd1a643e394d91b4a65dcb40406, type: 2}
    effects: []
    choices: []
  - id: D2-04_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC601\uC0C1\uB9CC\uC73C\uB85C \uACB0\uB860\uC744 \uD655\uC815\uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_016
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uCD9C\uC785\uBB38\xB7\uAC10\uC9C0\uAE30\xB7\uC870\uBA85\xB7\uD658\uAE30
      \uAE30\uB85D\uC744 \uBAA8\uB450 \uBD88\uB7EC\uC654\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC19\uC740 \uC2DC\uAC01\uC758 \uAE30\uB85D\uC744 \uACB9\uCCD0 \uBCF4\uBA74
      \uB9F9\uC810\uC774 \uB4DC\uB7EC\uB0A0 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_018
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uCE74\uBA54\uB77C\uC5D0 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC0AC\uAC74\uC740
      \uC601\uC0C1 \uBC16 \uC2DC\uC2A4\uD15C\uC758 \uC2DC\uAC04 \uAE30\uB85D\uACFC
      \uBE44\uAD50\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_019
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "22\uC2DC 18\uBD84 \uC804\uD6C4\uC758 \uBE44\uC601\uC0C1 \uB85C\uADF8\uB97C
      \uCC3E\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_020
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uD654\uC7AC\uAC10\uC9C0\uAE30 \u2018\uCC28\uD3D0 4\uCD08\u2019 \uC774\uBCA4\uD2B8\uB97C
      \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-04_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCE74\uBA54\uB77C\xB7\uC124\uBE44 \uD1B5\uD569 \uBD84\uC11D \uCF58\uC194\uC774
      \uC5F4\uB9BD\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
