%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_01
  lines:
  - id: D2-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC544\uCE68 \uD587\uBE5B\uC740 \uD638\uB77C\uC774\uC98C \uB8F8\uC758
      \uC5BC\uB8E9\uC744 \uB354 \uC120\uBA85\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4.
      \uBC24\uC5D0\uB294 \uD0C8\uCD9C\uAD6C\uCC98\uB7FC \uBCF4\uC774\uB358 \uACF3\uB4E4\uC774
      \uC774\uC81C\uB294 \uB2E8\uC21C\uD55C \uAD6C\uC870\uBB3C\uB85C \uBCF4\uC600\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_002
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uCD9C\uC785\uBB38 \uC678 \uAC00\uB2A5 \uACBD\uB85C\uB294 \uC138 \uACF3\uC785\uB2C8\uB2E4.
      \uC678\uBCBD \uBC1C\uD310, \uACF5\uC870 \uB355\uD2B8, \uC124\uBE44 \uC810\uAC80\uAD6C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC21C\uC11C\uB294 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4. \uC911\uC694\uD55C
      \uAC74 \uAC00\uB2A5\uC131\uC774 \uC544\uB2C8\uB77C \uC0AC\uC6A9 \uD754\uC801\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D2-01_EXT
      text: "\uC678\uBCBD \uBC1C\uD310\uBD80\uD130 \uC870\uC0AC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 26ebac45b2b518b44b59db7d280013c5, type: 2}
      nextLineId: D2-01_007
    - id: D2-01_DUCT
      text: "\uACF5\uC870 \uB355\uD2B8\uBD80\uD130 \uC870\uC0AC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 3ffea1cab423a6e45841e92be164bab4, type: 2}
      nextLineId: D2-01_011
    - id: D2-01_HATCH
      text: "\uC124\uBE44 \uC810\uAC80\uAD6C\uBD80\uD130 \uC870\uC0AC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: beb125cac74dfa64599221fe72c9677f, type: 2}
      nextLineId: D2-01_015
  - id: D2-01_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC678\uBCBD \uBC1C\uD310]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 245895ac81e4bda4197e62b45b60d870, type: 2}
    effects: []
    choices: []
  - id: D2-01_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB09C\uAC04\uC758 \uC5FC\uBD84\uB9C9\uC774 \uB04A\uAE30\uC9C0 \uC54A\uC558\uB2E4.
      \uC816\uC740 \uC2E0\uBC1C\uC774\uB098 \uC190\uC774 \uB2FF\uC558\uB2E4\uBA74
      \uD558\uC580 \uACB0\uC815\uC774 \uC120\uCC98\uB7FC \uC9C0\uC6CC\uC84C\uC5B4\uC57C
      \uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 245895ac81e4bda4197e62b45b60d870, type: 2}
    effects: []
    choices: []
  - id: D2-01_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-03 \uC678\uBCBD \uBC1C\uD310"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 245895ac81e4bda4197e62b45b60d870, type: 2}
    effects: []
    choices: []
  - id: D2-01_010
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uBC1C\uD310 \uC555\uB825 \uC13C\uC11C\uB3C4 21\uC2DC\uBD80\uD130 23\uC2DC
      \uC0AC\uC774 0\uC785\uB2C8\uB2E4. \uD30C\uB3C4 \uCDA9\uACA9 \uC678 \uC0AC\uB78C
      \uBB34\uAC8C\uB294 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 245895ac81e4bda4197e62b45b60d870, type: 2}
    effects: []
    choices: []
  - id: D2-01_011
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uACF5\uC870 \uB355\uD2B8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c2b715a3134f05140ad880f85de12fe7, type: 2}
    effects: []
    choices: []
  - id: D2-01_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB098\uC0AC \uBA38\uB9AC\uC5D0 \uC190\uB304 \uC790\uAD6D\uC774 \uC5C6\uACE0
      \uB0B4\uBD80 \uBA3C\uC9C0\uAC00 \uC785\uAD6C\uBD80\uD130 \uAD74\uACE1\uAE4C\uC9C0
      \uADE0\uC77C\uD558\uB2E4. \uC637\uAC10\uC774\uB098 \uBAB8\uC774 \uC9C0\uB098\uAC08
      \uACF5\uAC04\uB3C4 \uC544\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c2b715a3134f05140ad880f85de12fe7, type: 2}
    effects: []
    choices: []
  - id: D2-01_013
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-04 \uB355\uD2B8 \uBA3C\uC9C0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c2b715a3134f05140ad880f85de12fe7, type: 2}
    effects: []
    choices: []
  - id: D2-01_014
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uB355\uD2B8 \uC9C4\uB3D9 \uC13C\uC11C \uC5ED\uC2DC \uC815\uC0C1\uC785\uB2C8\uB2E4.
      \uCCAD\uC18C \uAE30\uB85D\uB3C4 \uC0AC\uD758 \uC804\uC774 \uB9C8\uC9C0\uB9C9\uC774\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c2b715a3134f05140ad880f85de12fe7, type: 2}
    effects: []
    choices: []
  - id: D2-01_015
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC124\uBE44 \uC810\uAC80\uAD6C]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5655a850ee8c2054d91f0ca7ceefa785, type: 2}
    effects: []
    choices: []
  - id: D2-01_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC2E4\uB9AC\uCF58 \uBD09\uC778\uC774 \uC624\uB798\uB41C \uBA3C\uC9C0\uC640
      \uD568\uAED8 \uC774\uC5B4\uC838 \uC788\uB2E4. \uC5F4\uC5C8\uB2E4\uBA74 \uAC00\uC7A5\uC790\uB9AC\uC758
      \uADE0\uC5F4\uC774 \uB04A\uACBC\uC5B4\uC57C \uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5655a850ee8c2054d91f0ca7ceefa785, type: 2}
    effects: []
    choices: []
  - id: D2-01_017
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-05 \uC810\uAC80\uAD6C \uBA3C\uC9C0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5655a850ee8c2054d91f0ca7ceefa785, type: 2}
    effects: []
    choices: []
  - id: D2-01_018
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC548\uCABD \uD1B5\uB85C\uB294 \uBC30\uAD00 \uB9C9\uB2E4\uB978 \uACF3\uC785\uB2C8\uB2E4.
      \uC131\uC778 \uD55C \uBA85\uC774 \uC228\uC744 \uACF5\uAC04\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5655a850ee8c2054d91f0ca7ceefa785, type: 2}
    effects: []
    choices: []
  - id: D2-01_019
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC790\uB8CC\uB294 \uBAA8\uC600\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370
      \uC11C\uB85C \uC131\uACA9\uC774 \uB2E4\uB978 \uAE30\uB85D\uC744 \uAC19\uC740
      \uAE30\uC900\uC73C\uB85C \uBE44\uAD50\uD574\uB3C4 \uB429\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC19\uC740 \uC9C8\uBB38\uC73C\uB85C \uBE44\uAD50\uD558\uBA74 \uB429\uB2C8\uB2E4.
      \uC774 \uACBD\uB85C\uAC00 \uC0AC\uC6A9\uB410\uB2E4\uBA74 \uBB34\uC5C7\uC774
      \uBC18\uB4DC\uC2DC \uB2EC\uB77C\uC84C\uC5B4\uC57C \uD558\uB294\uAC00."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_021
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uBC1C\uD310\uC740 \uC13C\uC11C\uC640 \uC5FC\uBD84\uB9C9, \uB355\uD2B8\uB294
      \uBA3C\uC9C0\uC640 \uBCBD\uBA74\uC774\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uD558\uB098\uB9CC \uBCF4\uACE0 \uACB0\uB860
      \uB0B4\uB9AC\uC9C0 \uB9D0\uACE0 \uB450 \uAE30\uB85D\uC774 \uD568\uAED8 \uAC00\uB9AC\uD0A4\uB294
      \uCABD\uC744 \uACE0\uB974\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_023
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC810\uAC80\uAD6C\uB3C4 \uB098\uC0AC\uC640 \uBD09\uC778\uC120\uC744 \uD568\uAED8
      \uBD10\uC57C \uD558\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_024
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC138 \uACBD\uB85C\uB97C \uAC01\uAC01 \uD310\uC815\uD55C \uB4A4 \uBB38\uD131
      \uAE30\uB85D\uAE4C\uC9C0 \uD3EC\uD568\uD574 \uD558\uB098\uC758 \uAC00\uC124\uB85C
      \uC124\uBA85\uD574 \uBCF4\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_025
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\u2018\uBC94\uC778\uC774 \uD754\uC801\uC744 \uC644\uBCBD\uD788 \uC9C0\uC6E0\uB2E4\u2019\uB294
      \uAC00\uC124\uC740 \uC138 \uC7A5\uC18C \uBAA8\uB450\uC5D0\uC11C \uC11C\uB85C
      \uB2E4\uB978 \uD754\uC801\uC744 \uB3D9\uC2DC\uC5D0 \uC5C6\uC560\uC57C \uD569\uB2C8\uB2E4.
      \uC124\uBA85\uC774 \uC544\uB2C8\uB77C \uC18C\uC6D0\uC5D0 \uAC00\uAE5D\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_026
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\u2018\uD53C\uD574\uC790\uAC00 \uBC94\uC778\uC744 \uB0B4\uBCF4\uB0C8\uB2E4\u2019\uBA74
      \uBB38\uD131\uC5D0 \uB450 \uBC88\uC9F8 \uC816\uC740 \uBC1C\uC790\uAD6D\uC774
      \uB0A8\uC544\uC57C \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_027
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uACB0\uB860\uC740 \u2018\uBC29\uC5D0\uC11C \uB098\uAC04 \uC0AC\uB78C\uC774
      \uC5C6\uB2E4\u2019\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC0AC\uAC74\uC774 \uC77C\uC5B4\uB09C
      \uC21C\uAC04, \uC0B4\uC544 \uC788\uB294 \uC81C3\uC790\uAC00 \uC774 \uBC29\uC5D0
      \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_028
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC138 \uCD9C\uAD6C\uAC00 \uC5B4\uB5BB\uAC8C \uC0AC\uC6A9\uB410\uB294\uC9C0
      \uCC3E\uC9C0 \uB9D0\uACE0, \uC0AC\uC6A9\uB410\uB2E4\uBA74 \uBC18\uB4DC\uC2DC
      \uB0A8\uC544\uC57C \uD560 \uD754\uC801\uC744 \uBE44\uAD50\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_029
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC5FC\uBD84\uB9C9, \uBA3C\uC9C0, \uBD09\uC778\uC120\uC740 \uC11C\uB85C
      \uB2E4\uB978 \uC885\uB958\uC758 \u2018\uBBF8\uC0AC\uC6A9 \uAE30\uB85D\u2019\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_030
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC138 \uB2E8\uC11C \uCE74\uB4DC\uB97C \uBAA8\uB450 \u2018\uC0AC\uC6A9\uB418\uC9C0
      \uC54A\uC74C\u2019 \uACB0\uB860\uC5D0 \uC5F0\uACB0\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-01_031
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uAC00\uC124 \uD574\uAE08: \uD638\uB77C\uC774\uC98C \uB8F8\uC5D0 \uC0B4\uC544
      \uC788\uB294 \uC81C3\uC790\uB294 \uC5C6\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
