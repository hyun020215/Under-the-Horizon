%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_06
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_06
  lines:
  - id: D2-06_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uAC1D\uC2E4\uC740 \uC218\uC0C9\uB2F9\uD55C \uAC83\uCC98\uB7FC
      \uC5B4\uC9C0\uB7FD\uC9C0 \uC54A\uC558\uB2E4. \uC624\uD788\uB824 \uB108\uBB34
      \uC815\uB3C8\uB418\uC5B4 \uC788\uC5B4, \uB204\uAD70\uAC00 \uD544\uC694\uD55C
      \uAC83\uB9CC \uC815\uD655\uD788 \uAC00\uC838\uAC04 \uB290\uB08C\uC774\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_002
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB178\uD2B8\uBD81 \uC608\uC57D \uAE30\uC0AC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC608\uC57D \uBC1C\uD589 \uC2DC\uAC01\uC740 3\uC77C \uCC28 08:00. \uC81C\uBAA9\uC740
      \u2018\uD638\uC190 \uD68C\uC7A5\uC740 \uC624\uB974\uD398\uC6B0\uC2A4 \uD638\uB97C
      \uCE68\uBAB0\uC2DC\uCF30\uB2E4\u2019. \uC77C\uBD80 \uADFC\uAC70\uB294 \uC775\uBA85
      \uC81C\uBCF4 \uBB38\uC7A5\uB9CC\uC73C\uB85C \uCC44\uC6CC\uC838 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_004
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uAE30\uC0AC \uCD08\uC548"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uACB0\uB860\uC744 \uBA3C\uC800 \uC37C\uC2B5\uB2C8\uB2E4.
      \uC99D\uAC70\uB294 \uBE48\uCE78\uC744 \uCC44\uC6B0\uB294 \uB370 \uC0AC\uC6A9\uD588\uACE0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_006
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC554\uD638\uD654 \uCC44\uD305 \uC77C\uBD80]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC81C\uBCF4\uC790\uB294 \uB9AC\uCC98\uB4DC\uC758 \uB9E4\uC218\uC640 \uBCF4\uD5D8
      \uC99D\uC561 \uC790\uB8CC\uB97C \uC81C\uACF5\uD588\uC9C0\uB9CC, \uBA85\uB839
      \uC8FC\uCCB4\uB97C \uC9C1\uC811 \uBCF4\uC5EC \uC8FC\uB294 \uBB38\uC11C\uB294
      \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_008
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-13 \uC775\uBA85 \uCC44\uD305"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_009
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "\uD68C\uC7A5\uC740 \uC6D0\uBCF8\uC744 \uB450\uB824\uC6CC\uD569\uB2C8\uB2E4.
      \uADF8\uAC00 \uC228\uAE34 \uAC83\uC740 \uC0AC\uACE0\uAC00 \uC544\uB2C8\uB77C
      \uC758\uB3C4\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_010
    speaker:
      character: {fileID: 0}
      overrideName: DANIEL_CHAT
    text: "\uBA85\uB839\uC11C\uC5D0 \uB9AC\uCC98\uB4DC \uC11C\uBA85\uC774 \uC788\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_011
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "\uC11C\uBA85\uBCF4\uB2E4 \uACB0\uACFC\uB97C \uBCF4\uC138\uC694. \uC0AC\uC2E4\uC740
      \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC9C8\uBB38\uC5D0\uB294 \uB2F5\uD558\uC9C0 \uC54A\uACE0 \uD655\uC2E0\uB9CC
      \uAC15\uD654\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_013
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBE44\uC5B4 \uC788\uB294 \uCDA9\uC804 \uB3C4\uD06C]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0DC\uBE14\uB9BF \uCF00\uC774\uBE14\uB9CC \uB0A8\uC544 \uC788\uB2E4.
      \uB2E4\uB2C8\uC5D8\uC740 \uD30C\uD2F0\uC5D0\uC11C \uC791\uC740 \uD0DC\uBE14\uB9BF
      \uAC00\uBC29\uC744 \uB4E4\uACE0 \uC788\uC5C8\uC9C0\uB9CC \uC2DC\uC2E0 \uACC1\uC5D0\uB294
      \uC5C6\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_015
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC0AC\uB77C\uC9C4
      \uD0DC\uBE14\uB9BF"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_016
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB0A8\uC758 \uBC29\uC744 \uB4A4\uC9C0\uB294 \uCDE8\uBBF8\uAC00 \uC788\uC73C\uC2E0
      \uC904\uC740 \uBAB0\uB790\uB124\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uC774 \uC5F4\uB824 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740
      \uC65C \uC654\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_018
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2E4\uB2C8\uC5D8\uC774 \uAC00\uC9C4 \uD68C\uC0AC \uC790\uB8CC\uAC00
      \uC720\uCD9C\uB410\uB294\uC9C0 \uD655\uC778\uD558\uB824\uACE0\uC694. \uBC95\uBB34\uD300
      \uC694\uCCAD\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC95\uBB34\uD300\uC740 \uAC1D\uC2E4 \uC5F4\uC1E0\uB3C4 \uC90D\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_020
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC774 \uBC30\uC5D0\uC11C\uB294 \uC131\uC774 \uC5F4\uC1E0\uBCF4\uB2E4
      \uBE60\uB97C \uB54C\uAC00 \uC788\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_021
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uCE68\uB300 \uC606 \uC11C\uB78D \uC190\uC7A1\uC774\uC5D0 \uD074\uB808\uC5B4\uC758
      \uD5A5\uC218\uC640 \uAC19\uC740 \uB2EC\uCF64\uD55C \uD5A5\uC774 \uD76C\uBBF8\uD558\uAC8C
      \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0DC\uBE14\uB9BF\uC740 \uC0B4\uC778\uC790\uAC00 \uAC00\uC838\uAC14\uC744
      \uC218\uB3C4 \uC788\uACE0, \uC0B4\uC778\uACFC \uBB34\uAD00\uD55C \uB3C4\uB451\uC774
      \uAC00\uC838\uAC14\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uB458\uC744
      \uAC19\uC740 \uC0AC\uB78C\uC73C\uB85C \uB9CC\uB4E4\uBA74 \uC26C\uC6CC\uC9C0\uC9C0\uB9CC
      \uD2C0\uB9B4 \uC218 \uC788\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD074\uB808\uC5B4\uC5D0\uAC8C \uC5F4\uC1E0 \uAE30\uB85D\uC744 \uACF5\uC2DD\uC73C\uB85C
      \uC694\uCCAD\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_024
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC808\uCC28\uB97C \uBB34\uC2DC\uD558\uACE0 \uC9C0\uAE08 \uB2F9\uC7A5
      \uD655\uC778\uD55C\uB2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_025
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC815\uC2DD \uC694\uCCAD \uACB0\uACFC\uB97C \uAE30\uB2E4\uB9B0\uB2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_026
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2F9\uC2E0 \uB9C8\uC74C\uB300\uB85C \uB0A8\uC758 \uBC29 \uAE30\uB85D\uC744
      \uB4A4\uC9C0\uB294 \uAC70\uAD70\uC694. \uC88B\uC544\uC694 \u2014 \uB2E4\uB2C8\uC5D8\uC774
      \uC8FD\uAE30 \uB450 \uC2DC\uAC04 \uC804, \uC81C \uCE74\uB4DC\uB85C \uC774 \uBC29\uC774
      \uD55C \uBC88 \uB354 \uC5F4\uB838\uC5B4\uC694. \uC81C\uAC00 \uADF8\uB7F0 \uAC8C
      \uC544\uB2C8\uC5D0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-06_027
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uD074\uB808\uC5B4 \uC808\uB3C4 \uBCF5\uC120 \uB4F1\uB85D. \uAE30\uC0AC
      \uC608\uC57D \uBC1C\uD589\uC740 \uCDE8\uC18C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
