%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_02
  lines:
  - id: D2-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD5EC\uB808\uB098\uB294 \uD604\uC7A5 \uC0AC\uC9C4\uC744 \uD655\uB300\uD574
      \uD608\uD754 \uC870\uAC01\uC744 \uBC14\uB2E5 \uC9C0\uB3C4 \uC704\uC5D0 \uACB9\uCCE4\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC790\uC0C1\uC5D0\uC11C \uB098\uC628 \uD53C\uB77C\uBA74 \uC0C1\uCC98
      \uBC29\uD5A5\uC744 \uC911\uC2EC\uC73C\uB85C \uC791\uC740 \uBE44\uC0B0\uC810\uC774
      \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uC5EC\uAE30\uC5D0\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB300\uC2E0 \uD070 \uBC29\uC6B8\uC774 \uAC70\uC758 \uC218\uC9C1\uC73C\uB85C
      \uB5A8\uC5B4\uC84C\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_004
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC2DC\uC2E0\uC744 \uC62E\uACBC\uB2E4\uBA74 \uC6C5\uB369\uC774 \uAC00\uC7A5\uC790\uB9AC\uAC00
      \uB04C\uB838\uC744 \uD150\uB370, \uADF8\uB7F0 \uD754\uC801\uB3C4 \uC5C6\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_005
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uD608\uD754 \uBC30\uC5F4 \uD37C\uC990: \uC0AC\uC9C4 \uC870\uAC01\uC744
      \uD68C\uC804\uD574 \uBC14\uB2E5 \uB3C4\uBA74\uACFC \uC77C\uCE58\uC2DC\uD0A4\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0C1\uCC98 \uC544\uB798\uB97C \uC911\uC2EC\uC73C\uB85C \uB9DE\uCD94\uBA74
      \uBCBD\uBA74 \uBE44\uC0B0\uC810\uC774 \uC124\uBA85\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_007
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uD53C\uC758 \uC591\uC740 \uB9DE\uC9C0\uB9CC \uBC29\uD5A5\uC774 \uD2C0\uB838\uC5B4\uC694.
      \uBAB8\uC774 \uC4F0\uB7EC\uC9C0\uBA70 \uD37C\uC9C4 \uD328\uD134\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC6C5\uB369\uC774 \uC911\uC2EC\uC744 \uC5B4\uAE68 \uC704\uB85C \uC62E\uAE30\uBA74
      \uC218\uC9C1 \uB099\uD558 \uBC29\uC6B8\uC774 \uBAA8\uB450 \uC815\uB82C\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uC774 \uC790\uB9AC\uC5D0\uC11C \uD53C\uB97C
      \uD758\uB9AC\uBA70 \uC4F0\uB7EC\uC9C4 \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uC774\uBBF8
      \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294 \uBAB8\uC774 \uC704\uC5D0\uC11C \uB5A8\uC5B4\uC84C\uACE0,
      \uB0A8\uC544 \uC788\uB358 \uD53C\uAC00 \uB098\uC911\uC5D0 \uACE0\uC600\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_010
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uADF8\uB807\uB2E4\uBA74 \uC790\uC0C1 \uC2DC\uAC01\uACFC \uC0AC\uB9DD
      \uC2DC\uAC01\uB3C4 \uBD84\uB9AC\uD574\uC57C \uD574\uC694. \uC0C1\uCC98\uAC00
      \uB9C8\uC9C0\uB9C9 \uC0AC\uAC74\uC774 \uC544\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD53C\uD574\uC790\uB294 \uD55C \uBC88 \uC4F0\uB7EC\uC9C4 \uAC8C \uC544\uB2C8\uB77C
      \uB450 \uBC88 \uBC30\uCE58\uB410\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_012
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uD608\uD754 \uC911\uC2EC \uC624\uBC84\uB808\uC774]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0C1\uCC98 \uC704\uCE58\uC640 \uC6C5\uB369\uC774 \uC911\uC2EC \uC0AC\uC774\uC5D0
      43cm \uCC28\uC774\uAC00 \uC788\uB2E4. \uCC9C\uC7A5 \uD328\uB110 \uBC14\uB85C
      \uC544\uB798\uC640 \uC77C\uCE58\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_014
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-07 \uD608\uD754 \uC911\uC2EC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_015
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uBE44\uC0B0\uD608\uD754\uC774 \uC5C6\uB294 \uC810\uACFC \uD070 \uBC29\uC6B8\uC758
      \uBC29\uD5A5\uC744 \uBA3C\uC800 \uD655\uC778\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_016
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC0C1\uCC98 \uC704\uCE58\uB97C \uAE30\uC900\uC73C\uB85C \uB9DE\uCD94\uBA74
      \uC870\uAC01 \uD558\uB098\uAC00 \uBC18\uB4DC\uC2DC \uC5B4\uAE0B\uB0A9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_017
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC6C5\uB369\uC774 \uC911\uC2EC\uC744 \uCC9C\uC7A5 \uD328\uB110 \uC218\uC9C1
      \uC544\uB798\uB85C \uC62E\uAE30\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-02_018
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uAC00\uC124 \uD574\uAE08: \uC2DC\uC2E0\uC774 \uCC9C\uC7A5\uC5D0\uC11C
      \uD22C\uC785\uB418\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
