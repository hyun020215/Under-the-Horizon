%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_03
  lines:
  - id: D2-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uBD80\uAC80\uC6A9 \uB0C9\uC7A5 \uC7A5\uCE58 \uC606 \uBAA8\uB2C8\uD130\uC5D0\uB294
      \uB2E4\uB2C8\uC5D8\uC758 \uCCB4\uC628 \uBCC0\uD654 \uACE1\uC120\uACFC \uD22C\uC57D
      \uAE30\uB85D\uC774 \uB098\uB780\uD788 \uB5A0 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uCC98\uC74C\uC5D0\uB294 22\uC2DC 10\uBD84 \uC804\uD6C4\uB85C \uBD24\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uC548\uC815\uC81C\uC640 \uCC28\uAC00\uC6B4 \uBB3C, \uC800\uC628
      \uACF5\uAE30\uAC00 \uBAA8\uB450 \uCCB4\uC628 \uD558\uAC15\uC744 \uC55E\uB2F9\uAE38
      \uC218 \uC788\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC548\uC815\uC81C\uB294 \uC5B8\uC81C \uCC98\uBC29\uD588\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_004
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uCD9C\uD56D \uC804\uB0A0 \uC6D0\uACA9 \uCC98\uBC29, \uC5B4\uC81C 18\uC2DC
      40\uBD84\uC5D0 \uC120\uB0B4 \uC57D\uAD6D\uC5D0\uC11C \uC218\uB839. \uC815\uB7C9\uC740
      \uD55C \uC54C\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_005
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uCC98\uBC29 \uAE30\uB85D]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC5D0\uAC8C \uCC98\uBC29\uB41C \uC800\uC6A9\uB7C9 \uC9C4\uC815\uC81C.
      \uD608\uC911 \uB18D\uB3C4\uB294 \uCC98\uBC29\uB7C9\uACFC \uC77C\uCE58\uD558\uC9C0\uB9CC
      \uBC18\uC751 \uC18D\uB3C4\uC640 \uD310\uB2E8\uB825\uC744 \uB2A6\uCDC4\uC744
      \uC218 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_007
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-11 \uC548\uC815\uC81C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uCCB4\uC628 \uAE30\uB85D]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC816\uC740 \uC758\uBCF5\uACFC \uD638\uB77C\uC774\uC98C \uB8F8\uC758
      \uAC15\uD55C \uB0C9\uBC29\uC744 \uBC18\uC601\uD558\uBA74 \uC0AC\uB9DD \uCD94\uC815
      \uBC94\uC704\uAC00 21:35~22:05\uB85C \uC55E\uB2F9\uACA8\uC9C4\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCCB4\uC628 \uC800\uD558
      \uBCF4\uC815"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC758 \uCCAB \uBC1C\uD45C\uAC00 \uC0B4\uC778 \uC2DC\uAC01\uC744
      \uD55C \uC2DC\uAC04 \uB2A6\uCDC4\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_012
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC758\uC0AC\uB97C \uC555\uBC15"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_013
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uD611\uC870 \uC694\uCCAD"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0AC\uB9DD \uC2DC\uAC01 \uC624\uCC28\uB294 \uC6A9\uC758\uC790\uC758
      \uC54C\uB9AC\uBC14\uC774\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC57D\uBB3C \uD6A8\uACFC\uB97C \uC65C \uCC98\uC74C\uBD80\uD130 \uACC4\uC0B0\uD558\uC9C0
      \uC54A\uC558\uC8E0?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_015
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC2DC\uC2E0 \uC704\uCE58\uC640 \uD658\uACBD \uC815\uBCF4\uAC00 \uD6FC\uC190\uB41C
      \uC0C1\uD0DC\uC5D0\uC11C \uAC00\uB2A5\uD55C \uBC94\uC704\uB97C \uB9D0\uD55C
      \uAC81\uB2C8\uB2E4. \uC758\uD559\uC740 \uB2F9\uC2E0\uC774 \uC6D0\uD558\uB294
      \uC21C\uAC04\uC5D0 \uD655\uC2E0\uC744 \uB9CC\uB4E4\uC5B4 \uC8FC\uC9C0 \uC54A\uC544\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCCAB \uCD94\uC815\uC774 \uD2C0\uB838\uB2E4\uB294 \uAC78 \uACF5\uACA9\uD558\uB824\uB294
      \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uC5B4\uB5A4 \uC870\uAC74\uC774 \uC2DC\uACC4\uB97C
      \uC18D\uC600\uB294\uC9C0 \uD568\uAED8 \uBD84\uB9AC\uD574 \uC8FC\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_017
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC88B\uC544\uC694. \uD608\uC561 \uAC00\uC2A4\uC640 \uD3D0 \uC18C\uACAC\uC744
      \uB2E4\uC2DC \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC790\uC0C1\uC774 \uC9C1\uC811
      \uC0AC\uC778\uC774 \uC544\uB2C8\uB77C\uB294 \uAC00\uB2A5\uC131\uB3C4 \uC5F4\uC5B4\uB458\uAC8C\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 22\uC2DC 35\uBD84\uC5D0 \uD638\uB77C\uC774\uC98C
      \uB8F8\uC5D0\uC11C \uAE30\uB2E4\uB9B0 \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uADF8
      \uBA54\uC2DC\uC9C0\uAC00 \uB3C4\uCC29\uD558\uAE30 \uC804\uC5D0 \uC774\uBBF8
      \uC8FD\uC5C8\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_019
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uADF8\uB7EC\uBA74 \uBA54\uC2DC\uC9C0\uB294 \uB9CC\uB0A8 \uC57D\uC18D\uC774
      \uC544\uB2C8\uB77C \uC2DC\uC2E0 \uBC1C\uACAC \uC2DC\uAC04\uC744 \uC870\uC808\uD55C
      \uC7A5\uCE58\uC600\uACA0\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-03_020
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC0AC\uB9DD \uCD94\uC815 \uBC94\uC704 \uC218\uC815: 21:35~22:05. \uD5EC\uB808\uB098\uC640\uC758
      \uAD00\uACC4\uC5D0 \uC601\uD5A5\uC744 \uC90D\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
