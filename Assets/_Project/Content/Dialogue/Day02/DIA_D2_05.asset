%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D2_05
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D2_05
  lines:
  - id: D2-05_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC0AC\uB2E4\uB9AC\uAC00 \uCC9C\uC7A5 \uD328\uB110\uC5D0 \uB2FF\uC790
      \uBBF8\uC138\uD55C \uAC80\uC740 \uAC00\uB8E8\uAC00 \uD587\uBE5B \uC18D\uC73C\uB85C
      \uB5A8\uC5B4\uC84C\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_002
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD328\uB110\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC5F0 \uC0AC\uB78C\uC774
      \uB204\uAD6C\uC778\uC9C0 \uAE30\uB85D\uC774 \uC788\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_003
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC815\uAE30 \uC810\uAC80\uC740 \uB450 \uB2EC \uC804\uC785\uB2C8\uB2E4.
      \uC5B4\uC82F\uBC24 \uC791\uC5C5 \uD5C8\uAC00\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_004
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC624\uC5B8\uC744 \uD638\uCD9C\uD55C\uB2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_005
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC9C1\uC811 \uD328\uB110\uC744 \uC5F0\uB2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_006
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uBCFC\uB8F8 \uC7A5\uC2DD \uD328\uB110\uACFC \uAC19\uC740 \uADDC\uACA9\uC785\uB2C8\uB2E4.
      \uC7A0\uAE08 \uD540\uC744 \uC5B5\uC9C0\uB85C \uD47C \uAC8C \uC544\uB2C8\uB77C
      \uC11C\uBE44\uC2A4 \uD0A4\uB85C \uC5F4\uC5C8\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC11C\uBE44\uC2A4 \uD0A4 \uBCF4\uC720\uC790\uB294\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_008
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uAE30\uAD00\uBD80\uC640 \uD589\uC0AC \uC6B4\uC601 \uCC45\uC784\uC790.
      \uD589\uC0AC \uCC45\uC784\uC790\uB294 \uC774\uBE14\uB9B0 \uC1FC\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_009
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD328\uB110\uC744 \uD63C\uC790 \uB4E4\uC5B4 \uC62C\uB9AC\uB294 \uC21C\uAC04
      \uB098\uC0AC \uD648\uC758 \uBBF8\uC138 \uAC00\uB8E8 \uC77C\uBD80\uAC00 \uBC14\uB2E5\uC73C\uB85C
      \uB5A8\uC5B4\uC84C\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_010
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uC74C\uC5D0\uB294 \uAD6C\uC870\uB97C \uC544\uB294 \uC0AC\uB78C\uC744
      \uBA3C\uC800 \uBD80\uB974\uB294 \uD3B8\uC774 \uC99D\uAC70\uC5D0\uB3C4 \uCE5C\uC808\uD558\uACA0\uAD70."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_011
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uD328\uB110 \uAC00\uC7A5\uC790\uB9AC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC624\uB798\uB41C \uD68C\uC0C9 \uBA3C\uC9C0 \uC704\uC5D0 \uC190\uAC00\uB77D
      \uB450 \uAC1C \uD3ED\uB9CC\uD07C \uAE68\uB057\uD55C \uC120\uC774 \uC788\uB2E4.
      \uC0AC\uAC74 \uC804\uD6C4\uC5D0 \uD55C \uBC88 \uC5F4\uB838\uB2E4 \uB2EB\uD614\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_013
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCD5C\uADFC \uAC1C\uBC29
      \uD754\uC801"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_014
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAC80\uC740 \uD569\uC131\uC12C\uC720]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD328\uB110 \uC548\uCABD \uB864\uB7EC\uC5D0 \uAC80\uC740 \uACE0\uAC15\uB3C4
      \uC12C\uC720\uAC00 \uAC78\uB824 \uC788\uB2E4. \uC6B4\uBC18\uC6A9 \uBCA8\uD2B8\uB098
      \uC7A5\uBE44 \uAC00\uBC29 \uC7AC\uC9C8\uACFC \uC720\uC0AC\uD558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_016
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uAC80\uC740 \uD569\uC131\uC12C\uC720"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_017
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uC704\uC5D0\uB294 \uD589\uC0AC \uC7A5\uBE44\uC6A9 \uACBD\uB7C9 \uB808\uC77C\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uC6D0\uB798 \uD638\uB77C\uC774\uC98C \uB8F8\uAE4C\uC9C0
      \uBED7\uC9C0 \uC54A\uB294\uB370\u2026 \uC774 \uBD84\uAE30\uD310\uC740 \uAC1C\uC870\uB410\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB34\uAC8C \uD55C\uB3C4\uB294\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_019
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uD45C\uC900 \uC6B4\uBC18\uBC31 \uAE30\uC900 120\uD0AC\uB85C. \uC0AC\uB78C
      \uD55C \uBA85\uC740 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uC9C1 \uC0AC\uB78C\uC744 \uC62E\uACBC\uB2E4\uACE0 \uB2E8\uC815\uD558\uC9C4
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uCC9C\uC7A5\uC740 \uC774\uC81C
      \uCD9C\uAD6C\uAC00 \uC544\uB2C8\uB77C \uC785\uAD6C \uD6C4\uBCF4\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D2-05_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uD654\uBB3C \uB808\uC77C \uC870\uC0AC \uC815\uBCF4: \uAC1C\uC870 \uD754\uC801
      / \uD569\uC131\uC12C\uC720 / \uCD5C\uADFC \uD328\uB110 \uAC1C\uBC29."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
