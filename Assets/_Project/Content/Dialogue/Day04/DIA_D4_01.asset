%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D4_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D4_01
  lines:
  - id: D4-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB9C8\uCEE4\uC2A4\uB294 \uBCF4\uC548\uC2E4\uC758 \uBAA8\uB4E0 \uD654\uBA74\uC744
      \uCF1C \uB193\uC558\uC9C0\uB9CC \uC5B4\uB290 \uAC83\uB3C4 \uBCF4\uACE0 \uC788\uC9C0
      \uC54A\uC558\uB2E4. \uCC45\uC0C1 \uD55C\uCABD\uC5D0\uB294 \uB3C5\uCD09 \uBA54\uC2DC\uC9C0\uAC00
      \uBC18\uBCF5\uD574\uC11C \uB5A0\uC62C\uB790\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_002
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAC1C\uC778 \uCC44\uBB34 \uC54C\uB9BC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC120\uC0C1 \uCE74\uC9C0\uB178 \uC678\uBD80 \uB300\uBD80\uC5C5\uCCB4\uC5D0
      14\uB9CC \uB2EC\uB7EC \uC0C1\uB2F9\uC758 \uCC44\uBB34. \uC0C1\uD658 \uAE30\uD55C\uC740
      \uC774\uBC88 \uD56D\uD574 \uB9C8\uC9C0\uB9C9 \uB0A0\uC774\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_004
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uB3C4\uBC15 \uCC44\uBB34"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_005
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC0AD\uC81C\uB41C \uBE44\uBC00 \uC5F0\uB77D]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uACFC\uC758 \uC554\uD638\uD654 \uBA54\uC2DC\uC9C0:
      \u2018\uC778\uC99D\uC744 10\uBD84\uB9CC \uBE4C\uB9AC\uBA74 \uCC44\uBB34 \uBB38\uC81C\uB97C
      \uC815\uB9AC\uD558\uACA0\uB2E4.\u2019 \uBC1C\uC2E0 \uC2DC\uAC01 1\uC77C \uCC28
      20:52."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_007
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC774\uBE14\uB9B0\uACFC\uC758
      \uBE44\uBC00 \uC5F0\uB77D"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21\uC2DC 05\uBD84 \uAE08\uACE0 \uC811\uADFC\uC5D0 \uB2F9\uC2E0 \uD1A0\uD070\uC774
      \uC4F0\uC600\uC2B5\uB2C8\uB2E4. 13\uBD84 \uC804 \uC774\uBE14\uB9B0\uC774 \uCC44\uBB34\uB97C
      \uC815\uB9AC\uD574 \uC8FC\uACA0\uB2E4\uACE0 \uD588\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_009
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uADF8 \uBA54\uC2DC\uC9C0\uB294 \uC5C5\uBB34 \uD611\uC870\uC600\uC2B5\uB2C8\uB2E4.
      \uADF8\uB140\uAC00 \uD68C\uC0AC \uBCF5\uC9C0\uD300\uACFC \uC5F0\uACB0\uD574
      \uC900\uB2E4\uACE0\u2014"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_010
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF5\uC9C0\uD300\uC740 \uC774\uC911 \uC778\uC99D\uC744 \uC694\uAD6C\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_011
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC800\uB294 \uAE08\uACE0\uC5D0 \uAC00\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uC601\uC0C1\uC5D0\uB3C4 \uBCF4\uC548\uC2E4\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB204\uAC00 \uB2F9\uC2E0 \uB300\uC2E0 \uAC14\uB294\uC9C0\uB294 \uBB3B\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uD1A0\uD070\uC744 \uB204\uAD6C\uC5D0\uAC8C
      \uC92C\uB294\uC9C0 \uBB3C\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D4-01_C1
      text: "\uBE5A \uACF5\uAC1C \uD611\uBC15"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 34b9666f20ac1fb43a06f2d5d9231cda, type: 2}
      nextLineId: D4-01_015
    - id: D4-01_C2
      text: "\uBCF4\uD638 \uC57D\uC18D"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 28df6e89cac5cf141adc409d3c3cf59a, type: 2}
      nextLineId: D4-01_017
  - id: D4-01_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCC44\uBB34\uC640 \uB300\uAC00\uC131 \uC778\uC99D \uC81C\uACF5\uC744
      \uC120\uC7A5\uC5D0\uAC8C \uACF5\uAC1C\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08
      \uB9D0\uD558\uBA74 \uC2E4\uC218, \uB098\uC911\uC5D0 \uB4DC\uB7EC\uB098\uBA74
      \uACF5\uBC94\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 9fc3607c0d164fb44837d95da1d3a3ce, type: 2}
    effects: []
    choices: []
  - id: D4-01_016
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC7A0\uAE50\uB9CC\uC694. \uC624\uB298 \uC815\uC624\uC5D0 \uC804\uBD80
      \uB9D0\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C\uB4E4\uC774 \uC5C6\uB294
      \uACF3\uC5D0\uC11C\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 9fc3607c0d164fb44837d95da1d3a3ce, type: 2}
    effects: []
    choices: []
  - id: D4-01_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC774 \uC778\uC99D\uC744 \uBE4C\uB824\uC900 \uC0AC\uC2E4\uACFC
      \uB2E4\uB2C8\uC5D8\uC758 \uC0B4\uC778\uC740 \uC544\uC9C1 \uAC19\uC740 \uC8C4\uAC00
      \uC544\uB2D9\uB2C8\uB2E4. \uBA3C\uC800 \uC0AC\uC2E4\uC744 \uB9D0\uD558\uBA74
      \uC120\uC7A5\uC5D0\uAC8C \uD611\uC870\uC790\uB85C \uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 3320d7881fe4c0f438399883f3d9dd38, type: 2}
    effects: []
    choices: []
  - id: D4-01_018
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC774\uBE14\uB9B0\uC774 \uBE44\uC0C1 \uC810\uAC80\uC774\uB77C\uACE0 \uD588\uC2B5\uB2C8\uB2E4.
      \uD1A0\uD070\uB9CC \uB118\uACBC\uC5B4\uC694. \uC624\uB298 \uC815\uC624\uC5D0
      \uD1A0\uBA38\uC2A4 \uC120\uC7A5 \uC55E\uC5D0\uC11C \uC9C4\uC220\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 3320d7881fe4c0f438399883f3d9dd38, type: 2}
    effects: []
    choices: []
  - id: D4-01_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC65C \uC9C0\uAE08\uC774 \uC544\uB2C8\uB77C \uC815\uC624\uC8E0?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_020
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uBC31\uC5C5 \uB85C\uADF8\uB97C \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4.
      \uB9D0\uB9CC\uC73C\uB85C\uB294 \uC774\uBE14\uB9B0\uC774 \uC800\uB97C \uAC70\uC9D3\uB9D0\uC7C1\uC774\uB85C
      \uB9CC\uB4E4 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_021
    speaker:
      character: {fileID: 0}
      overrideName: EVELYN_MESSAGE
    text: "\uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC740 \uC774\uBBF8 \uBE44\uC6A9\uC744 \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_022
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC774 \uBA54\uC2DC\uC9C0\u2026 \uBC29\uAE08 \uC654\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD63C\uC790 \uC6C0\uC9C1\uC774\uC9C0 \uB9C8\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-01_024
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uACE0\uBC31 \uC57D\uC18D: 4\uC77C \uCC28 12:00. \uB9C8\uCEE4\uC2A4\uC758
      \uC2E0\uBCC0 \uC704\uD5D8\uC774 \uCEE4\uC9D1\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
