%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D4_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D4_02
  lines:
  - id: D4-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "11\uC2DC 45\uBD84, \uC2B9\uBB34\uC6D0 \uACC4\uB2E8 \uBE44\uC5D0\uC11C
      \uAE08\uC18D \uCDA9\uB3CC\uC74C\uC774 \uC138 \uBC88 \uC6B8\uB838\uB2E4. \uB9C8\uCEE4\uC2A4\uB294
      \uC911\uAC04 \uCC38\uC5D0 \uC4F0\uB7EC\uC838 \uC788\uC5C8\uACE0, \uC544\uB798
      \uACC4\uB2E8\uC740 \uBB3C\uC5D0 \uC816\uC5B4 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC758\uC2DD \uC5C6\uC2B5\uB2C8\uB2E4. \uBA38\uB9AC\uC640 \uD749\uBD80
      \uCDA9\uACA9\uC774 \uC788\uC5B4\uC694. \uC6C0\uC9C1\uC774\uC9C0 \uB9C8\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_003
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC81C\uAC00 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4. \uC704\uCE35\uC5D0\uC11C
      \uC2E0\uC74C \uC18C\uB9AC\uAC00 \uB4E4\uB838\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_004
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0 \uC7A5\uAC11\uC5D0 \uBB3C\uC774 \uBB3B\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_005
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB9E5\uBC15\uC744 \uD655\uC778\uD558\uB824\uACE0 \uB09C\uAC04\uC744 \uC7A1\uC558\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE08 \uC758\uC2EC\uBCF4\uB2E4 \uC751\uAE09\uCC98\uCE58\uAC00 \uBA3C\uC800
      \uC544\uB2CC\uAC00\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_006
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC816\uC740 \uACC4\uB2E8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC138\uCC99\uC218 \uB0C4\uC0C8\uAC00 \uB098\uC9C0\uB9CC \uCCAD\uC18C
      \uD45C\uC9C0\uD310\uC740 \uC811\uD78C \uCC44 \uBCBD \uC548\uCABD\uC5D0 \uC788\uB2E4.
      \uBB3C\uC740 \uC704\uC5D0\uC11C \uC544\uB798\uB85C \uC790\uC5F0\uC2A4\uB7FD\uAC8C
      \uD758\uB800\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_008
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC816\uC740 \uACC4\uB2E8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_009
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB09C\uAC04\uC758 \uC7A5\uAC11 \uC12C\uC720]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_010
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC80\uC740 \uC7A5\uAC11 \uC12C\uC720\uAC00 \uB09C\uAC04\uC5D0 \uAC78\uB838\uB2E4.
      \uC774\uBE14\uB9B0\uC758 \uD589\uC0AC \uC7A5\uAC11\uACFC \uC0C9\uC0C1\uC740
      \uAC19\uC9C0\uB9CC \uC12C\uC720 \uD615\uD0DC\uB294 \uC2B9\uBB34\uC6D0 \uACF5\uC6A9
      \uC7A5\uAC11\uACFC\uB3C4 \uB3D9\uC77C\uD558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_011
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC7A5\uAC11 \uC12C\uC720"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_012
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB9C8\uCEE4\uC2A4\uC758 \uBC1C\uC790\uAD6D]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC1C\uC790\uAD6D \uAC04\uACA9\uC774 \uB9C8\uC9C0\uB9C9 \uC138 \uCE78\uC5D0\uC11C
      \uAE09\uACA9\uD788 \uAE38\uC5B4\uC9C0\uACE0, \uD55C \uBC1C\uC774 \uBB3C \uC6C5\uB369\uC774
      \uC911\uC559\uC744 \uBC1F\uC558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_014
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCD94\uB77D \uC804
      \uBC1C\uC790\uAD6D"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_015
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uB204\uAC00 \uBC00\uC5C8\uB2E4\uBA74 \uB4F1\uC774\uB098 \uC5B4\uAE68\uC5D0
      \uC811\uCD09 \uD754\uC801\uC774 \uC788\uC744 \uC218 \uC788\uC5B4\uC694. \uC9C0\uAE08\uC740
      \uBCD1\uC2E4\uB85C \uC62E\uACA8\uC57C \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_016
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC774\uBE14\uB9B0\uC744 \uC989\uC2DC \uAD6C\uAE08"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_017
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uD604\uC7A5\uC744 \uBA3C\uC800 \uBCF4\uC874"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0 \uC1FC, \uC870\uC0AC \uC885\uB8CC\uAE4C\uC9C0 \uBCF4\uC548\uC2E4\uC5D0
      \uBA38\uBB34\uB974\uC2ED\uC2DC\uC624. \uB9C8\uCEE4\uC2A4\uC640 \uB2E8\uB458\uC774
      \uC811\uCD09\uD558\uC9C0 \uB9C8\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_019
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC12C\uC720 \uD558\uB098\uC640 \uC816\uC740 \uACC4\uB2E8\uC73C\uB85C
      \uC0AC\uB78C\uC744 \uAD6C\uAE08\uD558\uB294\uAD70\uC694. \uC0AC\uC2E4\uBCF4\uB2E4
      \uC774\uC57C\uAE30\uAC00 \uB354 \uBE68\uB9AC \uC644\uC131\uB410\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uBB34\uB3C4 \uACC4\uB2E8\uC5D0 \uB4E4\uC5B4\uC624\uC9C0 \uB9C8\uC138\uC694.
      \uC774\uBE14\uB9B0, \uB2F9\uC2E0 \uB3D9\uC120\uC740 \uD655\uC778\uD558\uACA0\uC9C0\uB9CC
      \uC9C0\uAE08\uC740 \uC99D\uAC70\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_021
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uD604\uBA85\uD558\uAD70\uC694. \uC758\uC2EC\uC740 \uC790\uC720\uC9C0\uB9CC
      \uC808\uCC28\uB294 \uBE44\uC6A9\uC774 \uB4ED\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9C8\uCEE4\uC2A4\uB294 \uACE0\uBC31 \uC9C1\uC804\uC5D0 \uC4F0\uB7EC\uC84C\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uD0C0\uC774\uBC0D\uC740 \uBC94\uD589 \uC218\uBC95\uC774
      \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D4-02_023
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC131\uAE09\uD55C \uD310\uB2E8\uC758 \uC704\uD5D8\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4.
      \uACC4\uB2E8 \uC7AC\uAD6C\uC131 \uD37C\uC990\uC774 \uC5F4\uB838\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
