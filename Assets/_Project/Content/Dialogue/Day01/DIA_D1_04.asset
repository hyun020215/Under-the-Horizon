%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D1_04
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D1_04
  lines:
  - id: D1-04_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC74C\uC545\uC740 \uC11C\uBE44\uC2A4 \uB3C4\uC5B4\uAC00 \uB2EB\uD788\uC790
      \uC989\uC2DC \uBCBD \uB4A4\uB85C \uBC00\uB824\uB0AC\uB2E4. \uC881\uC740 \uBCF5\uB3C4\uC5D0\uB294
      \uC138\uD0C1 \uCE74\uD2B8\uC640 \uD589\uC0AC \uC7A5\uBE44 \uD45C\uC2DD\uB9CC
      \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_002
    speaker:
      character: {fileID: 0}
      overrideName: CREW_ATTENDANT
    text: "\uC190\uB2D8, \uC774 \uAD6C\uC5ED\uC740 \uC2B9\uBB34\uC6D0 \uC804\uC6A9\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCCAD\uB85D\uC0C9 \uC637\uAE43\uC758 \uAE30\uC790\uAC00 \uC9C0\uB098\uAC14\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_004
    speaker:
      character: {fileID: 0}
      overrideName: CREW_ATTENDANT
    text: "\uB124. \uD734\uB300\uD3F0\uC744 \uBCF4\uBA74\uC11C \uC544\uB798\uCE35
      \uACC4\uB2E8\uC73C\uB85C \uAC14\uC5B4\uC694. \uB204\uAC00 \uAE30\uB2E4\uB9B0\uB2E4\uACE0
      \uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD63C\uC790\uC600\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_006
    speaker:
      character: {fileID: 0}
      overrideName: CREW_ATTENDANT
    text: "\uC81C\uAC00 \uBCF8 \uAC74 \uD63C\uC790\uC600\uC2B5\uB2C8\uB2E4. \uBB38\uC740
      \uB2E4\uC2DC \uB2EB\uD614\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC11C\uBE44\uC2A4 \uB3C4\uC5B4 \uB85C\uADF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21:22:14 \uC2B9\uAC1D \uD0DC\uADF8 \uC784\uC2DC \uC2B9\uC778. \uC2B9\uC778
      \uCD9C\uCC98\uB294 \u2018\uD589\uC0AC \uC6B4\uC601 \uACC4\uC815\u2019. \uB2E4\uB2C8\uC5D8\uC758
      \uD0DC\uADF8\uAC00 7\uCE35 \uBC29\uD5A5\uC73C\uB85C \uD1B5\uACFC\uD588\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC11C\uBE44\uC2A4
      \uCD9C\uC785\uBB38 \uAC1C\uD3D0 \uB85C\uADF8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_010
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uACC4\uB2E8 \uD45C\uC9C0\uD310]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uB798\uCE35\uC5D0\uB294 \uBC38\uB7EC\uC2A4\uD2B8 \uC81C\uC5B4 \uBCC4\uC2E4\uACFC
      \uAE30\uAD00 \uAD6C\uC5ED\uC774 \uC788\uB2E4. \uC704\uCABD \uD654\uC0B4\uD45C\uB294
      \uD589\uC0AC \uB808\uC77C \uC810\uAC80 \uD1B5\uB85C\uB97C \uAC00\uB9AC\uD0A8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_012
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uBC38\uB7EC\uC2A4\uD2B8
      \uBC29\uD5A5 \uD45C\uC9C0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC784\uC2DC \uC2B9\uC778\uC740 \uB204\uAC00 \uBC1C\uAE09\uD560 \uC218
      \uC788\uC8E0?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_014
    speaker:
      character: {fileID: 0}
      overrideName: CREW_ATTENDANT
    text: "\uD589\uC0AC \uC6B4\uC601 \uCC45\uC784\uC790\uB098 \uBCF4\uC548 \uCC45\uC784\uC790\uC694.
      \uC624\uB298 \uCC45\uC784\uC790\uB294 \uC1FC \uC774\uC0AC\uB2D8\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D1-04_C1
      text: "\uACBD\uBE44\uC5D0\uAC8C \uC54C\uB9AC\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: ee6b2a95088b5a7409b8a59d4ecd7f8c, type: 2}
      nextLineId: D1-04_017
    - id: D1-04_C2
      text: "\uBAB0\uB798 \uCD94\uC801"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 89f5f7f02fc137346853aba429d4ffd6, type: 2}
      nextLineId: D1-04_019
  - id: D1-04_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF4\uC548\uC2E4\uC5D0 \uC5F0\uB77D\uD558\uC138\uC694. \uB2E4\uB2C8\uC5D8
      \uBA38\uC11C\uAC00 \uC2B9\uC778\uB418\uC9C0 \uC54A\uC740 \uC11C\uBE44\uC2A4
      \uAD6C\uC5ED\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4\uACE0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 7973bf0902ec79f4c8473be8c63b4248, type: 2}
    effects: []
    choices: []
  - id: D1-04_018
    speaker:
      character: {fileID: 0}
      overrideName: CREW_ATTENDANT
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uBCA8 \uC528\uAC00 \uBC14\uB85C \uD655\uC778\uD560
      \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 7973bf0902ec79f4c8473be8c63b4248, type: 2}
    effects: []
    choices: []
  - id: D1-04_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uC9C1 \uC54C\uB9AC\uC9C0 \uB9C8\uC138\uC694. \uB204\uAC00 \uADF8\uB97C
      \uAE30\uB2E4\uB9AC\uB294\uC9C0 \uBA3C\uC800 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ed1ff7c7553635041b1f6f137c2160d6, type: 2}
    effects: []
    choices: []
  - id: D1-04_020
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC544\uB798\uCE35\uC5D0\uC11C \uAE08\uC18D\uBB38\uC774 \uB2EB\uD788\uB294
      \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uB4A4\uC774\uC5B4 \uC9E7\uC740 \uACF5\uAE30
      \uBC30\uCD9C\uC74C\uC774 \uB4E4\uB838\uC9C0\uB9CC, \uD30C\uD2F0 \uC74C\uC545\uC774
      \uB2E4\uC2DC \uCEE4\uC9C0\uBA70 \uC0BC\uCF30\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: ed1ff7c7553635041b1f6f137c2160d6, type: 2}
    effects: []
    choices: []
  - id: D1-04_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC1C\uC18C\uB9AC\uB294 \uD558\uB098\uBFD0\uC774\uC5C8\uB2E4. \uB3CC\uC544\uC624\uB294
      \uC18C\uB9AC\uB294 \uC5C6\uB2E4. \uC9C0\uAE08 \uB354 \uB0B4\uB824\uAC00\uBA74
      \uC2B9\uBB34\uC6D0\uB4E4\uC758 \uACBD\uACC4\uB9CC \uB192\uC77C \uBFD0\uC774\uB2E4.
      \uBCFC\uB8F8\uC73C\uB85C \uB3CC\uC544\uAC00 \uD589\uC0AC \uC6B4\uC601 \uACC4\uC815\uACFC
      \uB2E4\uB2C8\uC5D8\uC744 \uBD88\uB7EC\uB0B8 \uC0AC\uB78C\uBD80\uD130 \uD655\uC778\uD558\uC790."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-04_022
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uB9C8\uC9C0\uB9C9 \uD655\uC778 \uB3D9\uC120:
      21:22 7\uCE35 \uC11C\uBE44\uC2A4 \uAD6C\uC5ED \u2192 7\uCE35 \uC544\uB798 \uBC29\uD5A5.
      \uBCFC\uB8F8\uC758 \uD589\uC0AC \uC6B4\uC601 \uAD00\uACC4\uC790 \uD655\uC778\uC774
      \uB2E4\uC74C \uC870\uC0AC \uBAA9\uD45C\uB85C \uB4F1\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
