%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D1_06
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D1_06
  lines:
  - id: D1-06_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD638\uB77C\uC774\uC98C \uB8F8\uC758 \uBB38\uC740 \uBC18\uCBE4 \uC5F4\uB824
      \uC788\uC5C8\uB2E4. \uC548\uCABD\uC5D0\uC11C\uB294 \uB118\uCE5C \uBB3C\uC774
      \uCE74\uD3AB \uB05D\uAE4C\uC9C0 \uBC88\uC84C\uACE0, \uCC9C\uC7A5 \uC870\uBA85
      \uD558\uB098\uAC00 \uAC04\uD5D0\uC801\uC73C\uB85C \uAE5C\uBE61\uC600\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_002
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uB180\uB77C\uC9C0 \uB9C8\uC2DC\uC624. \uADF8\uB9AC\uACE0 \uD070 \uC18C\uB9AC\uB97C
      \uB0B4\uC9C0 \uB9C8\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uC740 \uC5F4\uB824 \uC788\uAD70\uC694. \uC2B9\uBB34\uC6D0, \uC758\uBB34\uC2E4\uC5D0
      \uC5F0\uB77D\uD558\uC138\uC694. \uD5EC\uB808\uB098\uB97C \uC9C0\uAE08 \uB2F9\uC7A5
      \uC774 \uBC29\uC73C\uB85C \uBD88\uB7EC \uC8FC\uC2ED\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_004
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uBE44\uCF1C \uC8FC\uC138\uC694. \uB9E5\uBC15 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uCCB4\uC628\uC774 \uB108\uBB34 \uB0AE\uC544\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD53C\uB97C \uBC1F\uC740 \uD754\uC801\uC774 \uD53C\uD574\uC790 \uAC83\uBC16\uC5D0
      \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_006
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB807\uB2E4\uBA74 \uBC94\uC778\uC740 \uC5B4\uB514\uB85C \uAC14\uB2E4\uB294
      \uAC70\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uC9C8\uBB38\uBD80\uD130 \uC758\uC2EC\uD574\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC5F4\uB9B0 \uCD9C\uC785\uBB38]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC7A0\uAE08\uC740 \uD574\uC81C\uB418\uC5B4 \uC788\uACE0 \uAC15\uC81C
      \uAC1C\uBC29 \uD754\uC801\uB3C4 \uC5C6\uB2E4. \uBB38\uD131\uC758 \uC816\uC740
      \uCE74\uD3AB\uC5D0\uB294 \uB4E4\uC5B4\uC628 \uC2E0\uBC1C \uC790\uAD6D\uC774
      \uD558\uB098\uBFD0\uC774\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-02 \uC5F4\uB9B0 \uCD9C\uC785\uBB38"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_011
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uD608\uD754\uACFC \uC2DC\uC2E0 \uC704\uCE58]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0C1\uCC98\uB294 \uC606\uAD6C\uB9AC\uC5D0 \uC788\uC9C0\uB9CC \uD53C
      \uC6C5\uB369\uC774\uC758 \uC911\uC2EC\uC740 \uC5B4\uAE68 \uC704\uCABD\uC73C\uB85C
      \uCE58\uC6B0\uCCD0 \uC788\uB2E4. \uC8FC\uBCC0 \uBCBD\uC5D0\uB294 \uBE44\uC0B0\uD608\uD754\uC774
      \uC5C6\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_013
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-07 \uD608\uD754 \uC911\uC2EC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_014
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB118\uCE5C \uC138\uBA74\uB300]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC218\uB3C4\uB294 \uC57D\uD558\uAC8C \uC5F4\uB824 \uC788\uACE0 \uBC30\uC218\uAD6C\uB294
      \uCC9C \uC870\uAC01\uC73C\uB85C \uB9C9\uD600 \uC788\uB2E4. \uBB3C\uC740 \uBC94\uD589
      \uC740\uD3D0\uCE58\uACE0\uB294 \uC9C0\uB098\uCE58\uAC8C \uB290\uB9AC\uAC8C
      \uD37C\uC84C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_016
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uB118\uCE5C \uBB3C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_017
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uD734\uB300 \uB179\uC74C\uAE30]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9C8\uC9C0\uB9C9 \uD30C\uC77C\uC5D0\uB294 \uAC70\uCE5C \uC228\uC18C\uB9AC
      \uB4A4\uB85C \u2018\uB9AC\u2026\u2019\uC5D0 \uAC00\uAE4C\uC6B4 \uC74C\uC808\uC774
      \uB0A8\uC544 \uC788\uB2E4. \uD30C\uC77C \uC0DD\uC131 \uC2DC\uAC01\uC740 21:47,
      \uBC29 \uBC1C\uACAC\uBCF4\uB2E4 \uAC70\uC758 \uD55C \uC2DC\uAC04 \uBE60\uB974\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_019
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC798\uBABB\uB41C
      \uB2E4\uC789 \uBA54\uC2DC\uC9C0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_020
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uCC9C\uC7A5 \uC7A5\uC2DD \uD328\uB110]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD55C\uCABD \uBAA8\uC11C\uB9AC\uC758 \uBA3C\uC9C0\uAC00 \uC587\uACE0,
      \uB098\uC0AC \uD648\uC774 \uC0C8\uB85C \uAE01\uD600 \uC788\uB2E4. \uC9C0\uAE08\uC740
      \uB108\uBB34 \uB192\uC544 \uC790\uC138\uD788 \uBCFC \uC218 \uC5C6\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_022
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCC9C\uC7A5 \uC774\uC0C1"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D1-06_C1
      text: "\uC989\uC2DC \uBD09\uC1C4"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 5ba7ba2a1f1d8e845a0b48aa8dde2469, type: 2}
      nextLineId: D1-06_025
    - id: D1-06_C2
      text: "\uBA3C\uC800 \uC2DC\uC2E0 \uD655\uC778"
      conditions: []
      effects:
      - {fileID: 11400000, guid: e0824c69b37b15a40914c4ae5395906a, type: 2}
      nextLineId: D1-06_027
  - id: D1-06_025
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uBB34\uB3C4 \uB4E4\uC5B4\uC624\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.
      \uB9C8\uCEE4\uC2A4\uC5D0\uAC8C \uBCF5\uB3C4 \uBD09\uC1C4\uC640 \uCD9C\uC785
      \uAE30\uB85D \uBCF4\uC874\uC744 \uC694\uCCAD\uD558\uC138\uC694. \uD5EC\uB808\uB098,
      \uD604\uC7AC \uC704\uCE58\uC5D0\uC11C\uB9CC \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: d6a91cd8315b8c44b9fab2a53dda4db9, type: 2}
    effects: []
    choices: []
  - id: D1-06_026
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC0AC\uC9C4\uBD80\uD130 \uB0A8\uAE30\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: d6a91cd8315b8c44b9fab2a53dda4db9, type: 2}
    effects: []
    choices: []
  - id: D1-06_027
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD5EC\uB808\uB098, \uBAB8\uC744 \uB3CC\uB824 \uC9C1\uC811 \uC0AC\uC778\uC744
      \uD655\uC778\uD574 \uC8FC\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: dc24c4dbfe01c4d46b3787193e31e389, type: 2}
    effects: []
    choices: []
  - id: D1-06_028
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC2DC\uC2E0\uC744 \uC62E\uAE30\uB294 \uB3D9\uC548 \uD53C \uC6C5\uB369\uC774
      \uAC00\uC7A5\uC790\uB9AC\uAC00 \uBB34\uB108\uC84C\uACE0, \uB9AC\uCC98\uB4DC\uC758
      \uAD6C\uB450\uAC00 \uC816\uC740 \uCE74\uD3AB\uC5D0 \uD55C \uBC88 \uB2FF\uC558\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: dc24c4dbfe01c4d46b3787193e31e389, type: 2}
    effects: []
    choices: []
  - id: D1-06_029
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uAC89\uC73C\uB85C\uB294 \uC790\uC0C1\uC774 \uBCF4\uC774\uC9C0\uB9CC,
      \uCD9C\uD608\uB7C9\uC774 \uCE58\uBA85\uC0C1\uCE58\uACE0 \uC801\uC2B5\uB2C8\uB2E4.
      \uC0AC\uB9DD \uC2DC\uAC01\uB3C4 \uC9C0\uAE08 \uCCB4\uC628\uB9CC\uC73C\uB85C\uB294
      \uC7A5\uB2F4 \uBABB \uD574\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_030
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uBA38\uC11C\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB9D0\uD55C \uAC8C
      \uB0B4 \uC774\uB984\uC774\uB77C\uBA74\u2014"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_031
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\u2018\uB9AC\u2026\u2019\uC740 \uC774\uB984\uC774 \uC544\uB2C8\uB77C \uC18C\uB9AC\uC77C
      \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uACB0\uB860\uBD80\uD130 \uACE0\uB974\uBA74
      \uBC29\uC774 \uC6B0\uB9AC\uC5D0\uAC8C \uB9DE\uCDB0\uC9C8 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-06_032
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9AC\uCC98\uB4DC, \uD558\uB098\uB9CC \uB354 \uBB3B\uACA0\uC2B5\uB2C8\uB2E4.
      \uAE30\uC5B5\uC774 \uD750\uB824\uC9C0\uAE30 \uC804\uC5D0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D1-06_C3
      text: "\uADF8 \uC18C\uB9AC\uAC00 \uC815\uB9D0 \uD655\uC2E4\uD569\uB2C8\uAE4C"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 0db9ee0d196f362459635ff2bf053563, type: 2}
      nextLineId: D1-06_035
    - id: D1-06_C4
      text: "\uC9C0\uAE08\uC740 \uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC8E0"
      conditions: []
      effects:
      - {fileID: 11400000, guid: e74b955c9a5c05e4997f250585f2c142, type: 2}
      nextLineId:
  - id: D1-06_035
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD655\uC2E4\u2026 \uD558\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC18C. \uD558\uC9C0\uB9CC
      \uC9C0\uAE08 \uB2E4\uC2DC \uB4E4\uC73C\uB77C\uBA74, \uADF8\uAC74 \uC0AC\uB78C
      \uBAA9\uC18C\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uC744 \uC218\uB3C4 \uC788\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: aad631fa0e46c4e4fb4d255d45767aa4, type: 2}
    effects: []
    choices: []
  - id: D1-06_036
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uD604\uC7A5 \uBCF4\uC874 \uC0C1\uD0DC\uAC00 \uBC18\uC601\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD575\uC2EC \uC870\uC0AC \uB300\uC0C1 5\uAC1C\uAC00 \uBAA9\uB85D\uC5D0 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
