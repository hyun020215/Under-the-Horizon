%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D1_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D1_02
  lines:
  - id: D1-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB9CC\uCC2C\uC758 \uB124 \uBC88\uC9F8 \uCF54\uC2A4\uAC00 \uB193\uC774\uAE30\uB3C4
      \uC804\uC5D0 \uB2E4\uB2C8\uC5D8\uC740 \uD0DC\uBE14\uB9BF\uC744 \uC2DD\uD0C1
      \uC704\uC5D0 \uC138\uC6E0\uB2E4. \uD654\uBA74\uC5D0\uB294 \uD638\uC190 \uD574\uC6B4\uC758
      \uACC4\uC5F4\uC0AC \uC1A1\uAE08 \uD45C\uAC00 \uB5A0 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_002
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC720\uB839 \uD68C\uC0AC \uC14B, \uAC19\uC740 \uB0A0 \uBD84\uC0B0 \uC1A1\uAE08,
      \uCD5C\uC885 \uC218\uCDE8\uC778\uC740 \uD638\uC190 \uAC00\uC871 \uC2E0\uD0C1.
      \uC6B0\uC5F0\uCE58\uACE0\uB294 \uD68C\uACC4\uC0AC\uAC00 \uB108\uBB34 \uBD80\uC9C0\uB7F0\uD558\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_003
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8 \uC790\uB8CC\uB294 \uAC10\uC0AC \uC804 \uCD08\uC548\uC785\uB2C8\uB2E4.
      \uCD9C\uCC98\uB97C \uACF5\uAC1C\uD558\uC9C0 \uC54A\uC73C\uBA74 \uBA85\uC608\uD6FC\uC190\uC73C\uB85C
      \uB05D\uB0A0 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_004
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uCD9C\uCC98\uB294 \uB2F9\uC2E0 \uD68C\uC0AC \uC548\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.
      \uC774\uB984\uC740 \uBC1D\uD788\uC9C0 \uC54A\uACA0\uC9C0\uB9CC, \uB9E4\uC77C
      \uB2F9\uC2E0 \uACC1\uC5D0\uC11C \uC11C\uB958\uB97C \uC815\uB9AC\uD558\uB294
      \uC0AC\uB78C\uC77C \uC218\uB3C4 \uC788\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_005
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB2E4\uB2C8\uC5D8, \uB2E4\uB978 \uC2B9\uAC1D\uB4E4\uC774 \uC2DD\uC0AC
      \uC911\uC785\uB2C8\uB2E4. \uC5C5\uBB34 \uC774\uC57C\uAE30\uB294 \uC801\uC808\uD55C
      \uC7A5\uC18C\uC5D0\uC11C \uD558\uC2DC\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_006
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC801\uC808\uD55C \uC7A5\uC18C\uB294 \uB298 \uAD8C\uB825\uC774 \uC815\uD569\uB2C8\uB2E4.
      \uADF8\uB798\uC11C \uC800\uB294 \uBD80\uC801\uC808\uD55C \uC7A5\uC18C\uB97C
      \uC88B\uC544\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_007
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2F9\uC2E0\uC740 \uC624\uB974\uD398\uC6B0\uC2A4 \uD638\uB97C \uD551\uACC4\uB85C
      \uC6B0\uB9AC \uD68C\uC0AC \uC804\uCCB4\uB97C \uBC94\uC8C4 \uC870\uC9C1\uCC98\uB7FC
      \uC4F0\uACE0 \uC788\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_008
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uBC94\uC8C4 \uC870\uC9C1\uC740 \uBCF4\uD1B5 \uAE30\uB85D\uC744 \uB354
      \uC798 \uAD00\uB9AC\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D1-02_C1
      text: "\uB07C\uC5B4\uB4E4\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: b1755899dfec06749a237c605cf4f931, type: 2}
      nextLineId: D1-02_011
    - id: D1-02_C2
      text: "\uAD00\uCC30\uD558\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: d74f3ac05147ef04bbb13600c018dd21, type: 2}
      nextLineId: D1-02_014
  - id: D1-02_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAE30\uC0AC \uCD08\uC548\uACFC \uC2DD\uC0AC\uB97C \uAC19\uC740 \uD14C\uC774\uBE14\uC5D0
      \uC62C\uB9AC\uBA74 \uB458 \uB2E4 \uB9DD\uCE69\uB2C8\uB2E4. \uB2E4\uB2C8\uC5D8,
      \uCD9C\uCC98\uAC00 \uC2E4\uC81C\uB85C \uC874\uC7AC\uD55C\uB2E4\uB294 \uC99D\uAC70\uBD80\uD130
      \uBCF4\uC5EC\uC8FC\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 95ebdc7a73a50d944b2d0cbb84b34cdd, type: 2}
    effects: []
    choices: []
  - id: D1-02_012
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC554\uD638\uD654 \uCC44\uD305\uACFC \uB0B4\uBD80 \uBB38\uC11C\uC758
      \uB300\uC870\uBCF8\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC6D0\uBCF8\uC740
      \uC544\uC9C1 \uBABB \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 95ebdc7a73a50d944b2d0cbb84b34cdd, type: 2}
    effects: []
    choices: []
  - id: D1-02_013
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uD0D0\uC815\uAE4C\uC9C0 \uADF8 \uC0AC\uB78C \uD3B8\uC774\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 95ebdc7a73a50d944b2d0cbb84b34cdd, type: 2}
    effects: []
    choices: []
  - id: D1-02_014
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD074\uB808\uC5B4\uB294 \uC640\uC778\uC794\uC744 \uB4E4\uC5C8\uC9C0\uB9CC
      \uB9C8\uC2DC\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB2C8\uC5D8\uC774 \u2018\uB0B4\uBD80
      \uBB38\uC11C\u2019\uB77C\uACE0 \uB9D0\uD55C \uC21C\uAC04, \uADF8\uB140\uC758
      \uC2DC\uC120\uC740 \uADF8\uC758 \uD0DC\uBE14\uB9BF \uAC00\uBC29\uC73C\uB85C
      \uB0B4\uB824\uAC14\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 7056b3feaef5e4246a1aa72fb3df63c8, type: 2}
    effects: []
    choices: []
  - id: D1-02_015
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC774\uBE14\uB9B0\uC740 \uC5B8\uC7C1\uC774 \uACA9\uD574\uC9C8\uC218\uB85D
      \uC624\uD788\uB824 \uC870\uC6A9\uD574\uC84C\uB2E4. \uB2E8 \uD55C \uBC88, \uB2E4\uB2C8\uC5D8\uC774
      \u2018\uC775\uBA85 \uC81C\uBCF4\uC790\u2019\uB77C\uACE0 \uB9D0\uD588\uC744
      \uB54C\uB9CC \uC190\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 7056b3feaef5e4246a1aa72fb3df63c8, type: 2}
    effects: []
    choices: []
  - id: D1-02_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9D0\uBCF4\uB2E4 \uC2DC\uC120\uC774 \uB9CE\uAD70."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 7056b3feaef5e4246a1aa72fb3df63c8, type: 2}
    effects: []
    choices: []
  - id: D1-02_017
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAE30\uC0AC \uCD08\uC548 \uD654\uBA74]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC81C\uBAA9\uC740 \u2018\uC624\uB974\uD398\uC6B0\uC2A4 \uD638\uB294 \uC0AC\uACE0\uAC00
      \uC544\uB2C8\uC5C8\uB2E4\u2019. \uB9AC\uCC98\uB4DC\uC758 \uC774\uB984\uC774
      \uAD75\uAC8C \uD45C\uC2DC\uB418\uC5B4 \uC788\uACE0, \uADFC\uAC70 \uD56D\uBAA9
      \uC77C\uBD80\uB294 \u2018\uC775\uBA85 \uC81C\uBCF4 \uB300\uAE30\u2019\uB85C
      \uBE44\uC5B4 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_019
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uBE44\uC790\uAE08
      \uAE30\uC0AC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_020
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC624\uB298 \uBC24 \uC6D0\uBCF8\uC744 \uBC1B\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uBA74
      \uBE48\uCE78\uB3C4 \uCC44\uC6CC\uC9C0\uACA0\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC7A5\uC18C\uB294\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_022
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC81C\uBCF4\uC790\uAC00 \uBC14\uAFE8\uC2B5\uB2C8\uB2E4. \uD30C\uD2F0
      \uC911\uC5D0 \uB2E4\uC2DC \uC5F0\uB77D\uD55C\uB2E4\uACE0 \uD588\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_023
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4.
      \uADF8 \uBE44\uC6A9\uC744 \uB204\uAC00 \uCE58\uB97C\uC9C0 \uC0DD\uAC01\uD574
      \uBCF4\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_024
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uADF8 \uBB38\uC7A5, \uC81C \uC81C\uBCF4\uC790\uB3C4 \uC88B\uC544\uD558\uB354\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_025
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC88B\uC740 \uBB38\uC7A5\uC740 \uB110\uB9AC \uC4F0\uC774\uB294 \uBC95\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D1-02_026
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uB4F1\uB85D: \uBE44\uC790\uAE08 \uAE30\uC0AC / \uC775\uBA85
      \uC81C\uBCF4 \uC5B8\uAE09 / \uC774\uBE14\uB9B0\uC758 \uD45C\uD604 \uC2B5\uAD00(\uBBF8\uD655\uC815)."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
