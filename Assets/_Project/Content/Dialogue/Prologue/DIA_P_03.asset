%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_P_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_P_03
  lines:
  - id: P-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB9AC\uCC98\uB4DC\uC758 \uC2A4\uC704\uD2B8\uB294 \uBC14\uB2E4\uAC00 \uC544\uB2C8\uB77C
      \uC624\uB798\uB41C \uC120\uBC15 \uC0AC\uC9C4\uC744 \uD5A5\uD574 \uAFB8\uBA70\uC838
      \uC788\uC5C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC561\uC790\uC5D0\uB294
      \uC80A\uC740 \uB9AC\uCC98\uB4DC\uC640 \uC544\uB4E4 \uC904\uB9AC\uC5B8\uC774
      \uC11C \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_002
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uB9AC\uCC98\uB4DC \uD638\uC190\uC774\uC624. \uBA38\uC11C\uB294 \uCD08\uB300\uBC1B\uC9C0
      \uC54A\uC558\uC18C. \uADF8\uC790\uAC00 \uBC30\uC5D0 \uC624\uB978 \uAC74 \uB204\uAD70\uAC00
      \uB0B4 \uC774\uB984\uC744 \uD6D4\uCCE4\uAE30 \uB54C\uBB38\uC774\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uB204\uAD70\uAC00\uAC00 \uB2F9\uC2E0\uC758 \uC804\uC790\uC11C\uBA85\uACFC
      \uBE44\uC11C\uC2E4 \uC11C\uBC84\uB97C \uC37C\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_004
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB798\uC11C \uB2F9\uC2E0\uC744 \uBD80\uB978 \uAC70\uC694. \uACBD\uCC30\uC744
      \uBD80\uB974\uBA74 \uCD9C\uD56D \uC804\uBD80\uD130 \uD68C\uC0AC \uC8FC\uAC00\uAC00
      \uCE68\uBAB0\uD560 \uD14C\uB2C8\uAE4C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_005
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC775\uBA85 \uD611\uBC15\uC7A5]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD65C\uC790 \uC778\uC1C4\uBB3C\uC774\uB2E4. \u2018\uAC00\uB77C\uC549\uC740
      \uAC83\uC740 \uBC30\uAC00 \uC544\uB2C8\uB77C \uC9C4\uC2E4\uC774\uB2E4. \uC774\uBC88
      \uD56D\uD574\uC5D0\uC11C \uBE44\uC6A9\uC744 \uCE58\uB974\uAC8C \uB420 \uAC83\uC774\uB2E4.\u2019\uB77C\uB294
      \uBB38\uC7A5\uC774 \uC801\uD600 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_007
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uD611\uBC15\uC7A5
      \uBB38\uAD6C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC904\uB9AC\uC5B8\uC758 \uC0AC\uC9C4]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0AC\uC9C4 \uB4A4\uD3B8\uC5D0 \u2018\uC624\uB974\uD398\uC6B0\uC2A4 \uD638
      \uC9C4\uC218\uC2DD, 15\uB144 \uC804\u2019\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4.
      \uB9AC\uCC98\uB4DC\uC758 \uC5C4\uC9C0\uAC00 \uC561\uC790 \uAC00\uC7A5\uC790\uB9AC\uB97C
      \uBC18\uBCF5\uD574\uC11C \uBB38\uC9C8\uB800\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC904\uB9AC\uC5B8
      \uC0AC\uC9C4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uC0AC\uACE0\uC758 \uACF5\uC2DD
      \uC124\uBA85\uC744 \uC9C1\uC811 \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_012
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD3ED\uD48D \uC18D \uAE30\uAD00 \uACE0\uC7A5. \uBC38\uB7EC\uC2A4\uD2B8
      \uC81C\uC5B4 \uC2E4\uD328. \uB0B4 \uC544\uB4E4 \uC904\uB9AC\uC5B8\uC774 \uD604\uC7A5
      \uCC45\uC784\uC790\uC600\uC18C. \uADF8\uB294 \uAD6C\uC870 \uACFC\uC815\uC5D0\uC11C
      \uC8FD\uC5C8\uACE0, \uD68C\uC0AC\uB294 \uBAA8\uB4E0 \uBC30\uC0C1\uC744 \uB9C8\uCCE4\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC870\uC0AC\uAD00 \uB9E4\uC218 \uC758\uD639\uC740\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_014
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC5B8\uB860\uC758 \uC0C1\uC0C1\uB825\uC774\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBA38\uC11C\uB294 \uC0C1\uC0C1\uB825\uC744 \uBB38\uC11C\uB85C \uBB36\uC5B4
      \uC654\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_016
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8 \uBB38\uC11C\uB97C \uCC3E\uC544\uC624\uC2DC\uC624. \uADF8\uB9AC\uACE0
      \uB204\uAC00 \uB0B4 \uC774\uB984\uC73C\uB85C \uADF8\uC790\uB97C \uBD88\uB800\uB294\uC9C0
      \uBC1D\uD600\uB0B4\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_017
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uBCF4\uC218\uB97C \uBB3B\uAE30"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_018
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC544\uB4E4\uC5D0 \uAD00\uD574 \uBB3B\uAE30"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD68C\uC0AC\uC640 \uAC00\uC871\uC758 \uBE44\uBC00\uC744 \uB3D9\uC2DC\uC5D0
      \uC9C0\uD0A4\uB294 \uC77C\uC785\uB2C8\uB2E4. \uBCF4\uC218\uB3C4 \uB458 \uBAAB\uC774\uACA0\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_020
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uACB0\uACFC\uB97C \uAC00\uC838\uC624\uBA74 \uC561\uC218\uB294 \uBB38\uC81C\uAC00
      \uC544\uB2C8\uC624. \uCDA9\uC131\uC2EC\uC744 \uC0AC\uB824\uB294 \uAC74 \uC544\uB2C8\uB2C8
      \uC548\uC2EC\uD558\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC904\uB9AC\uC5B8\uC774 \uC815\uB9D0 \uCC45\uC784\uC790\uC600\uB2E4\uACE0
      \uBBFF\uC2B5\uB2C8\uAE4C, \uC544\uB2C8\uBA74 \uADF8\uB807\uAC8C \uBBFF\uC5B4\uC57C
      \uD588\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_022
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8 \uC544\uC774\uB294 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0B4\uAC8C
      \uC5F0\uB77D\uD558\uC9C0 \uC54A\uC558\uC18C. \uCE68\uBB35\uC740 \uC8C4\uCC45\uAC10\uACFC
      \uB2EE\uC558\uC9C0. \uB108\uBB34 \uB2EE\uC544\uC11C \uB098\uB294 \uB458\uC744
      \uAD6C\uBD84\uD558\uC9C0 \uBABB\uD588\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_023
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uBCA0\uC77C. \uD68C\uC0AC\uC758 \uC774\uB984\uC740 \uC9C0\uCF1C\uB3C4
      \uC88B\uC9C0\uB9CC, \uB0B4 \uC544\uB4E4\uC758 \uC774\uB984\uC744 \uD568\uBD80\uB85C
      \uB2E4\uB8E8\uC9C0\uB294 \uB9C8\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_024
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uB984\uC740 \uC99D\uAC70\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uADF8
      \uC810\uC740 \uB204\uAD6C\uC5D0\uAC8C\uB098 \uACF5\uD3C9\uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-03_025
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC0C8 \uC758\uB8B0: \uC775\uBA85 \uD611\uBC15\uACFC \uC704\uC870 \uCD08\uB300
      \uC870\uC0AC. \uB9AC\uCC98\uB4DC\uC640\uC758 \uAD00\uACC4\uC5D0 \uC601\uD5A5\uC744
      \uC90D\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
