%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_P_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_P_01
  lines:
  - id: P-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC5D8\uB9AC\uC2DC\uC6C0 \uD638\uB294 \uD56D\uAD6C\uC758 \uC720\uB9AC
      \uC9C0\uBD95 \uB108\uBA38\uC5D0\uC11C \uC9C0\uB098\uCE58\uAC8C \uC0C8\uAC83\uCC98\uB7FC
      \uBE5B\uB098\uACE0 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_002
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB2E4\uB2C8\uC5D8 \uBA38\uC11C\uB294 \uD0D1\uC2B9 \uC904\uC5D0\uC11C
      \uD55C \uAC78\uC74C \uB5A8\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uCCAD\uB85D\uC0C9
      \uC637\uAE43\uC740 \uAD6C\uACA8\uC838 \uC788\uC5C8\uACE0, \uC624\uB978\uC190\uC740
      \uC8FC\uBA38\uB2C8 \uC18D \uC9C4\uB3D9\uC744 \uACC4\uC18D \uD655\uC778\uD588\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_003
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAD6C\uACA8\uC9C4 \uCD08\uB300\uC7A5]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_004
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC885\uC774\uB294 \uB450 \uBC88 \uC811\uD614\uB2E4\uAC00 \uAE09\uD788
      \uD3B4\uC84C\uB2E4. \uB9AC\uCC98\uB4DC\uC758 \uC804\uC790\uC11C\uBA85\uC740
      \uC120\uBA85\uD558\uC9C0\uB9CC \uBC1C\uC1A1 \uCF54\uB4DC\uAC00 \uCD08\uB300\uC7A5
      \uBCF8\uBB38\uACFC \uB2E4\uB978 \uC11C\uCCB4\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_005
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-01 \uB2E4\uB2C8\uC5D8\uC758 \uCD08\uB300\uC7A5"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_006
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC554\uD638\uD654 \uBA54\uC2E0\uC800 \uC54C\uB9BC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC1C\uC2E0\uC790 \uD45C\uC2DC\uB294 \uC5C6\uB2E4. \uBBF8\uB9AC\uBCF4\uAE30\uC5D0\uB294
      \u2018\uC120\uBBF8, 21\uC2DC \uC774\uD6C4. \uD68C\uC7A5\uC774 \uD63C\uC790\uC77C
      \uB54C\u2019\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_008
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC775\uBA85 \uC81C\uBCF4
      \uC54C\uB9BC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_009
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC544\uB4DC\uB9AC\uC548 \uBCA0\uC77C. \uD734\uAC00 \uC911\uC778 \uD0D0\uC815\uAE4C\uC9C0
      \uBD88\uB800\uB2E4\uBA74 \uD638\uC190\uB3C4 \uBD88\uC548\uD558\uAE34 \uD55C
      \uBAA8\uC591\uC774\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_010
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC6B0\uB9AC\uAC00 \uC544\uB294 \uC0AC\uC774\uC600\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_011
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC544\uB1E8. \uD558\uC9C0\uB9CC \uC774\uB984\uC740 \uC555\uB2C8\uB2E4.
      \uD754\uC801\uBCF4\uB2E4 \uC2DC\uAC04\uC774 \uBA3C\uC800 \uAC70\uC9D3\uB9D0\uD55C\uB2E4\uACE0
      \uB9D0\uD55C \uD615\uC0AC."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAE30\uC0AC\uB294 \uC624\uB798 \uB0A8\uB294 \uBAA8\uC591\uC774\uAD70\uC694.
      \uAE30\uC790\uBCF4\uB2E4\uB3C4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_013
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC774\uBC88 \uC5EC\uD589\uC774 \uB05D\uB098\uBA74 \uC81C \uAE30\uC0AC\uB3C4
      \uC624\uB798 \uB0A8\uC744 \uAC81\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC \uD638\uC190\uC740
      \uAC10\uC625\uC5D0 \uC788\uAC70\uB098 \uBC14\uB2E4\uC5D0 \uC788\uACA0\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uD655\uC2E0\uC740 \uC5B4\uB514\uC11C \uC654\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_015
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "15\uB144 \uC804 \uC624\uB974\uD398\uC6B0\uC2A4 \uD638. \uBCF4\uD5D8\uAE08,
      \uB9E4\uC218\uB41C \uC870\uC0AC\uAD00, \uC0AC\uB77C\uC9C4 \uD56D\uD574 \uB370\uC774\uD130.
      \uB204\uAD70\uAC00 \uC81C\uAC8C \uC6D0\uBCF8\uC774 \uC544\uC9C1 \uBC30 \uC548\uC5D0
      \uC788\uB2E4\uACE0 \uC54C\uB824\uC654\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC775\uBA85 \uC81C\uBCF4\uC790\uB97C \uBBFF\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_017
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC0AC\uB78C\uC740 \uC548 \uBBFF\uC2B5\uB2C8\uB2E4. \uBB38\uC11C\uC640
      \uAC81\uBA39\uC740 \uBC18\uC751\uC744 \uBBFF\uC8E0. \uB9AC\uCC98\uB4DC\uB294
      \uC81C \uC774\uB984\uC744 \uB4E3\uC790\uB9C8\uC790 \uC2B9\uC120 \uBA85\uB2E8\uC744
      \uB2E4\uC2DC \uBCF4\uAC8C \uB420 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: P-01_018
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uD639\uC2DC \uC81C\uAC00 \uC57D\uC18D \uC2DC\uAC04\uC5D0 \uB098\uD0C0\uB098\uC9C0
      \uC54A\uC73C\uBA74, \uC81C \uAC1D\uC2E4\uC758 \uC608\uC57D \uAE30\uC0AC\uB97C
      \uBA3C\uC800 \uBCF4\uC138\uC694. \uD0DC\uBE14\uB9BF\uC740 \uC81C\uAC00 \uAC00\uC9C4
      \uAC83 \uC911 \uAC00\uC7A5 \uC704\uD5D8\uD55C \uBB3C\uAC74\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c3e720736d5a14341900bff5ff757347, type: 2}
    effects: []
    choices: []
  - id: P-01_019
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uD55C \uAC00\uC9C0\uB9CC \uAE30\uC5B5\uD558\uC138\uC694. \uC774 \uBC30\uC5D0\uC11C
      \uB204\uAC00 \uBB34\uC5C7\uC744 \uC228\uAE30\uB294\uC9C0\uBCF4\uB2E4, \uB204\uAC00
      \uBB34\uC5C7\uC744 \uB108\uBB34 \uCE5C\uC808\uD558\uAC8C \uC124\uBA85\uD558\uB294\uC9C0\uAC00
      \uC911\uC694\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: P-01_C1
      text: "\uADF8\uC758 \uACBD\uACE0\uB97C \uC9C4\uC9C0\uD558\uAC8C \uB4E3\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 59f41e34fbe4d424193b26e8b07affcd, type: 2}
      nextLineId: P-01_022
    - id: P-01_C2
      text: "\uB18D\uB2F4\uC73C\uB85C \uB118\uAE30\uAE30"
      conditions: []
      effects:
      - {fileID: 11400000, guid: e82e415d8d89dcb42b7c3fed37d9f282, type: 2}
      nextLineId: P-01_024
  - id: P-01_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC57D\uC18D\uD569\uB2C8\uB2E4. \uB2F9\uC2E0\uC774 \uC0AC\uB77C\uC9C0\uBA74
      \uBA3C\uC800 \uC2DC\uAC04\uC744 \uD655\uC778\uD558\uC8E0. \uADF8\uB9AC\uACE0
      \uB2F9\uC2E0\uC758 \uD655\uC2E0\uB3C4 \uC758\uC2EC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 45f78c9760c79394583c21593adbf5ef, type: 2}
    effects: []
    choices: []
  - id: P-01_023
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uADF8 \uC815\uB3C4\uBA74 \uCDA9\uBD84\uD569\uB2C8\uB2E4. \uC81C \uD3B8\uC774
      \uC544\uB2C8\uB77C \uC0AC\uC2E4 \uD3B8\uC5D0 \uC11C\uC8FC\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 45f78c9760c79394583c21593adbf5ef, type: 2}
    effects: []
    choices: []
  - id: P-01_024
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC10\uC625\uACFC \uBC14\uB2E4 \uC911 \uD558\uB098\uB77C\uB2C8, \uD06C\uB8E8\uC988
      \uD64D\uBCF4 \uBB38\uAD6C\uB85C\uB294 \uC9C0\uB098\uCE58\uAC8C \uC815\uC9C1\uD558\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: a0ded424b003aae48a8577794326521d, type: 2}
    effects: []
    choices: []
  - id: P-01_025
    speaker:
      character: {fileID: 11400000, guid: 3c149c9299d6ca44b95f2cdf2aaf07d0, type: 2}
      overrideName: DANIEL
    text: "\uC6C3\uC5B4\uB450\uC138\uC694. \uD56D\uAD6C\uB97C \uBC97\uC5B4\uB098\uBA74
      \uC120\uD0DD\uC9C0\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: a0ded424b003aae48a8577794326521d, type: 2}
    effects: []
    choices: []
  - id: P-01_026
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uD29C\uD1A0\uB9AC\uC5BC \uC644\uB8CC: \uAD00\uCC30\uD55C \uC0AC\uBB3C\uACFC
      \uB300\uD654 \uD0A4\uC6CC\uB4DC\uAC00 \uB2E8\uC11C \uBCF4\uB4DC\uC5D0 \uB4F1\uB85D\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
