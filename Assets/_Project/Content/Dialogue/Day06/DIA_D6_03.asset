%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D6_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D6_03
  lines:
  - id: D6-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uBC38\uB7EC\uC2A4\uD2B8 \uC81C\uC5B4 \uBCC4\uC2E4\uC758 \uBC14\uB2E5\uC740
      \uAC80\uC740 \uACE0\uBB34 \uCF54\uD305\uC73C\uB85C \uB36E\uC5EC \uC788\uC5C8\uB2E4.
      \uC138\uCC99\uC81C \uB0C4\uC0C8\uAC00 \uAC15\uD588\uC9C0\uB9CC \uBC30\uC218\uAD6C
      \uAC00\uC7A5\uC790\uB9AC\uC5D0\uB294 \uC624\uB798 \uB9C8\uB978 \uAC08\uC0C9
      \uC120\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC5EC\uAE34 \uC758\uB8CC \uAD6C\uC5ED\uBCF4\uB2E4 \uAE68\uB057\uD558\uB124\uC694.
      \uC0AC\uAC74 \uB4A4\uC5D0 \uCCAD\uC18C\uD588\uAE30 \uB54C\uBB38\uC774\uB77C\uBA74\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_003
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB2E4\uB2C8\uC5D8\uC758 \uAD6C\uB450 \uBC11\uCC3D \uB300\uC870]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_004
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAD6C\uB450 \uD648\uC5D0\uC11C \uB098\uC628 \uAC80\uC740 \uACE0\uBB34
      \uC870\uAC01\uC758 \uC785\uC790\uC640 \uBC14\uB2E5 \uCF54\uD305\uC774 \uC77C\uCE58\uD55C\uB2E4.
      \uD638\uB77C\uC774\uC98C \uB8F8 \uCE74\uD3AB\uC5D0\uC11C\uB294 \uC0DD\uAE38
      \uC218 \uC5C6\uB294 \uB9C8\uBAA8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_005
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-06 \uAD6C\uB450 \uBC11\uCC3D"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uC8FD\uAE30 \uC804\uC5D0 \uC774 \uBC14\uB2E5\uC744
      \uAC78\uC5C8\uC2B5\uB2C8\uB2E4. \uC11C\uBE44\uC2A4 \uACC4\uB2E8 \uB3D9\uC120\uACFC\uB3C4
      \uB9DE\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBC30\uC218\uAD6C \uC8FC\uBCC0 \uC138\uCC99 \uD754\uC801]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD45C\uBC31\uC81C\uAC00 \uD608\uC561 \uB2E8\uBC31\uC9C8\uC744 \uC644\uC804\uD788
      \uC81C\uAC70\uD558\uC9C0 \uBABB\uD588\uB2E4. \uBC30\uC218 \uBC29\uD5A5\uC73C\uB85C
      \uB2E6\uC544\uB0B8 \uB113\uC740 \uC790\uAD6D\uC774 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uD608\uD754 \uC138\uCC99
      \uD754\uC801"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB8E8\uBBF8\uB180 \uC870\uC0AC: \uAD11\uC6D0\uC744 \uB044\uACE0 \uBC18\uC751
      \uC601\uC5ED\uC744 \uC21C\uC11C\uB300\uB85C \uCD2C\uC601\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_011
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uBCBD\uC774 \uC544\uB2C8\uB77C \uBC14\uB2E5 \uC911\uC559\uC5D0\uC11C
      \uAC15\uD558\uAC8C \uBC18\uC751\uD574\uC694. \uB04C\uB9B0 \uC790\uAD6D\uC740
      \uC5C6\uACE0, \uD55C\uACF3\uC5D0 \uBA38\uBB38 \uD754\uC801\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC791\uC740 \uBE44\uC0B0\uC810\uC740 \uC606\uAD6C\uB9AC \uB192\uC774\uC5D0\uC11C
      \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC790\uC0C1\uC740 \uC5EC\uAE30\uC11C \uC0DD\uACBC\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_013
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uADF8\uB7F0\uB370 \uCD9C\uD608\uB7C9\uC740 \uCE58\uBA85\uC0C1\uBCF4\uB2E4
      \uC801\uC2B5\uB2C8\uB2E4. \uC0C1\uCC98 \uB4A4\uC5D0\uB3C4 \uC2EC\uC7A5\uC740
      \uC624\uB798 \uB6F0\uC9C0 \uC54A\uC558\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_014
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBD88\uD65C\uC131 \uAC00\uC2A4 \uC81C\uC5B4 \uB85C\uADF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21:43:18 \uC9C8\uC18C \uD37C\uC9C0 \uC218\uB3D9 \uC2E4\uD589, 21:46:02
      \uC885\uB8CC. \uC548\uC804 \uC778\uD130\uB85D\uC774 \uC6B4\uC601 \uAD00\uB9AC\uC790
      \uAD8C\uD55C\uC73C\uB85C \uC6B0\uD68C\uB418\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_016
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-12 \uC9C8\uC18C \uB85C\uADF8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_017
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "3\uBD84 \uAC00\uAE4C\uC774 \uC0B0\uC18C\uAC00 \uAE09\uAC10\uD588\uC2B5\uB2C8\uB2E4.
      \uBCF4\uD638 \uC7A5\uBE44\uAC00 \uC5C6\uC5C8\uB2E4\uBA74 \uC758\uC2DD\uC744
      \uC783\uAE30\uC5D0 \uCDA9\uBD84\uD574\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uC548\uC815\uC81C\uB85C \uBC18\uC751\uC774 \uB290\uB824\uC9C4
      \uC0C1\uD0DC\uC600\uC2B5\uB2C8\uB2E4. \uC790\uC0C1\uC73C\uB85C \uAC81\uC744
      \uC8FC\uACE0, \uBB38\uC744 \uB2EB\uACE0, \uC9C8\uC18C\uB97C \uD758\uB838\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_019
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC9C1\uC811 \uC0AC\uC778\uC740 \uC544\uC9C1 \uBD80\uAC80 \uC18C\uACAC\uACFC
      \uB9DE\uCDB0\uC57C \uD558\uC9C0\uB9CC, \uC774 \uBC29\uC774 \uC0AC\uB9DD \uC7A5\uC18C\uB77C\uB294
      \uAC74 \uD655\uC2E4\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC138\uCC99\uC81C \uBC18\uC751\uB9CC\uC73C\uB85C\uB294 \uD608\uC561 \uC704\uCE58\uB97C
      \uD2B9\uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB8E8\uBBF8\uB180\uC758
      \uAC15\uB3C4\uC640 \uD615\uD0DC\uB97C \uBCF4\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uBC38\uB7EC\uC2A4\uD2B8 \uBCC4\uC2E4\uC5D0\uC11C
      \uC790\uC0C1\uC744 \uC785\uACE0 \uC9C8\uC18C\uC5D0 \uB178\uCD9C\uB410\uC2B5\uB2C8\uB2E4.
      \uD638\uB77C\uC774\uC98C \uB8F8\uC740 \uC0AC\uB9DD \uD604\uC7A5\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_022
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uBC14\uB2E5 \uC911\uC559\uC758 \uAC00\uC7A5 \uAC15\uD55C \uBC18\uC751\uBD80\uD130
      \uCD2C\uC601\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_023
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC606\uAD6C\uB9AC \uB192\uC774\uC758 \uC791\uC740 \uBE44\uC0B0\uC810\uACFC
      \uC911\uC559 \uD608\uD754\uC744 \uC5F0\uACB0\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_024
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC9C8\uC18C \uB85C\uADF8 21:43~21:46\uC744 \uD608\uD754 \uBC18\uC751\uACFC
      \uD568\uAED8 \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-03_025
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC2E4\uC81C \uD604\uC7A5 \uD655\uC815: \uBC38\uB7EC\uC2A4\uD2B8 \uC81C\uC5B4
      \uBCC4\uC2E4. C-06, C-12 \uD68D\uB4DD."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
