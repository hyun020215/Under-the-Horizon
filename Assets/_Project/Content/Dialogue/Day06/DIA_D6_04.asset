%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D6_04
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D6_04
  lines:
  - id: D6-04_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD5EC\uB808\uB098\uB294 \uB2E4\uB2C8\uC5D8\uC758 \uBD80\uAC80 \uB3C4\uC2DD
      \uC704\uC5D0 \uB450 \uAC1C\uC758 \uC2DC\uAC04\uC744 \uC801\uC5C8\uB2E4. \u2018\uC0C1\uCC98\u2019\uC640
      \u2018\uC0AC\uB9DD\u2019 \uC0AC\uC774\uC5D0 \uBE48 \uD654\uC0B4\uD45C\uAC00
      \uB193\uC600\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC790\uC0C1\uC740 \uAC04\uACFC \uD070 \uD608\uAD00\uC744 \uD53C\uD588\uC2B5\uB2C8\uB2E4.
      \uACE0\uD1B5\uC2A4\uB7FD\uACE0 \uD53C\uAC00 \uB098\uC9C0\uB9CC \uC989\uC2DC
      \uCE58\uBA85\uC801\uC774\uC9C0\uB294 \uC54A\uC544\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC81\uC744 \uC8FC\uACE0 \uC6C0\uC9C1\uC784\uC744 \uB2A6\uCD94\uB294
      \uC0C1\uCC98."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_004
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC9C1\uC811 \uC0AC\uC778\uC740 \uC800\uC0B0\uC18C\uC131 \uC9C8\uC2DD\uC785\uB2C8\uB2E4.
      \uD3D0\uC640 \uD608\uC561 \uC18C\uACAC\uC774 \uC9C8\uC18C \uB178\uCD9C\uACFC
      \uC77C\uCE58\uD574\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_005
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uD3D0\xB7\uD608\uC561 \uC18C\uACAC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAE30\uB3C4 \uC190\uC0C1 \uC5C6\uC774 \uAE09\uACA9\uD55C \uC800\uC0B0\uC18C
      \uC0C1\uD0DC. \uC9C8\uC18C \uD37C\uC9C0 \uB85C\uADF8\uC640 \uC2DC\uAC04 \uBC94\uC704\uAC00
      \uC77C\uCE58\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_007
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-12 \uC9C8\uC18C \uB85C\uADF8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC5B4\uAE68\xB7\uD5C8\uB9AC \uC555\uBC15 \uD754\uC801]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0AC\uD6C4\uC5D0 \uB113\uC740 \uBCA8\uD2B8\uAC00 \uBAB8\uC744 \uB20C\uB800\uB2E4.
      \uC6B4\uBC18\uBC31 \uB0B4\uBD80 \uACE0\uC815\uB760 \uAC04\uACA9\uACFC \uC77C\uCE58\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-10 \uC6B4\uBC18\uBC31 \uC790\uAD6D"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_011
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBCF4\uD638\uBA74 \uD30C\uD3B8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uC190\uD1B1 \uC544\uB798 \uD22C\uBA85 \uC218\uC9C0
      \uC870\uAC01. \uC0B0\uC5C5\uC6A9 \uC804\uBA74 \uBCF4\uD638\uBA74\uC758 \uCF54\uD305\uACFC
      \uC720\uC0AC\uD558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_013
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uBCF4\uD638\uBA74
      \uD30C\uD3B8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_014
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC0AC\uB9DD \uC21C\uC11C \uD37C\uC990: \uC548\uC815\uC81C \uBCF5\uC6A9,
      \uBC38\uB7EC\uC2A4\uD2B8 \uB3C4\uCC29, \uC790\uC0C1, \uC9C8\uC18C \uB178\uCD9C,
      \uC0AC\uB9DD, \uC6B4\uBC18\uBC31 \uACE0\uC815, \uD638\uB77C\uC774\uC98C \uB8F8
      \uD22C\uC785\uC744 \uBC30\uC5F4\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC548\uC815\uC81C\uB294 \uC0B4\uD574 \uC218\uB2E8\uC774 \uC544\uB2C8\uB77C
      \uC800\uD56D\uC744 \uB2A6\uCD98 \uC0AC\uC804 \uC870\uAC74\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_016
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC790\uC0C1 \uB4A4 \uC9C8\uC18C \uB178\uCD9C. \uC0AC\uB9DD\uC740 \uC6B4\uBC18\uBC31
      \uC555\uBC15 \uD754\uC801\uBCF4\uB2E4 \uC55E\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB294 \uB450 \uBC88 \u2018\uC8FD\uC740 \uAC83\uCC98\uB7FC\u2019
      \uBCF4\uC600\uC2B5\uB2C8\uB2E4. \uC790\uC0C1\uC73C\uB85C \uC4F0\uB7EC\uC84C\uC9C0\uB9CC
      \uC0B4\uC544 \uC788\uC5C8\uACE0, \uC9C8\uC18C\uB85C \uC2E4\uC81C\uB85C \uC8FD\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC6B4\uBC18\uBC31 \uC555\uBC15\uC744 \uC0AC\uB9DD \uC804\uC73C\uB85C
      \uB450\uBA74 \uC0DD\uC804 \uBA4D\uACFC \uC800\uD56D \uD754\uC801\uC774 \uC788\uC5B4\uC57C
      \uD569\uB2C8\uB2E4. \uC0AC\uD6C4 \uD754\uC801\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC790\uC0C1\uC744 \uC9C1\uC811 \uC0AC\uC778\uC73C\uB85C \uB450\uBA74
      \uB0AE\uC740 \uCD9C\uD608\uB7C9\uACFC \uD3D0 \uC18C\uACAC\uC744 \uC124\uBA85\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC21C\uC11C: \uC548\uC815\uC81C \u2192 \uBC38\uB7EC\uC2A4\uD2B8 \uC720\uC778
      \u2192 \uBE44\uCE58\uBA85 \uC790\uC0C1 \u2192 \uC9C8\uC18C \uC9C8\uC2DD \u2192
      \uC6B4\uBC18\uBC31 \uACE0\uC815 \u2192 \uB808\uC77C \uC774\uB3D9 \u2192 \uD638\uB77C\uC774\uC98C
      \uB8F8 \uD22C\uC785."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_021
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uBCF4\uD638\uBA74 \uD30C\uD3B8\uC740 \uBC94\uC778\uC774 \uB2E4\uB2C8\uC5D8
      \uAC00\uAE4C\uC774 \uC788\uC5C8\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4. \uC9C8\uC18C\uB97C
      \uACAC\uB514\uB824\uBA74 \uBCF4\uD638 \uC7A5\uBE44\uAC00 \uD544\uC694\uD588\uC744
      \uD14C\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uB9C8\uC9C0\uB9C9 \uC21C\uAC04 \uBCF4\uD638\uBA74\uC744
      \uAE01\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8 \uC7A5\uBE44\uB97C \uCC3E\uC73C\uBA74
      \uC9C1\uC811 \uC811\uCD09\uC744 \uC99D\uBA85\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_023
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC758\uD559 \uC18C\uACAC\uC73C\uB85C \u2018\uC0DD\uC804\u2019\uACFC \u2018\uC0AC\uD6C4\u2019
      \uD754\uC801\uC744 \uB098\uB204\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_024
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC0AC\uB9DD\uC740 \uC9C8\uC18C \uB178\uCD9C \uB4A4, \uC6B4\uBC18\uBC31
      \uC555\uBC15 \uC804\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_025
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC790\uC0C1\uC740 \uBE44\uCE58\uBA85\uC0C1\uC774\uBA70 \uC9C1\uC811 \uC0AC\uC778\uC740
      \uC9C8\uC2DD\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-04_026
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC9C1\uC811 \uC0AC\uC778 \uD655\uC815: \uC9C8\uC2DD. \uBCF4\uD638\uBA74
      \uC7A5\uBE44\uB97C \uCD94\uC801\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
