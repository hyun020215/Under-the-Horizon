%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D6_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D6_01
  lines:
  - id: D6-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uAE30\uAD00 \uC81C\uC5B4\uC2E4\uC758 \uADF8\uB798\uD504\uB294 \uBC24\uC0C8
      \uBC30\uAC00 \uD30C\uB3C4\uC5D0 \uB9DE\uC11C \uADE0\uD615\uC744 \uACE0\uCE5C
      \uAE30\uB85D\uC774\uC5C8\uB2E4. \uD55C \uC904\uB9CC\uC774 \uD30C\uB3C4\uC640
      \uC0C1\uAD00\uC5C6\uC774 \uB9E4\uB048\uD558\uAC8C \uC6C0\uC9C1\uC600\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_002
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uC548\uC815\uD654 \uC7A5\uCE58\uB294 \uC88C\uD604\uACFC \uC6B0\uD604
      \uBB34\uAC8C \uBCC0\uD654\uB97C \uACC4\uC0B0\uD569\uB2C8\uB2E4. \uC2B9\uAC1D
      \uD55C \uBA85\uC740 \uBB34\uC2DC\uD558\uC9C0\uB9CC, \uC77C\uC815\uD55C \uC18D\uB3C4\uB85C
      \uCE35\uC744 \uAC00\uB85C\uC9C0\uB974\uBA74 \uD328\uD134\uC774 \uB0A8\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_003
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uBE44\uAD50 \uD37C\uC990: \uAE30\uC0C1 \uD30C\uB3C4 \uB85C\uADF8\uC640
      \uC120\uCCB4 \uBCF4\uC815 \uB85C\uADF8\uB97C \uC2DC\uAC04\uCD95\uC5D0 \uACB9\uCE58\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_004
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uBCF4\uC815\uAC12\uC774 86\uD0AC\uB85C\uADF8\uB7A8\uC785\uB2C8\uB2E4.
      \uD30C\uB3C4\uB77C\uBA74 \uC774\uB807\uAC8C \uC77C\uC815\uD55C \uC18D\uB3C4\uB85C
      \uC774\uB3D9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "7\uCE35 \uC120\uBBF8\uC5D0\uC11C 8\uCE35 \uD638\uB77C\uC774\uC98C \uB8F8\uAE4C\uC9C0.
      \uC0AC\uB78C \uD55C \uBA85\uC758 \uBB34\uAC8C\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_006
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uD558\uC9C0\uB9CC \uC2B9\uAC1D\uC6A9 \uC2B9\uAC15\uAE30\uB294 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC2B9\uAC1D\uC774 \uC544\uB2C8\uC5C8\uC73C\uB2C8\uAE4C\uC694. \uD654\uBB3C\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: 22:17 \uC548\uC815\uD654 \uB85C\uADF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "22:17:42\uBD80\uD130 22:18:11\uAE4C\uC9C0 \uC57D 86kg\uC774 \uC120\uBBF8
      \uC6B0\uD604 7\uCE35\uC5D0\uC11C \uC911\uC559 \uC6B0\uD604 8\uCE35\uC73C\uB85C
      \uC77C\uC815\uD558\uAC8C \uC774\uB3D9\uD588\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-09 \uC548\uC815\uD654 \uB85C\uADF8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_011
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAE30\uC0C1 \uB85C\uADF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC19\uC740 \uC2DC\uAC04 \uD30C\uACE0\uC640 \uD48D\uD5A5 \uBCC0\uD654\uB294
      \uBBF8\uBBF8\uD558\uB2E4. \uC790\uC5F0 \uC694\uC778\uC73C\uB85C \uC124\uBA85\uD560
      \uC218 \uC5C6\uB294 \uC120\uCCB4 \uBCF4\uC815\uC774\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_013
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uAE30\uC0C1\uACFC
      \uBD88\uC77C\uCE58"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_014
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uD589\uC0AC \uB808\uC77C\uC758 \uBAA8\uD130 \uC18D\uB3C4\uC640 \uC774\uB3D9
      \uC2DC\uAC04\uC774 \uAC70\uC758 \uAC19\uC2B5\uB2C8\uB2E4. \uAC1C\uC870 \uBD84\uAE30\uAC00
      \uC0B4\uC544 \uC788\uB2E4\uBA74 \uBC38\uB7EC\uC2A4\uD2B8\uC5D0\uC11C \uD638\uB77C\uC774\uC98C
      \uB8F8\uAE4C\uC9C0 29\uCD08."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC10\uC9C0\uAE30 \uC624\uB958\uAC00 22\uC2DC 18\uBD84 07\uCD08. \uBB34\uAC8C\uAC00
      \uD638\uB77C\uC774\uC98C \uB8F8 \uC704\uB97C \uC9C0\uB09C \uC21C\uAC04\uACFC
      \uACB9\uCE69\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_016
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uB808\uC77C \uC81C\uC5B4 \uB85C\uADF8\uB294 \uD589\uC0AC \uC11C\uBC84\uC5D0
      \uC788\uC2B5\uB2C8\uB2E4. \uC815\uC0C1 \uBAA9\uC801\uC9C0\uB294 \u2018\uBCC4
      \uC7A5\uC2DD \uBCF4\uAD00\uD568\u2019\uC73C\uB85C \uAE30\uB85D\uB410\uC744
      \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD30C\uB3C4 \uADF8\uB798\uD504\uC640 \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C
      \uC6C0\uC9C1\uC774\uB294 \uAC12\uC740 \uC790\uC5F0 \uBCF4\uC815\uC785\uB2C8\uB2E4.
      \uC77C\uC815\uD55C \uC18D\uB3C4\uC758 \uB3C5\uB9BD \uC2E0\uD638\uB97C \uCC3E\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC2B9\uAC15\uAE30 \uAE30\uB85D\uC5D0\uB294 \uAC19\uC740 \uBB34\uAC8C\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C\uC758 \uC774\uB3D9 \uACBD\uB85C\uB85C
      \uC5F0\uACB0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "86kg\uC758 \uBB3C\uCCB4\uAC00 \uD589\uC0AC \uB808\uC77C \uC18D\uB3C4\uB85C
      7\uCE35\uC5D0\uC11C \uD638\uB77C\uC774\uC98C \uB8F8 \uCC9C\uC7A5\uAE4C\uC9C0
      \uC774\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_020
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uD30C\uB3C4 \uBCC0\uD654\uC640 \uBAA8\uC591\uC774 \uB2E4\uB978 \uBCF4\uC815\uC120\uC744
      \uCC3E\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_021
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "22\uC2DC 17\uBD84 42\uCD08\uBD80\uD130 29\uCD08 \uB3D9\uC548 \uC77C\uC815\uD558\uAC8C
      \uC6C0\uC9C1\uC774\uB294 86kg \uC2E0\uD638\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_022
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "7\uCE35 \uC120\uBBF8 \u2192 8\uCE35 \uD638\uB77C\uC774\uC98C \uB8F8 \uACBD\uB85C\uB97C
      \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D6-01_023
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "C-09 \uD68D\uB4DD. \uC2DC\uC2E0 \uC774\uB3D9\uC774 \uD655\uC815\uB418\uACE0
      \uC11C\uBE44\uC2A4 \uB808\uC77C \uC811\uADFC\uC774 \uD574\uAE08\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
