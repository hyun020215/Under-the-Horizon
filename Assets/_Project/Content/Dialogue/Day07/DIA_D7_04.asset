%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D7_04
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D7_04
  lines:
  - id: D7-04_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD574 \uC9C8 \uBB34\uB835, \uC774\uBE14\uB9B0\uC740 \uB09C\uAC04\uC5D0
      \uAE30\uB300\uC9C0 \uC54A\uC740 \uCC44 \uBC14\uB2E4\uB97C \uBC14\uB77C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4. \uC190\uC5D0 \uB4E0 \uAC83\uC740 \uACC4\uC57D\uC11C\uB3C4
      \uBB34\uAE30\uB3C4 \uC544\uB2CC, \uB2E4\uB2C8\uC5D8\uC758 \uC704\uC870 \uCD08\uB300\uC7A5
      \uC0AC\uBCF8\uC774\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_002
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uD68C\uC7A5\uB2D8\uC740 \uC740\uD3D0\uB97C \uC778\uC815\uD560 \uAC81\uB2C8\uB2E4.
      \uC870\uC0AC\uAD00 \uB9E4\uC218, \uAE30\uB85D \uC0AD\uC81C, \uBCF4\uD5D8\uAE08
      \uC218\uB839. \uB300\uC911\uC740 \uBCF5\uC7A1\uD55C \uC124\uACC4\uC790\uBCF4\uB2E4
      \uC775\uC219\uD55C \uC545\uC778\uC744 \uC6D0\uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB798\uC11C \uB2E4\uB2C8\uC5D8\uB3C4 \uB9AC\uCC98\uB4DC\uB9CC \uBCF4\uAC8C
      \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_004
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uBCF4\uACE0 \uC2F6\uC740 \uAC83\uC744 \uBD24\uC2B5\uB2C8\uB2E4.
      \uC800\uB294 \uBB38\uC744 \uC5F4\uC5B4 \uC92C\uC744 \uBFD0\uC774\uC5D0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uBB38\uC740 \uBC38\uB7EC\uC2A4\uD2B8\uB85C \uC774\uC5B4\uC84C\uACE0,
      \uB4A4\uC5D0\uC11C\uB294 \uC7A0\uACBC\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_006
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC99D\uBA85\uD560 \uC218 \uC788\uB294 \uAC83\uC740 \uCD08\uB300\uC640
      \uAE08\uACE0 \uC811\uADFC\uBFD0\uC785\uB2C8\uB2E4. \uC0B4\uD574 \uC21C\uAC04\uC758
      \uC774\uC57C\uAE30\uB294 \uB2F9\uC2E0\uC758 \uC870\uB9BD\uD488\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF4\uD638\uBA74 \uC548\uCABD \uB2E4\uB2C8\uC5D8 DNA\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC774\uBE14\uB9B0\uC758 \uC2DC\uC120\uC774 \uCC98\uC74C\uC73C\uB85C \uBC14\uB2E4\uC5D0\uC11C
      \uBC97\uC5B4\uB0AC\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_009
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uADF8\uB807\uB2E4\uBA74 \uAC70\uB798\uD569\uC2DC\uB2E4. \uB9AC\uCC98\uB4DC\uC758
      \uC740\uD3D0\uB97C \uC804\uBD80 \uACF5\uAC1C\uD558\uACE0, \uC800\uB294 \uC6B4\uC601\uC0C1
      \uACFC\uC2E4\uACFC \uC99D\uAC70 \uD6FC\uC190\uB9CC \uC778\uC815\uD558\uC8E0.
      \uD68C\uC0AC\uAC00 \uC0B4\uC544\uC57C \uD53C\uD574\uC790 \uBCF4\uC0C1\uB3C4
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D7-04_C1
      text: "\uAC70\uB798\uB97C \uC218\uB77D\uD558\uB294 \uCC99\uD55C\uB2E4"
      conditions: []
      effects:
      - {fileID: 11400000, guid: af8d8dc9e9e0e38449f25ce18b266975, type: 2}
      nextLineId: D7-04_012
    - id: D7-04_C2
      text: "\uAC70\uC808\uD55C\uB2E4"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 8f478031294dcdd46bdae7ec135e8e78, type: 2}
      nextLineId: D7-04_018
  - id: D7-04_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9AC\uCC98\uB4DC\uC758 \uC740\uD3D0\uB97C \uACF5\uAC1C\uD558\uACE0 \uB2F9\uC2E0\uC740
      \uACFC\uC2E4\uB9CC \uC778\uC815\uD55C\uB2E4. \uB300\uC2E0 \uB2E4\uB2C8\uC5D8\uC744
      \uC5B4\uB5BB\uAC8C \uBD88\uB800\uB294\uC9C0 \uC815\uD655\uD788 \uB9D0\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_013
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uD68C\uC7A5 \uC804\uC790\uC11C\uBA85\uC740 \uC624\uB798\uC804\uBD80\uD130
      \uBE44\uC11C\uC2E4\uC5D0 \uC704\uC784\uB3FC \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uCD08\uB300\uC7A5\uC744 \uBC1C\uC1A1\uD558\uACE0, \uD589\uC0AC \uACC4\uC815\uC73C\uB85C
      \uB2E4\uB2C8\uC5D8 \uD0DC\uADF8\uB97C \uC2B9\uC778\uD588\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC38\uB7EC\uC2A4\uD2B8\uC5D0\uC11C\uB294\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_015
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uADF8\uB294 \uC6D0\uBCF8\uC744 \uC694\uAD6C\uD588\uACE0, \uC800\uB294
      \uAE30\uC0AC\uB97C \uBA48\uCD94\uB77C\uACE0 \uD588\uC2B5\uB2C8\uB2E4. \uADF8\uAC00
      \uBCF4\uD638\uBA74\uC744 \uC7A1\uC544\uB2F9\uACBC\uACE0\u2026 \uC774\uD6C4\uB294
      \uB2F9\uC2E0\uC774 \uC774\uBBF8 \uC544\uB294 \uB300\uB85C\uC608\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC70\uB798\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uC790\uBC31\uB9CC
      \uAE30\uB85D\uB410\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_017
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC218\uC0AC\uB3C4 \uACB0\uAD6D \uAE30\uB9CC\uC744 \uC0AC\uC6A9\uD558\uB124\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f2224bfc67d9566429e66485e9915740, type: 2}
    effects: []
    choices: []
  - id: D7-04_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC70\uC808\uD569\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC\uC758 \uC8C4\uB294
      \uB9AC\uCC98\uB4DC\uC758 \uAC83\uC774\uACE0, \uB2E4\uB2C8\uC5D8\uC758 \uC8FD\uC74C\uC740
      \uB2F9\uC2E0\uC758 \uAC83\uC785\uB2C8\uB2E4. \uD55C\uCABD\uC744 \uB2E4\uB978
      \uCABD\uC5D0 \uC228\uAE30\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 9a8acfe7aa6474f4cbe9a106f69ee6fc, type: 2}
    effects: []
    choices: []
  - id: D7-04_019
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uADF8\uB807\uAC8C \uAE68\uB057\uD55C \uACB0\uB860\uC744 \uB0B4\uB9AC\uBA74
      \uD68C\uC0AC \uC9C1\uC6D0 \uC218\uCC9C \uBA85\uC774 \uAC12\uC744 \uCE58\uB985\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 9a8acfe7aa6474f4cbe9a106f69ee6fc, type: 2}
    effects: []
    choices: []
  - id: D7-04_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0AC\uC2E4\uC740 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC0AC\uB78C\uC774 \uBE44\uC6A9\uC744 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C
      \uB118\uAE38 \uBFD0\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 9a8acfe7aa6474f4cbe9a106f69ee6fc, type: 2}
    effects: []
    choices: []
  - id: D7-04_021
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC704\uC870 \uCD08\uB300\uC7A5 \uC0AC\uBCF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9AC\uCC98\uB4DC\uC758 \uC2E4\uC81C \uC11C\uBA85 \uD0A4, \uBE44\uC11C\uC2E4
      \uBC1C\uC1A1 \uC11C\uBC84, \uC774\uBE14\uB9B0\uC758 \uD589\uC0AC \uACC4\uC815
      \uC2B9\uC778 \uAE30\uB85D\uC774 \uD55C \uBB38\uC11C\uC5D0 \uC5F0\uACB0\uB41C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_023
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-01 \uB2E4\uB2C8\uC5D8\uC758 \uCD08\uB300\uC7A5"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_024
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB0B4\uC77C \uD638\uB77C\uC774\uC98C \uB8F8\uC5D0\uC11C \uBAA8\uB450\uB97C
      \uBAA8\uC73C\uC2DC\uACA0\uC8E0. \uADF8 \uBC29\uC774 \uB2F9\uC2E0\uC758 \uBB34\uB300\uAC00
      \uB418\uACA0\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_025
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uB2C8\uC694. \uBB34\uB300\uB294 \uC774\uBBF8 \uB2F9\uC2E0\uC774
      \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uC7A5\uCE58\uB97C \uB044\uB7EC
      \uAC11\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-04_026
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCD5C\uC885 \uC2EC\uBB38\uC774 \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uCD94\uAC00
      \uC790\uBC31\uACFC \uB3C4\uB355\uC801 \uC120\uD0DD\uC774 \uACB0\uB9D0\uC5D0
      \uBC18\uC601\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
