%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D7_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D7_03
  lines:
  - id: D7-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uAE30\uB85D\uC2E4 \uC2A4\uD53C\uCEE4\uC5D0\uC11C 15\uB144 \uC804 \uD3ED\uD48D
      \uC18C\uB9AC\uAC00 \uB04A\uC5B4\uC9C4 \uBB38\uC7A5 \uC0AC\uC774\uB85C \uBC00\uB824
      \uB098\uC654\uB2E4. \uC624\uC5B8\uC740 \uC190\uC0C1\uB41C \uC74C\uC131 \uC870\uAC01\uC744
      \uC8FC\uD30C\uC218\uBCC4\uB85C \uBD84\uB9AC\uD588\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_002
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uC138 \uCC44\uB110\uC785\uB2C8\uB2E4. \uBE0C\uB9AC\uC9C0, \uBC38\uB7EC\uC2A4\uD2B8
      \uBCC4\uC2E4, \uBE44\uC0C1 \uBB34\uC804. \uACB9\uCE5C \uAD6C\uAC04\uC744 \uC2DC\uAC04
      \uCF54\uB4DC\uB85C \uB9DE\uCD94\uBA74 \uB300\uD654\uAC00 \uBCF5\uC6D0\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_003
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC74C\uC131 \uBCF5\uC6D0 \uD37C\uC990: \uC7A1\uC74C \uC18D \uBB38\uC7A5
      \uC870\uAC01\uC744 \uC2DC\uAC04 \uCF54\uB4DC\uC640 \uD654\uC790\uBCC4\uB85C
      \uBC30\uC5F4\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_004
    speaker:
      character: {fileID: 0}
      overrideName: JULIAN_RECORD
    text: "\uBC38\uBE0C \uC751\uB2F5\uC774 \uC774\uC0C1\uD569\uB2C8\uB2E4. \uC218\uB3D9
      \uC7A0\uAE08\uC744 \uAC78\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_005
    speaker:
      character: {fileID: 0}
      overrideName: EVELYN_RECORD
    text: "\uC7A0\uAE08\uC744 \uD574\uC81C\uD558\uC138\uC694. \uBCF4\uD5D8 \uC870\uAC74\uC740
      \uC804\uC190 \uD310\uC815\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_006
    speaker:
      character: {fileID: 0}
      overrideName: JULIAN_RECORD
    text: "\uC2B9\uAC1D\uC774 \uD0D4\uC2B5\uB2C8\uB2E4. \uC774\uB300\uB85C \uBC38\uBE0C\uB97C
      \uC5F4\uBA74 \uC0AC\uACE0\uAC00 \uC544\uB2C8\uB77C \uC0B4\uC778\uC774\uC5D0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_007
    speaker:
      character: {fileID: 0}
      overrideName: EVELYN_RECORD
    text: "\uD68C\uC0AC\uB294 \uC624\uB298 \uBC24\uC744 \uB118\uAE30\uC9C0 \uBABB\uD569\uB2C8\uB2E4.
      \uD53C\uD574\uB97C \uC81C\uD55C\uD558\uB824\uBA74 \uC9C0\uAE08 \uACB0\uC815\uD574\uC57C
      \uD574\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_008
    speaker:
      character: {fileID: 0}
      overrideName: JULIAN_RECORD
    text: "\uC544\uBC84\uC9C0\uB294 \uC544\uBB34\uAC83\uB3C4 \uBAB0\uB77C\uC694.
      \uC9C0\uAE08 \uBA48\uCDB0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_009
    speaker:
      character: {fileID: 0}
      overrideName: EVELYN_RECORD
    text: "\uB2F9\uC2E0 \uC544\uBC84\uC9C0\uAC00 \uBAB0\uB790\uB2E4\uACE0 \uD574\uC11C
      \uD68C\uC0AC\uAC00 \uC0B4\uC544\uB098\uB294 \uAC74 \uC544\uB2C8\uC5D0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_010
    speaker:
      character: {fileID: 0}
      overrideName: THOMAS_RECORD
    text: "\uBC38\uB7EC\uC2A4\uD2B8 \uC218\uC704 \uAE09\uBCC0! \uB204\uAC00 \uC218\uB3D9
      \uC7A0\uAE08\uC744 \uD574\uC81C\uD588\uB098?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_011
    speaker:
      character: {fileID: 0}
      overrideName: JULIAN_RECORD
    text: "\uC774\uBE14\uB9B0 \uC1FC\uC785\uB2C8\uB2E4. \uB85C\uADF8\uB97C \uBCF4\uC874\uD558\uC138\uC694.
      \uC544\uBC84\uC9C0\uC5D0\uAC8C\u2014"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_012
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uAE30\uB85D\uC740 \uAE08\uC18D \uD30C\uC5F4\uC74C\uACFC \uD568\uAED8
      \uB04A\uACBC\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBE0C\uB9AC\uC9C0 \uCC44\uB110\uC744 \uBA3C\uC800 \uB193\uC73C\uBA74
      \uC774\uBE14\uB9B0\uC758 \uBA85\uB839\uACFC \uC904\uB9AC\uC5B8\uC758 \uBC18\uBC15
      \uC21C\uC11C\uAC00 \uB4A4\uC9D1\uD799\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\u2018\uC544\uBC84\uC9C0\uB294 \uC544\uBB34\uAC83\uB3C4 \uBAB0\uB77C\uC694\u2019\uB294
      \uC0AC\uACE0 \uB4A4\uAC00 \uC544\uB2C8\uB77C \uBC38\uBE0C \uD574\uC81C \uC9C1\uC804\uC785\uB2C8\uB2E4.
      \uB9AC\uCC98\uB4DC\uC758 \uBB34\uC9C0\uB97C \uC9C1\uC811 \uC99D\uBA85\uD558\uB294
      \uAD6C\uAC04\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF5\uC6D0 \uC644\uB8CC. \uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uBCF4\uD5D8\uC0AC\uAE30\uC640
      \uBC38\uB7EC\uC2A4\uD2B8 \uC870\uC791 \uC124\uACC4\uC790\uB294 \uC774\uBE14\uB9B0\uC774\uBA70,
      \uB9AC\uCC98\uB4DC\uB294 \uC0AC\uC804\uC5D0 \uC54C\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_016
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC904\uB9AC\uC5B8\u2026 \uB0B4\uAC00 \uB108\uB97C \uBC94\uC778\uC73C\uB85C
      \uB9CC\uB4E4\uC5C8\uAD6C\uB098."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_017
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uADF8 \uC544\uC774\uB294 \uB05D\uAE4C\uC9C0 \uBC30\uB97C \uC0B4\uB9AC\uB824
      \uD588\uC2B5\uB2C8\uB2E4. \uB0B4\uAC00 \uADF8 \uBAA9\uC18C\uB9AC\uB97C \uB354
      \uC77C\uCC0D \uBCF5\uAD6C\uD588\uC5B4\uC57C \uD588\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_018
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uC6D0\uBCF8 \uBA54\uD0C0\uB370\uC774\uD130\uB3C4 \uC774\uBE14\uB9B0\uC758
      \uC6B4\uC601 \uD0A4\uB97C \uAC00\uB9AC\uD0B5\uB2C8\uB2E4. \uC74C\uC131\uB9CC\uC774
      \uC544\uB2C8\uB77C \uBA85\uB839 \uB85C\uADF8\uB3C4 \uB9DE\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9AC\uCC98\uB4DC\uB294 \uC740\uD3D0\uC790\uC600\uC9C0\uB9CC \uC124\uACC4\uC790\uB294
      \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4. \uB450 \uC8C4\uB97C \uBD84\uB9AC\uD574\uC57C
      \uC9C4\uC2E4\uC774 \uC644\uC131\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_020
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uB0B4 \uC8C4\uB3C4 \uACF5\uAC1C\uD558\uC2DC\uC624. \uC904\uB9AC\uC5B8\uC758
      \uC774\uB984\uC744 \uB418\uCC3E\uB294 \uB370 \uD68C\uC0AC\uAC00 \uBB34\uB108\uC838\uC57C
      \uD55C\uB2E4\uBA74\u2026 \uC774\uBC88\uC5D0\uB294 \uBE44\uC6A9\uC744 \uB0B4\uAC00
      \uCE58\uB974\uACA0\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: c57a0717e8c0f2c4ead57861ba947606, type: 2}
    effects: []
    choices: []
  - id: D7-03_021
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC774\uBE14\uB9B0\uC744 \uC7A1\uC73C\uC2DC\uC624. \uB098\uBA38\uC9C0\uB294
      \uADC0\uD56D \uB4A4 \uBC95\uBB34\uD300\uACFC \uC815\uB9AC\uD558\uACA0\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_022
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uAC19\uC740 \uC2DC\uAC04 \uCF54\uB4DC\uC758 \uBE0C\uB9AC\uC9C0\uC640
      \uBC38\uB7EC\uC2A4\uD2B8 \uCC44\uB110\uC744 \uC9DD\uC9C0\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_023
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC904\uB9AC\uC5B8\uC758 \u2018\uC2B9\uAC1D\uC774 \uD0D4\uC2B5\uB2C8\uB2E4\u2019
      \uB2E4\uC74C\uC5D0 \uC774\uBE14\uB9B0\uC758 \uD68C\uC0AC \uC0DD\uC874 \uB17C\uB9AC\uAC00
      \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_024
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\u2018\uC544\uBC84\uC9C0\uB294 \uC544\uBB34\uAC83\uB3C4 \uBAB0\uB77C\uC694\u2019\uB97C
      \uBC38\uBE0C \uD574\uC81C \uC9C1\uC804 \uAD6C\uAC04\uC5D0 \uB193\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-03_025
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "C-17 \uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uC74C\uC131 \uD68D\uB4DD.
      \uACFC\uAC70 \uC0AC\uAC74\uC758 \uC124\uACC4\uC790\uC640 \uC740\uD3D0\uC790\uAC00
      \uBD84\uB9AC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
