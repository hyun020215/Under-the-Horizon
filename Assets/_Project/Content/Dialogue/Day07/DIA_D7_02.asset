%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D7_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D7_02
  lines:
  - id: D7-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC555\uC218\uB41C \uC7A5\uBE44 \uBAA9\uB85D \uC704\uC5D0 \uC0B0\uC5C5\uC6A9
      \uC804\uBA74 \uBCF4\uD638\uBA74\uC774 \uB193\uC600\uB2E4. \uAC89\uC740 \uAE68\uB057\uD588\uC9C0\uB9CC
      \uC548\uCABD \uACE0\uBB34 \uC530\uC5D0\uB294 \uC791\uC740 \uD770 \uC5BC\uB8E9\uC774
      \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_002
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uBCF4\uD638\uBA74 \uC548\uCABD\uC5D0\uC11C \uD0C0\uC561\uACFC \uD53C\uBD80\uC138\uD3EC\uB97C
      \uCC44\uCDE8\uD588\uC2B5\uB2C8\uB2E4. \uD63C\uD569 \uC2DC\uB8CC\uC608\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC14\uAE65\uC774 \uC544\uB2C8\uB77C \uC548\uCABD\uC774\uB77C\uBA74 \uCC29\uC6A9\uC790\uC640
      \uBC00\uCC29 \uC811\uCD09\uD55C \uC0AC\uB78C\uB9CC \uB0A8\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_004
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBCF4\uD638\uBA74 \uB0B4\uBD80 DNA]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC8FC \uC2DC\uB8CC\uB294 \uC774\uBE14\uB9B0, \uBBF8\uB7C9 \uC2DC\uB8CC\uB294
      \uB2E4\uB2C8\uC5D8\uACFC \uC77C\uCE58\uD55C\uB2E4. \uB2E4\uB2C8\uC5D8\uC774
      \uBCF4\uD638\uBA74\uC744 \uC7A1\uC544\uB2F9\uAE30\uAC70\uB098 \uC5BC\uAD74
      \uAC00\uAE4C\uC774\uC5D0\uC11C \uC800\uD56D\uD55C \uD754\uC801\uC774\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_006
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-16 \uBCF4\uD638\uBA74 DNA"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC190\uD1B1 \uC218\uC9C0 \uBE44\uAD50]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8 \uC190\uD1B1 \uC544\uB798 \uD22C\uBA85 \uC218\uC9C0\uC640
      \uC774\uBE14\uB9B0 \uBCF4\uD638\uBA74 \uCF54\uD305\uC758 \uBBF8\uC138 \uADE0\uC5F4
      \uD328\uD134\uC774 \uC77C\uCE58\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC190\uD1B1 \uC218\uC9C0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_010
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uB2E4\uB2C8\uC5D8\uC774 \uC0B4\uC544 \uC788\uC744 \uB54C \uAE01\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC0AC\uD6C4 \uC811\uCD09\uC73C\uB85C\uB294 \uC190\uD1B1 \uAE4A\uC219\uC774
      \uC774 \uC815\uB3C4\uAC00 \uB4E4\uC5B4\uAC00\uAE30 \uC5B4\uB824\uC6CC\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uC740 \uC9C8\uC18C \uD37C\uC9C0 \uC911 \uBCF4\uD638\uBA74\uC744
      \uC37C\uACE0, \uB2E4\uB2C8\uC5D8\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC800\uD56D\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_012
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC555\uC218 \uC601\uC7A5 \uB17C\uB9AC \uD37C\uC990: \uC5C5\uBB34 \uC7A5\uBE44
      \uC555\uC218\uC758 \uADFC\uAC70 \uC138 \uC694\uC18C\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D7-02_L1
      text: "\uAC00\uC9DC \uD654\uC7AC\uACBD\uBCF4\uAC00 \uC774\uBE14\uB9B0 \uB2E8\uB9D0\uC5D0\uC11C
        \uBC1C\uC2E0\uB428"
      conditions: []
      effects:
      - {fileID: 11400000, guid: d60d6e7f087c7f94a8a1e70c68d4f510, type: 2}
      nextLineId:
    - id: D7-02_L2
      text: "\uBCF4\uD638\uBA74 \uD30C\uD3B8\uC774 \uB2E4\uB2C8\uC5D8 \uC190\uD1B1\uC5D0\uC11C
        \uBC1C\uACAC\uB428"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 99d4f55a1d4f6cd4c9f71cf31bea49ba, type: 2}
      nextLineId:
    - id: D7-02_L3
      text: "\uC9C8\uC18C \uD37C\uC9C0\uC5D0\uB294 \uBCF4\uD638 \uC7A5\uBE44\uAC00
        \uD544\uC694\uD568"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 9aafbd04c6ab5bc4f92d3c38b6f01ae0, type: 2}
      nextLineId:
    - id: D7-02_L4
      text: "\uC774\uBE14\uB9B0\uC758 \uB9D0\uD22C\uAC00 \uC775\uBA85 \uC81C\uBCF4\uC790\uC640
        \uC720\uC0AC\uD568"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 47e07fbc85ba1eb4b8e20e153e872bfe, type: 2}
      nextLineId:
    - id: D7-02_L5
      text: "\uB9AC\uCC98\uB4DC\uAC00 \uC774\uBE14\uB9B0\uC744 \uC2E0\uB8B0\uD568"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 0ef8edff07e0c4b499429115dc330c25, type: 2}
      nextLineId:
  - id: D7-02_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E8\uB9D0 \uC5F0\uACB0, \uC7AC\uC9C8 \uC5F0\uACB0, \uC7A5\uBE44 \uD544\uC694\uC131\uC774
      \uBAA8\uB450 \uC788\uC73C\uBA74 \uC555\uC218\uB294 \uBC94\uD589 \uB3C4\uAD6C
      \uD2B9\uC815\uC5D0 \uD544\uC694\uD55C \uCD5C\uC18C \uC870\uCE58\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uCCB4 \uC720\uC0AC\uC131\uC740 \uC218\uC0AC \uBC29\uD5A5\uC5D0\uB294
      \uB3C4\uC6C0\uC774 \uB418\uC9C0\uB9CC \uC7A5\uBE44 \uC555\uC218\uC758 \uC9C1\uC811
      \uADFC\uAC70\uB85C\uB294 \uC57D\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC2E0\uB8B0 \uAD00\uACC4\uB294 \uBB3C\uC99D\uACFC \uBB34\uAD00\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_021
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC555\uC218 \uC7A5\uBE44\uC5D0\uC11C \uB2E4\uB2C8\uC5D8 DNA\uAC00 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4.
      \uC774\uBE14\uB9B0\uACFC \uD53C\uD574\uC790\uC758 \uC9C1\uC811 \uC811\uCD09\uC774
      \uBB3C\uC99D\uC73C\uB85C \uC5F0\uACB0\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_022
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uC774\uC81C \uADF8\uB140\uAC00 \uBC38\uB7EC\uC2A4\uD2B8\uC5D0 \uC5C6\uC5C8\uB2E4\uB294
      \uC8FC\uC7A5\uACFC DNA\uAC00 \uC815\uBA74\uC73C\uB85C \uCDA9\uB3CC\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uCCB4\uB294 \uC81C\uBCF4\uC790\uB97C \uAC00\uB9AC\uCF30\uACE0,
      \uAD8C\uD55C\uC740 \uC7A5\uCE58\uB97C \uAC00\uB9AC\uCF30\uACE0, DNA\uB294 \uC0B4\uD574
      \uC21C\uAC04\uC744 \uAC00\uB9AC\uD0B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_024
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uBC95\uC801 \uB17C\uB9AC\uB294 \u2018\uB204\uAC00 \uC218\uC0C1\uD55C\uAC00\u2019\uBCF4\uB2E4
      \u2018\uC65C \uC774 \uC7A5\uBE44\uB97C \uAC80\uC0AC\uD574\uC57C \uD558\uB294\uAC00\u2019\uC5D0
      \uC9D1\uC911\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_025
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC7A5\uBE44\uC640 \uBC94\uD589\uC744 \uBB3C\uB9AC\uC801\uC73C\uB85C \uC5F0\uACB0\uD558\uB294
      \uB2E8\uC11C \uB450 \uAC1C\uC640 \uD544\uC694\uC131 \uD558\uB098\uB97C \uACE0\uB974\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_026
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uAC00\uC9DC \uACBD\uBCF4 \uB2E8\uB9D0 / \uC190\uD1B1 \uC218\uC9C0 / \uC9C8\uC18C
      \uBCF4\uD638 \uD544\uC694\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D7-02_027
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCD5C\uC885 \uBB3C\uC99D C-16 \uD68D\uB4DD. \uC624\uB974\uD398\uC6B0\uC2A4
      \uD638 \uBAA8\uB4C8 \uBCF5\uC6D0 \uC791\uC5C5\uC774 \uD574\uAE08\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
