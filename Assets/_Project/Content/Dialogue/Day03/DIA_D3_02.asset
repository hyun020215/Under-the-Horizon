%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D3_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D3_02
  lines:
  - id: D3-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uB9AC\uCC98\uB4DC\uB294 \uCEE4\uD2BC\uC744 \uBAA8\uB450 \uB2EB\uC544
      \uB0AE\uC744 \uBC24\uCC98\uB7FC \uB9CC\uB4E4\uC5C8\uB2E4. \uC904\uB9AC\uC5B8\uC758
      \uC0AC\uC9C4\uB9CC \uCC45\uC0C1 \uB7A8\uD504 \uC544\uB798 \uB0A8\uC558\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_002
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uB098\uB294 \uC870\uC0AC\uAD00\uB4E4\uC5D0\uAC8C \uB3C8\uC744 \uC92C\uC18C.
      \uAE30\uB85D\uB3C4 \uC228\uACBC\uC9C0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF4\uD5D8 \uC99D\uC561\uC740 \uC0AC\uACE0 \uC804\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_004
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD68C\uC0AC\uAC00 \uBB34\uB108\uC9C8 \uC704\uAE30\uC600\uC18C. \uC0C8
      \uBCF4\uD5D8\uC740 \uC7AC\uBB34\uD300 \uC81C\uC548\uC774\uC5C8\uACE0, \uB098\uB294
      \uC2B9\uC778\uD588\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE68\uBAB0\uC744 \uC9C0\uC2DC\uD588\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_006
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC544\uB2C8\uC624. \uB098\uB294 \uB0B4 \uC544\uB4E4\uC774 \uD588\uB2E4\uACE0
      \uBBFF\uC5C8\uC18C. \uADF8\uB798\uC11C \uC8FD\uC740 \uC544\uC774\uC758 \uC8C4\uAE4C\uC9C0
      \uAC10\uCDC4\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC65C \uC904\uB9AC\uC5B8\uC774 \uD588\uB2E4\uACE0 \uBBFF\uC5C8\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_008
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC0AC\uACE0 \uC804\uB0A0 \uADF8 \uC544\uC774\uAC00 \uBC38\uB7EC\uC2A4\uD2B8
      \uBC38\uBE0C \uC774\uC0C1\uC744 \uBCF4\uACE0\uD588\uC18C. \uC0AC\uACE0 \uB4A4\uC5D0\uB294
      \uAE30\uB85D \uBAA8\uB4C8\uC774 \uC0AC\uB77C\uC84C\uACE0, \uB9C8\uC9C0\uB9C9
      \uD1B5\uC2E0\uB3C4 \uB04A\uACBC\uC9C0. \uBAA8\uB4E0 \uD654\uC0B4\uD45C\uAC00
      \uADF8 \uC544\uC774\uB97C \uAC00\uB9AC\uCF30\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD654\uC0B4\uD45C\uB97C \uB9CC\uB4E0 \uC0AC\uB78C\uC774 \uC788\uC744
      \uAC00\uB2A5\uC131\uC740 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC558\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_010
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uAC15\uACBD \uC2EC\uBB38"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_011
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uACF5\uAC10 \uC2EC\uBB38"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC740 \uC544\uB4E4\uC744 \uC758\uC2EC\uD55C \uAC8C \uC544\uB2D9\uB2C8\uB2E4.
      \uD68C\uC0AC\uB97C \uC0B4\uB9AC\uAE30 \uC704\uD574 \uAC00\uC7A5 \uB9D0\uC774
      \uC5C6\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uC8C4\uB97C \uB118\uAE34 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_013
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB9CC\uD558\uC2DC\uC624. \uD544\uC694\uD55C \uAC74 \uB2E4 \uB9D0\uD588\uC18C.
      \uAE08\uACE0 \uC598\uAE30\uB294 \uC120\uC7A5\uC5D0\uAC8C \uB4E4\uC73C\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uB4E4\uC744 \uBCF4\uD638\uD558\uB824\uACE0 \uC228\uACBC\uB2E4\uB294
      \uB9D0\uC740 \uBBFF\uACA0\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uBB34\uC5C7\uC73C\uB85C\uBD80\uD130
      \uBCF4\uD638\uD588\uB294\uC9C0 \uC2A4\uC2A4\uB85C\uB3C4 \uBAA8\uB974\uC168\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_015
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD1A0\uBA38\uC2A4\uAC00 \uC6D0\uBCF8 \uBAA8\uB4C8 \uC77C\uBD80\uB97C
      \uD68C\uC218\uD588\uC18C. \uB098\uB294 \uC5F4\uC5B4 \uBCF4\uC9C0 \uC54A\uC558\uB124.
      \uC904\uB9AC\uC5B8\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744 \uC6A9\uAE30\uAC00
      \uC5C6\uC5C8\uC5B4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_016
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uBAA8\uB4C8\uC740 \uC774 \uBC30\uC758 \uBCF4\uC548 \uAE08\uACE0\uC5D0
      \uC788\uC18C. \uC874\uC7AC\uB97C \uC544\uB294 \uAC74 \uB098, \uD1A0\uBA38\uC2A4,
      \uC774\uBE14\uB9B0\uBFD0\uC774\uC5C8\uB124."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC774 \uC228\uAE34 \uC9C4\uC2E4\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC758
      \uAC70\uC9D3\uB9D0\uC744 \uBCF4\uD638\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_018
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB807\uB2E4\uBA74 \uCC3E\uC544\uB0B4\uC2DC\uC624. \uC904\uB9AC\uC5B8\uC774
      \uD55C \uC77C\uC774 \uC544\uB2C8\uB77C\uBA74, \uB0B4\uAC00 \uBB34\uC5C7\uC744
      \uC9C0\uCF1C \uC654\uB294\uC9C0 \uC54C\uACE0 \uC2F6\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-02_019
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC790\uBC31 \uB4F1\uB85D: \uC870\uC0AC\uAD00 \uB9E4\uC218 / \uAE30\uB85D
      \uC740\uD3D0 / \uC904\uB9AC\uC5B8 \uCC45\uC784 \uC624\uD574. \uAE08\uACE0 \uC811\uADFC
      \uACBD\uB85C\uAC00 \uD574\uAE08\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
