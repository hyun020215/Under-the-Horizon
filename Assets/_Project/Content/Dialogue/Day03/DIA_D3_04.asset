%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D3_04
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D3_04
  lines:
  - id: D3-04_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uAE08\uACE0 \uBB38\uC774 \uC5F4\uB9AC\uC790 \uCC28\uAC00\uC6B4 \uACF5\uAE30\uC640
      \uC624\uB798\uB41C \uC804\uC790 \uC7A5\uBE44 \uB0C4\uC0C8\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4.
      \uC911\uC559 \uC120\uBC18\uC5D0\uB294 \uBD09\uC778 \uC2A4\uD2F0\uCEE4\uAC00
      \uC0C8\uAC83\uC778 \uB370\uC774\uD130 \uBAA8\uB4C8 \uD558\uB098\uAC00 \uB193\uC5EC
      \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_002
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC120\uC7A5 \uD0A4 \uD655\uC778. \uC81C \uBCF4\uC548 \uD0A4 \uD655\uC778.
      \uC811\uADFC \uAE30\uB85D\uC740 \uC790\uB3D9 \uC800\uC7A5\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_003
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uBAA8\uB4C8 \uBCF5\uAD6C\uB294 \uC678\uBD80 \uC5C5\uCCB4 \uC5C6\uC774
      \uC9C4\uD589\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uC190\uC0C1\uC2DC\uD0A4\uC9C0
      \uC54A\uB3C4\uB85D \uC8FC\uC758\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_004
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBD09\uC778 \uC2A4\uD2F0\uCEE4]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBD09\uC778 \uB0A0\uC9DC\uB294 \uC0AC\uACE0 \uC9C1\uD6C4\uAC00 \uC544\uB2C8\uB77C
      6\uAC1C\uC6D4 \uC804\uC774\uB2E4. \uB204\uAD70\uAC00 \uCD5C\uADFC \uBAA8\uB4C8\uC744
      \uAEBC\uB0B4 \uB2E4\uC2DC \uBD09\uC778\uD588\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_006
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCD5C\uADFC \uC7AC\uBD09\uC778"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBAA8\uB4C8 \uB370\uC774\uD130 \uB9F5]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC74C\uC131 \uBC84\uD37C \uC77C\uBD80\uAC00 \uBB34\uC791\uC704 \uB370\uC774\uD130\uB85C
      \uB36E\uC5B4\uC4F0\uAE30 \uB410\uB2E4. \uB36E\uC5B4\uC4F0\uAE30 \uC2DC\uAC01\uC740
      1\uC77C \uCC28 21:05."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uBAA8\uB4C8 \uB36E\uC5B4\uC4F0\uAE30"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_010
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC774\uC911 \uC778\uC99D \uB85C\uADF8]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21:05 \uC811\uADFC\uC5D0 \uC120\uC7A5 \uD0A4\uB294 \uC5C6\uACE0, \uBCF4\uC548
      \uCC45\uC784\uC790 \uD0A4\uC640 \uC6B4\uC601 \uAD00\uB9AC\uC790 \uB300\uCCB4
      \uC778\uC99D\uC774 \uD568\uAED8 \uC0AC\uC6A9\uB418\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_012
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-15 \uB9C8\uCEE4\uC2A4 \uC778\uC99D"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC120\uC7A5 \uD0A4 \uC5C6\uC774\uB3C4 \uC5F4\uB838\uC2B5\uB2C8\uB2E4.
      \uB300\uCCB4 \uC778\uC99D\uC774 \uC0AC\uC6A9\uB410\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_014
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uBE44\uC0C1 \uC6B4\uC601 \uADDC\uC815\uC785\uB2C8\uB2E4. \uC120\uC7A5\uC774
      \uBE0C\uB9AC\uC9C0\uC5D0\uC11C \uC774\uD0C8\uD560 \uC218 \uC5C6\uB294 \uC0C1\uD669\uC744
      \uB300\uBE44\uD55C \uC808\uCC28\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21\uC2DC 05\uBD84, \uD30C\uD2F0 \uC911\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC740 \uC0AC\uC9C4\uC5D0 \uCC0D\uD600 \uC788\uC5C8\uACE0 \uB9C8\uCEE4\uC2A4\uB294
      \uBCF4\uC548\uC2E4\uC5D0 \uC788\uC5C8\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_016
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC81C \uD0A4\uB294 \uC81C \uB2E8\uB9D0\uAE30\uC5D0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0A4\uAC00 \uC544\uB2C8\uB77C \uC778\uC99D \uD1A0\uD070\uC774 \uC0AC\uC6A9\uB410\uC2B5\uB2C8\uB2E4.
      \uB204\uAD70\uAC00 \uBE4C\uB9B4 \uC218 \uC788\uB294 \uD615\uD0DC\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_018
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uADF8\uAC74\u2026 \uC6D0\uACA9 \uC2B9\uC778\uC6A9\uC785\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uC800\uB294 \uC2B9\uC778\uD55C \uC801 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_019
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4.
      \uC9C0\uAE08\uC740 \uCD94\uCE21\uC73C\uB85C \uC9C1\uC6D0\uC758 \uACBD\uB825\uC744
      \uBE44\uC6A9\uC73C\uB85C \uC4F0\uC9C0 \uC54A\uC73C\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uBB38\uC7A5\uC744 \uC790\uC8FC \uC4F0\uC2DC\uB294\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_021
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC790\uC8FC \uC0AC\uC2E4\uC744 \uB2E4\uB8E8\uB2C8\uAE4C\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-04_022
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uB4F1\uB85D: \uC774\uC911 \uC778\uC99D / 21:05 \uC811\uADFC
      / \uBAA8\uB4C8 \uB36E\uC5B4\uC4F0\uAE30. \uB9C8\uCEE4\uC2A4 \uC2EC\uBB38 \uC555\uBC15\uB3C4\uAC00
      \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
