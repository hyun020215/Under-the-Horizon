%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D3_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D3_03
  lines:
  - id: D3-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uBE0C\uB9AC\uC9C0 \uCC3D\uBC16\uC73C\uB85C \uC218\uD3C9\uC120\uC774 \uD754\uB4E4\uB9AC\uC9C0
      \uC54A\uACE0 \uC774\uC5B4\uC84C\uB2E4. \uD1A0\uBA38\uC2A4\uB294 \uD56D\uB85C
      \uD654\uBA74\uC744 \uBCF4\uBA70 \uC9C8\uBB38\uC744 \uAE30\uB2E4\uB838\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_002
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uC6D0\uBCF8 \uBAA8\uB4C8\uC774
      \uC774 \uBC30\uC758 \uAE08\uACE0\uC5D0 \uC788\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_003
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC77C\uBD80\uC785\uB2C8\uB2E4. \uCE68\uBAB0 \uB4A4 \uD68C\uC218\uD55C
      \uD56D\uD574 \uB370\uC774\uD130\uC640 \uC74C\uC131 \uBC84\uD37C. \uC815\uC2DD
      \uC870\uC0AC\uC5D0\uB294 \uC81C\uCD9C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_004
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC65C \uC228\uACBC\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_005
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uADF8\uB54C \uB098\uB294 \uC77C\uB4F1\uD56D\uD574\uC0AC\uC600\uC2B5\uB2C8\uB2E4.
      \uB9AC\uCC98\uB4DC\uB294 \uC904\uB9AC\uC5B8\uC774 \uBC38\uBE0C\uB97C \uC5F4\uC5C8\uB2E4\uACE0
      \uBBFF\uC5C8\uACE0, \uD68C\uC0AC\uB294 \uADF8 \uC124\uBA85\uC744 \uC6D0\uD588\uC2B5\uB2C8\uB2E4.
      \uB098\uB294 \uBC18\uBC15\uD560 \uC99D\uAC70\uB97C \uB05D\uAE4C\uC9C0 \uBCF5\uAD6C\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC5D0\uAC8C \uAE08\uACE0 \uC704\uCE58\uB97C \uC54C\uB824\uC92C\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_007
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC775\uBA85\uC73C\uB85C \uD55C \uBC88. \uADF8\uAC00 \uC6D0\uBCF8\uC744
      \uC138\uC0C1\uC5D0 \uB0B4\uB193\uAE38 \uBC14\uB790\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
      \uC811\uADFC \uAD8C\uD55C\uAE4C\uC9C0 \uC8FC\uC9C0\uB294 \uC54A\uC558\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uB3C4 \uC775\uBA85 \uC81C\uBCF4\uC790\uC785\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_009
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC704\uCE58\uB9CC \uC54C\uB838\uC2B5\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC\uAC00
      \uBC94\uC778\uC774\uB77C\uACE0 \uB9D0\uD55C \uC801\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_010
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC120\uC7A5\uC744 \uACF5\uBC94\uC73C\uB85C \uC9C0\uBAA9"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_011
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC99D\uC778\uC73C\uB85C \uC124\uB4DD"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC6D0\uBCF8\uC744 \uC228\uAE30\uACE0 \uAE30\uC790\uB97C \uAE08\uACE0\uB85C
      \uC720\uB3C4\uD588\uC2B5\uB2C8\uB2E4. \uCE68\uBB35\uB3C4 \uACF5\uBC94\uC758
      \uBC29\uC2DD\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_013
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uADF8 \uB9D0\uC774 \uD2C0\uB838\uB2E4\uACE0\uB294 \uBABB \uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uB2E4\uB2C8\uC5D8\uC744 \uC8FD\uC77C \uC774\uC720\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4. \uAE08\uACE0 \uC811\uADFC\uC744 \uB3D5\uC9C0\uB3C4
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC758 \uCE68\uBB35\uC740 \uC774\uBBF8 \uD55C \uBC88 \uC9C4\uC2E4\uC744
      \uC8FD\uC600\uC2B5\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC99D\uC778\uC73C\uB85C
      \uB0A8\uC73C\uC138\uC694. \uAE08\uACE0\uB97C \uC5F4\uC5B4 \uC6D0\uBCF8 \uC0C1\uD0DC\uB97C
      \uD655\uC778\uD558\uAC8C \uD574\uC8FC\uC2ED\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_015
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC120\uC7A5 \uC778\uC99D\uC744 \uC81C\uACF5\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E8, \uBAA8\uB4C8\uC740 \uBCF5\uC0AC \uD6C4 \uC989\uC2DC \uB2E4\uC2DC \uBD09\uC778\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_016
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uAE08\uACE0\uB294 \uC774\uC911 \uC778\uC99D\uC785\uB2C8\uB2E4. \uC120\uC7A5
      \uD0A4\uC640 \uBCF4\uC548 \uCC45\uC784\uC790 \uD0A4\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9C8\uCEE4\uC2A4 \uBCA8."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_018
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uADF8\uAC00 \uAC70\uBD80\uD558\uBA74 \uC774\uBE14\uB9B0\uC758 \uC6B4\uC601
      \uAD00\uB9AC\uC790 \uAD8C\uD55C\uC774 \uB300\uCCB4 \uC778\uC99D\uC73C\uB85C
      \uC791\uB3D9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB300\uCCB4 \uAD8C\uD55C\uAE4C\uC9C0 \uC544\uB294 \uC0AC\uB78C\uC774
      \uB2E4\uB2C8\uC5D8\uC758 \uCD08\uB300\uC7A5\uC744 \uBCF4\uB0C8\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-03_020
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uAE08\uACE0 \uC811\uADFC \uACBD\uB85C\uAC00 \uC5F4\uB838\uC2B5\uB2C8\uB2E4.
      \uD1A0\uBA38\uC2A4 \uC99D\uC5B8: \uB2E4\uB2C8\uC5D8\uC5D0\uAC8C \uC704\uCE58\uB9CC
      \uC81C\uACF5."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
