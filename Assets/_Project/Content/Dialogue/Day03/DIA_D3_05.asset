%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D3_05
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D3_05
  lines:
  - id: D3-05_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uBC24\uBC14\uB2E4\uB294 \uAC80\uC740 \uC720\uB9AC\uCC98\uB7FC \uBC30
      \uC606\uC744 \uBBF8\uB044\uB7EC\uC84C\uB2E4. \uD074\uB808\uC5B4\uB294 \uB2E4\uB2C8\uC5D8\uC758
      \uBC31\uC5C5 \uCC44\uD305\uC744 \uD734\uB300 \uB2E8\uB9D0\uAE30\uB85C \uBCF5\uC6D0\uD558\uACE0
      \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_002
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC774\uB7F0 \uBB38\uCCB4 \uBD84\uC11D\uC774 \uC815\uB9D0 \uC99D\uAC70\uAC00
      \uB418\uB098\uC694? \uD68C\uC0AC \uC0AC\uB78C\uB4E4\uC740 \uB2E4 \uBE44\uC2B7\uD558\uAC8C
      \uB9D0\uD574\uC694. \uCC45\uC784, \uBE44\uC6A9, \uC808\uCC28."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E8\uC5B4 \uD558\uB098\uAC00 \uC544\uB2C8\uB77C \uB2F5\uC744 \uD53C\uD558\uB294
      \uBC29\uC2DD\uC774 \uBC18\uBCF5\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_004
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "\uD68C\uC7A5\uC740 \uADF8\uB0A0 \uBC24 \uD56D\uB85C\uB97C \uBC14\uAFB8\uAC8C
      \uD588\uC2B5\uB2C8\uB2E4. \uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744
      \uC694\uAD6C\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_005
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "\uB2F9\uC2E0\uC740 \uC6D0\uBCF8\uC744 \uBCF4\uBA74 \uAE30\uC0AC\uB97C
      \uBA48\uCD9C \uC218 \uC5C6\uC744 \uAC81\uB2C8\uB2E4. \uBE44\uC6A9\uC744 \uAC10\uB2F9\uD560
      \uC900\uBE44\uB97C \uD558\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_006
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\u2018\uBE44\uC6A9\u2019\uC774 \uC138 \uBC88. \u2018\uC815\uB9AC\u2019\uAC00
      \uB124 \uBC88. \uC9C8\uBB38\uC5D0 \uB2F5\uD560 \uB54C\uB294 \uD56D\uC0C1 \uC8FC\uC5B4\uB97C
      \uBE7C\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uB3C4 \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uB9D0\uD569\uB2C8\uB2E4.
      \uCC45\uC784\uC790\uB97C \uC9C0\uC6B0\uACE0 \uACB0\uACFC\uB9CC \uB0A8\uAE30\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uBB38\uCCB4 \uBE44\uAD50 \uCE74\uB4DC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC775\uBA85 \uC81C\uBCF4\uC640 \uC774\uBE14\uB9B0 \uBC1C\uC5B8\uC5D0\uC11C
      \u2018\uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD55C\uB2E4\u2019,
      \u2018\uAC00\uB2A5\uC131\uC744 \uC815\uB9AC\uD558\uB2E4\u2019, \uC8FC\uC5B4
      \uC0DD\uB7B5 \uD328\uD134\uC774 \uC77C\uCE58\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-14 \uBB38\uC7A5 \uC2B5\uAD00"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_011
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8\uB140\uAC00 \uB2E4\uB2C8\uC5D8\uC744 \uC720\uC778\uD588\uB2E4\uB294
      \uB73B\uC778\uAC00\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uC9C1\uC740 \uAC19\uC740 \uBB38\uC7A5\uC744 \uC4F4\uB2E4\uB294
      \uB73B\uC785\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC6B0\uC5F0\uC774 \uBC18\uBCF5\uB418\uBA74
      \uC2B5\uAD00\uC774 \uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_013
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uD0DC\uBE14\uB9BF\uC774 \uC788\uC5C8\uB2E4\uBA74
      \uC804\uCCB4 \uB300\uD654\uB97C \uBCFC \uC218 \uC788\uC744 \uD150\uB370."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC65C \uACFC\uAC70\uD615\uCC98\uB7FC \uB9D0\uD569\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_015
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8 \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC73C\uB2C8\uAE4C\uC694. \uB9D0\uAF2C\uB9AC
      \uC7A1\uC9C0 \uB9C8\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uCCB4\uB294 \uBC94\uC778\uC744 \uC99D\uBA85\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4.
      \uB2E4\uB9CC \uB204\uAD74 \uB2E4\uC74C\uC5D0 \uBCFC\uC9C0 \uC815\uD574 \uC8FC\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9D0\uAF2C\uB9AC\uB97C \uC7A1\uB294 \uAC8C \uC544\uB2D9\uB2C8\uB2E4.
      \uB2E4\uC2DC \uC5EC\uCB59\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_018
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC65C \u2018\uC788\uC5C8\uB2E4\uBA74\u2019\uC774\uB77C\uACE0 \uD558\uC168\uC2B5\uB2C8\uAE4C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_019
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC5EC\uAE30\uC11C \uBA48\uCD98\uB2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_020
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\u2026\uC774\uBE14\uB9B0\uB3C4 \uADF8\uB807\uAC8C \uB9D0\uD574\uC694.
      \uD56D\uC0C1 \uACFC\uAC70\uD615\uC73C\uB85C. \uC800\uB9CC \uADF8\uB7F0 \uAC8C
      \uC544\uB2C8\uB77C\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-05_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "C-14 \uBB38\uC7A5 \uC2B5\uAD00 \uB4F1\uB85D. \uC774\uBE14\uB9B0-\uC775\uBA85
      \uC81C\uBCF4\uC790 \uC5F0\uACB0 \uAC00\uC124\uC774 \uBCF4\uB958 \uC0C1\uD0DC\uB85C
      \uC0DD\uC131\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
