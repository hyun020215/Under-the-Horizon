%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D3_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D3_01
  lines:
  - id: D3-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "3\uC77C \uCC28 \uC624\uC804 8\uC2DC \uC815\uAC01, \uB77C\uC6B4\uC9C0\uC758
      \uBAA8\uB4E0 \uB274\uC2A4 \uD328\uB110\uC774 \uB3D9\uC2DC\uC5D0 \uB2E4\uB2C8\uC5D8\uC758
      \uC608\uC57D \uAE30\uC0AC\uB97C \uB744\uC6E0\uB2E4. \uC81C\uBAA9\uC740 \uC0AC\uB78C\uB4E4\uC758
      \uBAA9\uC18C\uB9AC\uBCF4\uB2E4 \uBA3C\uC800 \uBC30 \uC548\uC744 \uB3CC\uC558\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_002
    speaker:
      character: {fileID: 0}
      overrideName: PASSENGER_A
    text: "\uD638\uC190 \uD68C\uC7A5\uC774 \uBC30\uB97C \uCE68\uBAB0\uC2DC\uCF30\uB2E4\uACE0\uC694?
      \uADF8\uB7FC \uC6B0\uB9AC \uBC30\uB294 \uC548\uC804\uD55C \uAC81\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_003
    speaker:
      character: {fileID: 0}
      overrideName: PASSENGER_B
    text: "\uAE30\uC790\uAC00 \uC8FD\uC740 \uB2E4\uC74C \uB0A0 \uAE30\uC0AC\uAC00
      \uB098\uC654\uB2E4\uC796\uC544\uC694. \uC6B0\uC5F0\uC77C \uB9AC \uC5C6\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_004
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uAE30\uC0AC\uB97C \uB0B4\uB9AC\uC138\uC694. \uC608\uC57D \uBC1C\uD589\uC774\uACE0,
      \uC791\uC131\uC790\uB294 \uD655\uC778\uB3C4 \uBABB \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_005
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC544\uBB34\uB3C4 \uB0B4\uB9AC\uC9C0 \uB9C8\uC2DC\uC624. \uC0AD\uC81C\uD558\uBA74
      \uC720\uC8C4\uB97C \uC778\uC815\uD558\uB294 \uAF34\uC774\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_006
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uAE30\uC0AC \uACF5\uAC1C \uC815\uBCF4]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAC8C\uC2DC \uC2DC\uAC01\uC740 \uC815\uD655\uD788 08:00. \uBCF8\uBB38\uC5D0\uC11C
      \u2018\uB9AC\uCC98\uB4DC \uD638\uC190\u2019 \uC2E4\uBA85\uC774 \uD55C \uAD70\uB370
      \uC0AD\uC81C\uB418\uC5C8\uACE0, \uBE48\uCE78 \uC790\uB9AC\uC5D0 \uD3B8\uC9D1
      \uC774\uB825\uC774 \uB0A8\uC544 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_008
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uAE30\uC0AC \uACF5\uAC1C
      \uC2DC\uAC01"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0AD\uC81C\uB41C \uC2E4\uBA85\uC740 \uB204\uAC00 \uC9C0\uC6E0\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_010
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2E4\uB2C8\uC5D8 \uBCF8\uC778\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD3B8\uC9D1\uD588\uC744
      \uC218\uB3C4 \uC788\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD3B8\uC9D1 \uC2DC\uAC01\uC740 21\uC2DC 58\uBD84. \uB2E4\uB2C8\uC5D8\uC774
      \uC774\uBBF8 \uC0AC\uB9DD\uD588\uC744 \uAC00\uB2A5\uC131\uC774 \uB192\uC740
      \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_012
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8\uB7FC \uB204\uAD70\uAC00 \uD0DC\uBE14\uB9BF\uC744 \uAC16\uACE0
      \uC788\uC5C8\uACA0\uB124\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_013
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uBCA0\uC77C, \uC774 \uC18C\uBB38\uC744 \uBA48\uCD94\uC2DC\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D3-01_C1
      text: "\uACF5\uAC1C \uD574\uBA85 \uAD8C\uACE0"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 1117ea6608b1069469401355ea750ad3, type: 2}
      nextLineId: D3-01_016
    - id: D3-01_C2
      text: "\uCE68\uBB35 \uC720\uC9C0"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 81b0c7919902bce45819e34400158182, type: 2}
      nextLineId: D3-01_019
  - id: D3-01_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE68\uBB35\uD558\uBA74 \uC2B9\uAC1D\uB4E4\uC774 \uBE48\uCE78\uC744 \uCC44\uC6C1\uB2C8\uB2E4.
      \uC0AC\uC2E4\uC774 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4\uB294 \uC810,
      \uB2E4\uB2C8\uC5D8\uC758 \uC8FD\uC74C\uC774 \uC870\uC0AC \uC911\uC774\uB77C\uB294
      \uC810\uB9CC \uACF5\uAC1C\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: fdde64e5bfdb4974c8701dbebe21935b, type: 2}
    effects: []
    choices: []
  - id: D3-01_017
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC0B4\uC778\uC744 \uACF5\uAC1C\uD558\uB77C\uACE0? \uC8FC\uAC00\uBCF4\uB2E4
      \uBA3C\uC800 \uBC30\uAC00 \uBB34\uB108\uC9C8 \uAC70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: fdde64e5bfdb4974c8701dbebe21935b, type: 2}
    effects: []
    choices: []
  - id: D3-01_018
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC2B9\uAC1D \uC548\uC804 \uACF5\uC9C0\uB294 \uC81C\uAC00 \uB9E1\uACA0\uC2B5\uB2C8\uB2E4.
      \uCD94\uCE21\uC744 \uC904\uC774\uB294 \uD3B8\uC774 \uD1B5\uC81C\uC5D0 \uB0AB\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: fdde64e5bfdb4974c8701dbebe21935b, type: 2}
    effects: []
    choices: []
  - id: D3-01_019
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC9C0\uAE08\uC740 \uC99D\uAC70\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4.
      \uACF5\uC2DD \uBC1C\uD45C\uB97C \uC720\uC9C0\uD558\uB418 \uAE30\uC0AC \uC6D0\uBB38\uACFC
      \uC811\uC18D \uAE30\uB85D\uC744 \uBCF4\uC874\uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 4e59824402a3f1a4a8c7676c10d00b6f, type: 2}
    effects: []
    choices: []
  - id: D3-01_020
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8 \uC0AC\uC774 \uC2B9\uAC1D\uB4E4\uC740 \uC0BC\uCD0C\uC774 \uC0B4\uC778\uC790\uB77C\uACE0
      \uBBFF\uC744 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 4e59824402a3f1a4a8c7676c10d00b6f, type: 2}
    effects: []
    choices: []
  - id: D3-01_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC2B9\uAC1D \uBD88\uC548\uC774 \uC0C1\uC2B9\uD588\uC2B5\uB2C8\uB2E4.
      \uC77C\uBD80 \uC2B9\uAC1D \uB300\uD654\uC640 \uC81C\uD55C\uAD6C\uC5ED \uC811\uADFC
      \uB09C\uB3C4\uAC00 \uBCC0\uACBD\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 4e59824402a3f1a4a8c7676c10d00b6f, type: 2}
    effects: []
    choices: []
  - id: D3-01_022
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uAE30\uC0AC\uC5D0 \uC801\uD78C \uB9E4\uC218\uC640 \uC740\uD3D0 \uC911
      \uC77C\uBD80\uB294 \uC0AC\uC2E4\uC774\uC624. \uD558\uC9C0\uB9CC \uC0B4\uC778\uC740
      \uC544\uB2C8\uC624."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8 \uBB38\uC7A5\uC744 \uBC29\uAE08 \uB4E4\uC740 \uAC83\uC73C\uB85C
      \uD558\uC8E0. \uC0AC\uB78C\uB4E4 \uC55E\uC774 \uC544\uB2C8\uB77C \uB2F9\uC2E0
      \uBC29\uC5D0\uC11C \uB2E4\uC2DC \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D3-01_024
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC120\uB0B4 \uBD84\uC704\uAE30\uAC00 \uBCC0\uD588\uC2B5\uB2C8\uB2E4.
      \uB9AC\uCC98\uB4DC \uC2EC\uBB38 \uC8FC\uC81C \u2018\uC740\uD3D0\u2019\uAC00
      \uC5F4\uB9BD\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
