%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D5_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D5_02
  lines:
  - id: D5-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC5F0\uAE30\uAC00 \uAC77\uD788\uC790 \uAC1D\uC2E4\uC740 \uACF5\uACA9
      \uD604\uC7A5\uBCF4\uB2E4 \uBB34\uB300 \uB4A4\uD3B8\uCC98\uB7FC \uBCF4\uC600\uB2E4.
      \uAC01 \uC7A5\uCE58\uB294 \uC815\uD574\uC9C4 \uC2DC\uAC04\uC5D0 \uC6C0\uC9C1\uC600\uACE0,
      \uC0AC\uB78C\uB9CC \uADF8 \uC2DC\uAC04\uC744 \uC124\uBA85\uD558\uC9C0 \uBABB\uD588\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_002
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC11C\uBE44\uC2A4 \uB85C\uBD07 \uC801\uC7AC\uD568]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC801\uC7AC\uD568 \uC548\uCABD\uC5D0 \uBB3C\uBC29\uC6B8\uACFC \uB4DC\uB77C\uC774\uC544\uC774\uC2A4
      \uD3EC\uC7A5 \uC870\uAC01\uC774 \uB0A8\uC544 \uC788\uB2E4. 08:56 \uAC1D\uC2E4
      \uC55E \uBC30\uC1A1 \uAE30\uB85D\uC774 \uC0AD\uC81C\uB418\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_004
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uB85C\uBD07 \uC801\uC7AC\uD568"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_005
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB4DC\uB77C\uC774\uC544\uC774\uC2A4 \uD329]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_006
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD638\uD154 \uBC14\uC5D0\uC11C \uC0AC\uC6A9\uD558\uB294 \uB0C9\uAC01
      \uD329. \uD074\uB808\uC5B4\uC758 \uAC1D\uC2E4 \uBBF8\uB2C8\uBC14 \uC8FC\uBB38
      \uAE30\uB85D\uC5D0\uB294 \uC5C6\uC9C0\uB9CC \uD589\uC0AC \uCC3D\uACE0 \uC7AC\uACE0\uAC00
      \uD558\uB098 \uBD80\uC871\uD558\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_007
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uB4DC\uB77C\uC774\uC544\uC774\uC2A4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_008
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC228\uACA8\uC9C4 \uD0DC\uBE14\uB9BF]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE68\uB300 \uD558\uBD80 \uD328\uB110 \uB4A4\uC5D0 \uB2E4\uB2C8\uC5D8\uC758
      \uD0DC\uBE14\uB9BF\uC774 \uC788\uB2E4. \uD074\uB808\uC5B4\uC758 \uC9C0\uBB38\uACFC
      \uCD5C\uADFC \uAE30\uC0AC \uD3B8\uC9D1 \uAE30\uB85D\uC774 \uB0A8\uC544 \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_010
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uB2E4\uB2C8\uC5D8
      \uD0DC\uBE14\uB9BF"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE74\uBA54\uB77C\uC5D0\uB294 \uCE68\uC785\uC790\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uCCAB \uC0AC\uAC74\uACFC \uAC19\uC544 \uBCF4\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_012
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8\uB7FC \uADF8 \uC0AC\uB78C\uC774 \uB610 \uC628 \uAC70\uC608\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC544\uB2C8\uC694. \uC774\uBC88\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC624\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC744 \uD3EC\uD568\uD574\uC11C\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_014
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uBB34\uC2A8 \uB73B\uC774\uC8E0? \uC800\uB294 \uBC29 \uC548\uC5D0 \uC788\uC5C8\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC11C\uBE44\uC2A4 \uB85C\uBD07\uC774 \uC5F0\uB9C9\uC7A5\uCE58\uB97C \uC62E\uAE30\uACE0,
      \uC790\uB3D9\uCEE4\uD2BC\uC774 \uC4F0\uB7EC\uC9C0\uB294 \uADF8\uB9BC\uC790\uB97C
      \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740 \uC815\uD574\uC9C4
      \uC2DC\uAC01\uC5D0 \uBC14\uB2E5\uC5D0 \uB204\uC6E0\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_016
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC99D\uAC70\uAC00 \uC788\uB098\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D5-02_C1
      text: "\u2018\uCE68\uC785\uC790\uAC00 \uC5C6\uB2E4\u2019\uB294 \uCD9C\uC785
        \uB85C\uADF8 \uC81C\uC2DC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: d0d3ef1395fd9f343b2566c3f2e97372, type: 2}
      nextLineId: D5-02_020
    - id: D5-02_C2
      text: "\u2018\uCEE4\uD2BC\uC774 \uC2A4\uC2A4\uB85C \uC4F0\uB7EC\uC84C\uB2E4\u2019\uB294
        \uBAA8\uD130 \uB85C\uADF8 \uC81C\uC2DC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: ee1bc985d8a07dc40bb65879e014e878, type: 2}
      nextLineId: D5-02_023
    - id: D5-02_C3
      text: "\u2018\uC5F0\uAE30\uB294 \uD654\uC7AC\uAC00 \uC544\uB2C8\uB2E4\u2019\uB294
        \uB4DC\uB77C\uC774\uC544\uC774\uC2A4 \uC81C\uC2DC"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 2ea5911c976bdff48b8e4c5af161aec8, type: 2}
      nextLineId: D5-02_026
  - id: D5-02_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC678\uBD80 \uCD9C\uC785\uC740 0\uD68C\uC785\uB2C8\uB2E4. \uB2F9\uC2E0\uC774
      \uB9D0\uD55C \uAC80\uC740 \uC0AC\uB78C\uC740 \uBB38\uC744 \uD1B5\uACFC\uD558\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 38e5e7aebbb329e49a8db95fa107c0ac, type: 2}
    effects: []
    choices: []
  - id: D5-02_021
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uCC3D\uBB38\uC73C\uB85C \uB4E4\uC5B4\uC654\uC744 \uC218\uB3C4 \uC788\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 38e5e7aebbb329e49a8db95fa107c0ac, type: 2}
    effects: []
    choices: []
  - id: D5-02_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCC3D\uBB38 \uC13C\uC11C\uB3C4 \uB2EB\uD78C \uCC44\uC785\uB2C8\uB2E4.
      \uCCAB \uBC88\uC9F8 \uAC70\uC9D3\uB9D0\uC774\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 38e5e7aebbb329e49a8db95fa107c0ac, type: 2}
    effects: []
    choices: []
  - id: D5-02_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCEE4\uD2BC \uBAA8\uD130\uB294 08\uC2DC 58\uBD84 \uC608\uC57D \uC791\uB3D9\uC785\uB2C8\uB2E4.
      \uADF8\uB9BC\uC790\uB294 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uC4F0\uB7EC\uC9C4
      \uCC9C\uC774 \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: e9a6817809f020d4a935c21b97153f23, type: 2}
    effects: []
    choices: []
  - id: D5-02_024
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB204\uAD70\uAC00 \uBC16\uC5D0\uC11C \uC608\uC57D\uD588\uC744 \uC218
      \uC788\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: e9a6817809f020d4a935c21b97153f23, type: 2}
    effects: []
    choices: []
  - id: D5-02_025
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC608\uC57D \uACC4\uC815\uC740 \uAC1D\uC2E4 \uD0DC\uBE14\uB9BF\uC785\uB2C8\uB2E4.
      \uB450 \uBC88\uC9F8 \uAC70\uC9D3\uB9D0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: e9a6817809f020d4a935c21b97153f23, type: 2}
    effects: []
    choices: []
  - id: D5-02_026
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC5F0\uAE30\uB294 \uCC28\uAC11\uACE0 \uADF8\uC744\uC74C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB4DC\uB77C\uC774\uC544\uC774\uC2A4\uB97C \uB85C\uBD07\uC774 \uBC30\uB2EC\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 32fd271c2524016489394ec5ded2654b, type: 2}
    effects: []
    choices: []
  - id: D5-02_027
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uBC14\uC5D0\uC11C \uC2E4\uC218\uB85C \uBCF4\uB0C8\uC744 \uC218\uB3C4\u2014"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 32fd271c2524016489394ec5ded2654b, type: 2}
    effects: []
    choices: []
  - id: D5-02_028
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC30\uC1A1 \uAE30\uB85D\uC744 \uC0AD\uC81C\uD55C \uACC4\uC815\uC740
      \uB2F9\uC2E0 \uAC83\uC785\uB2C8\uB2E4. \uC138 \uBC88\uC9F8 \uAC70\uC9D3\uB9D0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 32fd271c2524016489394ec5ded2654b, type: 2}
    effects: []
    choices: []
  - id: D5-02_029
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\u2026\uD0DC\uBE14\uB9BF\uB9CC \uB3CC\uB824\uC8FC\uBA74 \uB418\uB294 \uAC70\uC8E0?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_030
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0DC\uBE14\uB9BF\uC740 \uB2E4\uB2C8\uC5D8\uC758 \uC18C\uC720\uBB3C\uC785\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC774 \uB3CC\uB824\uC8FC\uB294 \uAC8C \uC544\uB2C8\uB77C \uC81C\uAC00
      \uD68C\uC218\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_031
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB9BC\uC790\uC758 \uBAA8\uC591\uB9CC\uC73C\uB85C\uB294 \uC0AC\uB78C\uC774
      \uC788\uC5C8\uB2E4\uACE0 \uC99D\uBA85\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC7A5\uCE58\uC758 \uC2DC\uAC04 \uAE30\uB85D\uC744 \uBCF4\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_032
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE68\uC785\uC790\uB294 \uC5C6\uC5C8\uACE0, \uC7A5\uCE58\uB4E4\uC774
      \uCE68\uC785 \uC7A5\uBA74\uC744 \uC644\uC131\uD588\uC2B5\uB2C8\uB2E4. \uC774
      \uBC29\uC740 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uC608\uC57D \uBA85\uB839\uC5D0
      \uC758\uD574 \u2018\uACF5\uACA9\uB2F9\uD588\uC2B5\uB2C8\uB2E4\u2019."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_033
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uD074\uB808\uC5B4\uC758 \uB9D0 \uC911 \uBB3C\uB9AC \uAE30\uB85D\uACFC
      \uC9C1\uC811 \uCDA9\uB3CC\uD558\uB294 \uBB38\uC7A5\uC744 \uACE0\uB974\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_034
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uCD9C\uC785 \uB85C\uADF8, \uCEE4\uD2BC \uBAA8\uD130, \uC5F0\uAE30 \uC131\uBD84\uC740
      \uAC01\uAC01 \uB2E4\uB978 \uAC70\uC9D3\uB9D0\uC744 \uBC18\uBC15\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-02_035
    speaker:
      character: {fileID: 0}
      overrideName: UI_HINT
    text: "\uC138 \uB2E8\uC11C \uC911 \uB450 \uAC1C\uB9CC \uC81C\uC2DC\uD574\uB3C4
      \uC790\uC791\uADF9\uC774 \uD655\uC815\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
