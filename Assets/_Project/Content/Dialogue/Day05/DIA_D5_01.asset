%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D5_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D5_01
  lines:
  - id: D5-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uAC1D\uC2E4 \uBB38\uC774 \uC5F4\uB9AC\uC790 \uD558\uC580 \uC5F0\uAE30\uAC00
      \uBCF5\uB3C4\uB85C \uBC00\uB824 \uB098\uC654\uB2E4. \uC790\uB3D9\uCEE4\uD2BC\uC740
      \uBC14\uB2E5\uC5D0 \uC4F0\uB7EC\uC838 \uC0AC\uB78C \uD615\uC0C1\uC758 \uADF8\uB9BC\uC790\uB97C
      \uB9CC\uB4E4\uACE0 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_002
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC5EC\uAE30\uC694! \uB204\uAC00 \uBC29 \uC548\uC5D0 \uC788\uC5B4\uC694!"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCC3D\uAC00\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uC138\uC694. \uD5EC\uB808\uB098\uB97C
      \uBD80\uB974\uACE0 \uBCF5\uB3C4 \uCD9C\uC785\uC744 \uB9C9\uC73C\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_004
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uAC80\uC740 \uADF8\uB9BC\uC790\uAC00 \uCEE4\uD2BC \uB4A4\uB85C \uAC14\uC5B4\uC694.
      \uBB38\uC740 \uC7A0\uACA8 \uC788\uC5C8\uB294\uB370\u2014"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBB38\uC740 \uC9C0\uAE08 \uC548\uC5D0\uC11C \uC5F4\uB838\uC2B5\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC774 \uC5F4\uC5C8\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_006
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC815\uC2E0\uC744 \uCC28\uB9AC\uACE0 \uBCF4\uB2C8 \uBC14\uB2E5\uC5D0
      \uC788\uC5C8\uC5B4\uC694. \uC190\uC7A1\uC774\uB97C \uC7A1\uC740 \uAE30\uC5B5\uC740
      \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_007
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uCD9C\uC785 \uC601\uC0C1]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "08:42 \uC774\uD6C4 \uAC1D\uC2E4 \uBB38\uC744 \uD1B5\uACFC\uD55C \uC0AC\uB78C\uC740
      \uC5C6\uB2E4. \uD074\uB808\uC5B4\uB294 08:50\uC5D0 \uB4E4\uC5B4\uAC04 \uB4A4
      09:00 \uAD6C\uC870 \uC2DC\uC810\uAE4C\uC9C0 \uC548\uC5D0 \uC788\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uCD9C\uC785 \uC601\uC0C1
      \uC5C6\uC74C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_010
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC790\uB3D9\uCEE4\uD2BC \uBAA8\uD130]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "08:58\uC5D0 \uC608\uC57D \uC791\uB3D9. \uCEE4\uD2BC\uC740 \uC815\uC0C1\uC801\uC73C\uB85C
      \uC5F4\uB9AC\uB294 \uB300\uC2E0 \uD558\uB2E8 \uACE0\uC815\uD540\uC774 \uD480\uB824
      \uC55E\uC73C\uB85C \uC4F0\uB7EC\uC9C0\uB3C4\uB85D \uC124\uC815\uB3FC \uC788\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_012
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC790\uB3D9\uCEE4\uD2BC
      \uC791\uB3D9"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_013
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC5F0\uAE30 \uC785\uC790]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0C0\uB294 \uB0C4\uC0C8\uAC00 \uC5C6\uACE0 \uC628\uB3C4\uAC00 \uB0AE\uB2E4.
      \uD654\uC7AC \uC5F0\uAE30\uAC00 \uC544\uB2C8\uB77C \uB4DC\uB77C\uC774\uC544\uC774\uC2A4
      \uACC4\uC5F4 \uC548\uAC1C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_015
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: \uBCF4\uC870 \uB2E8\uC11C: \uC800\uC628 \uC5F0\uB9C9"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_016
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uAC1D\uC2E4 \uC7A0\uAE08 \uB85C\uADF8\uB3C4 \uC678\uBD80 \uC811\uADFC\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB9C8\uC2A4\uD130\uD0A4 \uC0AC\uC6A9 \uAE30\uB85D\uB3C4
      \uC5C6\uACE0\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_017
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uCCAB \uC0AC\uAC74\uACFC \uAC19\uC796\uC544\uC694. \uC544\uBB34\uB3C4
      \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC558\uB294\uB370 \uB204\uAD70\uAC00 \uACF5\uACA9\uD55C
      \uAC70\uC608\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCCAB \uC0AC\uAC74\uACFC \uB2EE\uAC8C \uBCF4\uC774\uB3C4\uB85D \uB9CC\uB4E0
      \uAC83\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_019
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uD604\uC7A5\uC744 \uC989\uC2DC \uBD09\uC1C4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBC88\uC5D0\uB294 \uBA3C\uC800 \uBD09\uC1C4\uD569\uB2C8\uB2E4.
      \uD074\uB808\uC5B4\uB3C4 \uBC29 \uBC16\uC73C\uB85C \uB098\uAC00\uC9C0 \uB9C8\uC138\uC694.
      \uD53C\uD574\uC790\uC774\uB4E0 \uC5F0\uCD9C\uC790\uC774\uB4E0 \uD604\uC7A5\uC758
      \uC77C\uBD80\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_021
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC5F0\uCD9C\uC790\uB77C\uB2C8, \uC9C0\uAE08 \uC800\uB97C \uC758\uC2EC\uD558\uB294
      \uAC70\uC608\uC694?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC758\uC2EC\uC740 \uC21C\uC11C\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. \uD655\uC778\uC5D0\uB294
      \uC21C\uC11C\uAC00 \uC788\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_023
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCE68\uC785\uC790\uB294 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB807\uB2E4\uBA74
      \uACF5\uACA9\uC790\uB97C \uCC3E\uB294 \uB300\uC2E0, \uACF5\uACA9 \uC7A5\uBA74\uC744
      \uB9CC\uB4E0 \uC7A5\uCE58\uB97C \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-01_024
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uBC18\uBCF5 \uBC00\uC2E4 \uAC00\uC124 \uB4F1\uB85D. \uC11C\uBE44\uC2A4
      \uB85C\uBD07\uACFC \uC790\uB3D9\uC7A5\uCE58 \uC870\uC0AC\uAC00 \uD574\uAE08\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
