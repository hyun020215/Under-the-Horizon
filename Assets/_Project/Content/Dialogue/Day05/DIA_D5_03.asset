%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D5_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D5_03
  lines:
  - id: D5-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD074\uB808\uC5B4\uB294 \uC2EC\uBB38\uC2E4 \uC758\uC790\uC5D0 \uC549\uC544
      \uC190\uBAA9\uC758 \uBE44\uC2FC \uC2DC\uACC4\uB97C \uD14C\uC774\uBE14 \uC704\uC5D0
      \uB0B4\uB824\uB193\uC558\uB2E4. \uCC98\uC74C\uC73C\uB85C \uC2DC\uAC04\uC744
      \uBCF4\uC9C0 \uC54A\uACA0\uB2E4\uB294 \uD0DC\uB3C4\uC600\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_002
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uB2E4\uB2C8\uC5D8\uC774 \uAC00\uC9C4 \uBE44\uC790\uAE08 \uC790\uB8CC\uB97C
      \uD68C\uC218\uD558\uB824\uACE0 \uD0DC\uBE14\uB9BF\uC744 \uAC00\uC838\uAC14\uC5B4\uC694.
      \uC0B4\uC778\uACFC\uB294 \uAD00\uACC4\uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "21\uC2DC 58\uBD84 \uAE30\uC0AC\uC5D0\uC11C \uB9AC\uCC98\uB4DC\uC758 \uC774\uB984\uC744
      \uC9C0\uC6B4 \uAC83\uB3C4 \uB2F9\uC2E0\uC774\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_004
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC0BC\uCD0C\uC744 \uC9C0\uD0A4\uB824\uB358 \uAC8C \uC544\uB2C8\uB77C
      \uD68C\uC0AC\uB97C \uC9C0\uD0A4\uB824\uB358 \uAC70\uC608\uC694. \uADF8 \uCC28\uC774\uB97C
      \uB2F9\uC2E0\uC740 \uC774\uD574 \uBABB \uD558\uACA0\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uB3C4 \uAC19\uC740 \uB9D0\uC744 \uD569\uB2C8\uB2E4.
      \uBE44\uC6A9\uACFC \uD68C\uC0AC\uB97C \uC0AC\uB78C\uBCF4\uB2E4 \uBA3C\uC800
      \uB193\uB294 \uBC29\uC2DD\uAE4C\uC9C0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_006
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uC775\uBA85 \uC81C\uBCF4 \uC804\uCCB4 \uB300\uD654]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC81C\uBCF4\uC790\uB294 \uB2E4\uB2C8\uC5D8\uC5D0\uAC8C \uB9AC\uCC98\uB4DC\uC758
      \uC740\uD3D0 \uC790\uB8CC\uB97C \uC21C\uCC28\uC801\uC73C\uB85C \uC8FC\uACE0,
      \u2018\uC6D0\uBCF8\uC740 \uC120\uC0C1\uD30C\uD2F0 \uC911 \uBC38\uB7EC\uC2A4\uD2B8
      \uC778\uADFC\uC5D0\uC11C \uC804\uB2EC\uD55C\uB2E4\u2019\uACE0 \uC720\uC778\uD588\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_008
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-13 \uC775\uBA85 \uCC44\uD305"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_009
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "21:20 \uC11C\uBE44\uC2A4 \uACC4\uB2E8\uC73C\uB85C \uB0B4\uB824\uC624\uC138\uC694.
      \uD68C\uC7A5 \uACC4\uC815\uC73C\uB85C \uC784\uC2DC \uCD9C\uC785 \uC2B9\uC778\uC744
      \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_010
    speaker:
      character: {fileID: 0}
      overrideName: DANIEL_CHAT
    text: "\uC65C \uD638\uB77C\uC774\uC98C \uB8F8\uC774 \uC544\uB2C8\uB77C 7\uCE35\uC785\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_011
    speaker:
      character: {fileID: 0}
      overrideName: ANON_CHAT
    text: "\uC6D0\uBCF8\uC740 \uC774\uB3D9\uC2DD \uBCF4\uAD00\uD568\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.
      \uC0AC\uC2E4\uC740 \uC5B8\uC81C\uB098 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4.
      \uD63C\uC790 \uC624\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_012
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC740 \uB9AC\uCC98\uB4DC\uB97C \uB9CC\uB098\uB7EC \uAC04
      \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uC81C\uBCF4\uC790\uAC00 \uC6D0\uBCF8\uC744
      \uC900\uB2E4\uACE0 \uD574\uC11C \uBC38\uB7EC\uC2A4\uD2B8 \uCABD\uC73C\uB85C
      \uB0B4\uB824\uAC14\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_013
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uADF8\uB9AC\uACE0 \uB098\uC911\uC5D0 \uB9AC\uCC98\uB4DC \uBA85\uC758\uB85C
      \uD638\uB77C\uC774\uC98C \uB8F8\uC5D0 \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0C8\uC8E0.
      \uC2DC\uC2E0 \uBC1C\uACAC\uC790\uB97C \uC0BC\uCD0C\uC73C\uB85C \uB9CC\uB4E4\uB824\uACE0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D5-03_C1
      text: "\uBA74\uCC45 \uAC70\uB798"
      conditions: []
      effects:
      - {fileID: 11400000, guid: b9edf4865030f1b45b814230b69be2c0, type: 2}
      nextLineId: D5-03_016
    - id: D5-03_C2
      text: "\uC804\uBA74 \uD3ED\uB85C"
      conditions: []
      effects:
      - {fileID: 11400000, guid: a90008a5418469546af46c9e4f310c7b, type: 2}
      nextLineId: D5-03_018
  - id: D5-03_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD0DC\uBE14\uB9BF \uC808\uB3C4\uC640 \uC790\uC791\uADF9\uC744 \uBAA8\uB450
      \uC9C4\uC220\uD558\uACE0 \uBC31\uC5C5 \uD0A4\uB97C \uC81C\uACF5\uD558\uC138\uC694.
      \uC0B4\uC778 \uC218\uC0AC \uD611\uC870 \uC0AC\uC2E4\uC740 \uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f78c2c8ca378b0f40a6414ea073e1d69, type: 2}
    effects: []
    choices: []
  - id: D5-03_017
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uBE44\uC790\uAE08 \uC790\uB8CC \uACF5\uAC1C \uBC94\uC704\uB294 \uBC95\uBB34\uD300\uACFC
      \uD611\uC758\uD558\uAC8C \uD574\uC8FC\uC138\uC694. \uB300\uC2E0 \uC554\uD638
      \uD0A4\uC640 \uD3B8\uC9D1 \uAE30\uB85D\uC744 \uC804\uBD80 \uB118\uAE30\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: f78c2c8ca378b0f40a6414ea073e1d69, type: 2}
    effects: []
    choices: []
  - id: D5-03_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC758 \uC808\uB3C4\uC640 \uC790\uC791\uADF9, \uBE44\uC790\uAE08
      \uC740\uD3D0\uB97C \uBAA8\uB450 \uC120\uC7A5\uACFC \uB2F9\uAD6D\uC5D0 \uBCF4\uACE0\uD569\uB2C8\uB2E4.
      \uD611\uC870\uB294 \uAC10\uACBD \uC0AC\uC720\uC77C \uBFD0 \uAC70\uB798\uAC00
      \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 85e4319f1b0f5ee4a8846854d4d0898b, type: 2}
    effects: []
    choices: []
  - id: D5-03_019
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC815\uC758\uB97C \uC6D0\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C \uC644\uBCBD\uD55C
      \uBCF4\uACE0\uC11C\uB97C \uC6D0\uD558\uB294 \uAC70\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 85e4319f1b0f5ee4a8846854d4d0898b, type: 2}
    effects: []
    choices: []
  - id: D5-03_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC775\uBA85 \uC81C\uBCF4\uC758 \uBAA9\uC801\uC740 \uC815\uBCF4\uB97C
      \uC8FC\uB294 \uAC8C \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uB2C8\uC5D8\uC758
      \uC624\uD574\uB97C \uC815\uD655\uD55C \uBC29\uD5A5\uC73C\uB85C \uBC00\uC5B4\uBD99\uC5EC,
      \uC815\uD574\uC9C4 \uC7A5\uC18C\uC640 \uC2DC\uAC04\uC5D0 \uB370\uB824\uAC00\uB294
      \uAC83\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D5-03_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "C-13 \uC775\uBA85 \uCC44\uD305 \uC644\uC804 \uD68D\uB4DD. \u2018\uB2E4\uB2C8\uC5D8\uC758
      \uB9AC\uCC98\uB4DC \uC624\uD574\uB97C \uC774\uC6A9\uD55C \uC720\uC778\u2019\uC774
      \uD655\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
