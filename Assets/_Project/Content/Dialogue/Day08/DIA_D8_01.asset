      overrideName: CLAIRE
    text: "\uC804\uCCB4 \uCC44\uD305\uC5D0\uB294 \uB9AC\uCC98\uB4DC\uB97C \uAC00\uB9AC\uD0A4\uB294
      \uC790\uB8CC\uB9CC \uC788\uACE0, \uBA85\uB839 \uC8FC\uCCB4\uB97C \uBB3B\uB294
      \uC9C8\uBB38\uC5D0\uB294 \uB2F5\uC774 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
