      overrideName: ADRIAN
    text: "\uC2DC\uC2E0\uC740 \uAC80\uC740 \uC6B4\uBC18\uBC31\uC5D0 \uACE0\uC815\uB418\uC5B4
      \uCC9C\uC7A5 \uD654\uBB3C \uB808\uC77C\uB85C \uC774\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
