    choices: []
  - id: D8-01_045
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uAE30\uB3C4\uC5D0 \uBB3C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC138\uBA74\uB300\uB294
      \uD604\uC7A5 \uC5F0\uCD9C \uC7A5\uCE58\uC600\uC5B4\uC694."
