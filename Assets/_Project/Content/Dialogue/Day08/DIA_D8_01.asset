%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D8_01
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D8_01
  lines:
  - id: D8-01_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uD638\uB77C\uC774\uC98C \uB8F8\uC758 \uAC00\uAD6C\uB294 \uC0AC\uAC74
      \uB2F9\uC2DC \uC704\uCE58\uB85C \uB3CC\uC544\uAC00 \uC788\uC5C8\uB2E4. \uCC9C\uC7A5
      \uD328\uB110\uC740 \uC5F4\uB9B0 \uCC44\uC600\uACE0, \uC138\uBA74\uB300\uB294
      \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBC29\uC774 \uC544\uBB34\uAC83\uB3C4
      \uC228\uAE30\uC9C0 \uC54A\uC558\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_002
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC804\uC6D0 \uCC38\uC11D\uD588\uC2B5\uB2C8\uB2E4. \uC774 \uC790\uB9AC\uC758
      \uAE30\uB85D\uC740 \uADC0\uD56D \uC989\uC2DC \uB2F9\uAD6D\uC5D0 \uC804\uB2EC\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_003
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uC2DC\uC791\uD558\uC2DC\uC624, \uBCA0\uC77C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_004
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774 \uBC29\uC740 \uC7A0\uACA8 \uC788\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uADF8\uB7F0\uB370\uB3C4 \uBC00\uC2E4\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC678\uBCBD\uC73C\uB85C \uB098\uAC14\uB2E4\uBA74 \uBB3C\uC774, \uB355\uD2B8\uB85C
      \uB098\uAC14\uB2E4\uBA74 \uBA3C\uC9C0\uAC00, \uC810\uAC80\uAD6C\uB85C \uB098\uAC14\uB2E4\uBA74
      \uBD09\uC778 \uC790\uAD6D\uC774 \uB0A8\uC544\uC57C \uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_006
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uADF8\uB798\uC11C\uC694? \uD754\uC801\uC744 \uBABB \uCC3E\uC558\uB2E4\uB294
      \uAC83\uC774 \uC99D\uAC70\uB294 \uC544\uB2C8\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uCC3E\uC9C0 \uBABB\uD55C \uAC8C \uC544\uB2D9\uB2C8\uB2E4.
      \uCC98\uC74C\uBD80\uD130 \uC0DD\uAE38 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_008
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC94\uC778\uC740 \uC774 \uBC29\uC5D0 \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC558\uC73C\uB2C8\uAE4C\uC694.
      \uB4E4\uC5B4\uC628 \uAC83\uC740 \uB2E4\uB2C8\uC5D8\uC758 \uC2DC\uC2E0\uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_009
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCD5C\uC885 \uB17C\uC99D 1/6: \uB2E4\uB2C8\uC5D8 \uBA38\uC11C\uB97C \uC0B4\uD574\uD55C
      \uC0AC\uB78C\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_010
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC774\uBE14\uB9B0 \uC1FC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_011
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uB9AC\uCC98\uB4DC \uD638\uC190"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_012
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uD074\uB808\uC5B4 \uD638\uC190"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_013
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uB9C8\uCEE4\uC2A4 \uBCA8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_014
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBC94\uC778\uC740 \uC774\uBE14\uB9B0 \uC1FC\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_015
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uBB38\uCCB4\uC640 \uAD8C\uD55C\uB9CC\uC73C\uB85C \uC0AC\uB78C\uC744 \uC0B4\uC778\uC790\uB77C\uACE0
      \uBD80\uB974\uB294\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_016
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9AC\uCC98\uB4DC \uD638\uC190\uC744 \uC9C0\uBAA9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_017
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uAC00\uC7A5 \uD3B8\uB9AC\uD55C \uACB0\uB860\uC774\uB124\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_018
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD074\uB808\uC5B4 \uD638\uC190\uC744 \uC9C0\uBAA9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_019
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uD0DC\uBE14\uB9BF\uC740 \uD6D4\uCCE4\uC9C0\uB9CC \uB2E4\uB2C8\uC5D8\uC744
      \uC8FD\uC774\uC9C0\uB294 \uC54A\uC558\uC5B4\uC694. \uB0B4 \uC790\uC791\uADF9\uC758
      \uC7A5\uCE58 \uAE30\uB85D\uC774 \uC624\uD788\uB824 \uADF8\uAC78 \uC99D\uBA85\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB9C8\uCEE4\uC2A4 \uBCA8\uC744 \uC9C0\uBAA9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_021
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uD1A0\uD070\uC744 \uBE4C\uB824\uC900 \uAC74 \uC778\uC815\uD569\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uBCF4\uD638\uBA74 DNA\uB3C4, \uC775\uBA85 \uCC44\uD305\uB3C4
      \uC81C \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_022
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCD5C\uC885 \uB17C\uC99D 2/6: \uC2E4\uC81C \uC0B4\uD574 \uC7A5\uC18C\uB97C
      \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_023
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uBC38\uB7EC\uC2A4\uD2B8 \uC81C\uC5B4 \uBCC4\uC2E4"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_024
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uD638\uB77C\uC774\uC98C \uB8F8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_025
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uBCF4\uC548 \uAE08\uACE0"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_026
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "7\uCE35 \uC11C\uBE44\uC2A4 \uAD6C\uC5ED \uACC4\uB2E8"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_027
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2E4\uB2C8\uC5D8\uC774 \uC0B4\uD574\uB41C \uACF3\uC740 7\uCE35 \uBC38\uB7EC\uC2A4\uD2B8
      \uC81C\uC5B4 \uBCC4\uC2E4\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_028
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uAD6C\uB450 \uBC11\uCC3D \uACE0\uBB34, \uC138\uCC99\uB41C \uD608\uD754,
      \uC9C8\uC18C \uB85C\uADF8\uAC00 \uBAA8\uB450 \uADF8 \uC7A5\uC18C\uB97C \uAC00\uB9AC\uD0B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_029
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD638\uB77C\uC774\uC98C \uB8F8\uC774 \uC2E4\uC81C \uC0B4\uD574 \uC7A5\uC18C\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_030
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uD608\uD754 \uC911\uC2EC\uACFC \uC0AC\uB9DD \uC2DC\uAC01\uC774 \uB9DE\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC2DC\uC2E0\uC740 \uC5EC\uAE30\uC11C \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_031
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uBCF4\uC548 \uAE08\uACE0\uAC00 \uC0B4\uD574 \uC7A5\uC18C\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_032
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uAE08\uACE0\uB294 \uBAA8\uB4C8 \uD6FC\uC190 \uC7A5\uC18C\uC77C \uBFD0\uC785\uB2C8\uB2E4.
      \uB2E4\uB2C8\uC5D8\uC758 \uCD9C\uC785 \uAE30\uB85D\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_033
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "7\uCE35 \uC11C\uBE44\uC2A4 \uAD6C\uC5ED \uACC4\uB2E8\uC774 \uC0B4\uD574
      \uC7A5\uC18C\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_034
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uADF8\uACF3\uC740 \uB2E4\uB2C8\uC5D8\uC758 \uB9C8\uC9C0\uB9C9 \uACF5\uAC1C
      \uB3D9\uC120\uC785\uB2C8\uB2E4. \uD608\uD754\uB3C4 \uC9C8\uC18C \uAE30\uB85D\uB3C4
      \uC5C6\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_035
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uCD5C\uC885 \uB17C\uC99D 3/6: \uC9C1\uC811 \uC0AC\uC778\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_036
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC9C8\uC18C \uB178\uCD9C\uC5D0 \uC758\uD55C \uC9C8\uC2DD"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_037
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC606\uAD6C\uB9AC \uC790\uC0C1\uC5D0 \uC758\uD55C \uACFC\uB2E4\uCD9C\uD608"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_038
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC138\uBA74\uB300 \uBB3C\uC5D0 \uC758\uD55C \uC775\uC0AC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_039
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC548\uC815\uC81C \uACFC\uB2E4\uBCF5\uC6A9"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_040
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC9C1\uC811 \uC0AC\uC778\uC740 \uC9C8\uC18C \uB178\uCD9C\uC5D0 \uC758\uD55C
      \uC9C8\uC2DD\uC785\uB2C8\uB2E4. \uC790\uC0C1\uC740 \uBE44\uCE58\uBA85\uC0C1\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_041
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uD3D0\xB7\uD608\uC561 \uC18C\uACAC\uACFC 21\uC2DC 43\uBD84 \uC9C8\uC18C
      \uD37C\uC9C0 \uB85C\uADF8\uAC00 \uC77C\uCE58\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_042
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC790\uC0C1 \uACFC\uB2E4\uCD9C\uD608\uC774 \uC9C1\uC811 \uC0AC\uC778\uC785\uB2C8\uB2E4."
