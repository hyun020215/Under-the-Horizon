    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uB85C\uBD07 \uC801\uC7AC \uD55C\uB3C4\uB294 40kg\uC774\uBA70 \uCE35\uAC04
      \uC774\uB3D9 \uAE30\uB85D\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4. \uD074\uB808\uC5B4
      \uC0AC\uAC74\uC758 \uC7A5\uCE58\uC640 \uD63C\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
