      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uC740 \uB2E4\uB2C8\uC5D8\uC774 \uB9AC\uCC98\uB4DC\uB97C
      \uC9C4\uBC94\uC73C\uB85C \uD655\uC2E0\uD55C\uB2E4\uB294 \uC810\uC744 \uC774\uC6A9\uD588\uC2B5\uB2C8\uB2E4.
      \uC120\uD0DD\uC801 \uB0B4\uBD80 \uC790\uB8CC\uC640 \uC704\uC870 \uCD08\uB300\uB85C
      \uD655\uC2E0\uC744 \uAC15\uD654\uD574 \uBC38\uB7EC\uC2A4\uD2B8\uB85C \uC720\uC778\uD588\uC2B5\uB2C8\uB2E4."
