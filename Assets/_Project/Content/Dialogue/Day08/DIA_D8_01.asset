      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC124\uACC4\uC790\uB294 \uC904\uB9AC\uC5B8 \uD638\uC190\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_084
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC904\uB9AC\uC5B8\uC740 \uC2B9\uAC1D\uC744 \uAD6C\uD558\uB824 \uD588\uC2B5\uB2C8\uB2E4.
      \uADF8 \uC9C0\uBAA9\uC740 15\uB144 \uC804\uC758 \uAC70\uC9D3\uB9D0\uC744 \uBC18\uBCF5\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_085
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC124\uACC4\uC790\uB294 \uD1A0\uBA38\uC2A4 \uB9AC\uB4DC\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_086
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uB098\uB294 \uCE68\uBB35\uD55C \uC99D\uC778\uC785\uB2C8\uB2E4. \uC6B4\uC601
      \uD0A4\uC640 \uC74C\uC131 \uBA85\uB839\uC740 \uC774\uBE14\uB9B0\uC744 \uAC00\uB9AC\uD0B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_087
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB17C\uC99D \uC2E4\uD328: \uD575\uC2EC \uC9C0\uBAA9 \uC624\uB958\uAC00
      \uB204\uC801\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC\uB97C \uBC94\uC778\uC73C\uB85C
      \uAE30\uB85D\uD558\uACE0 \uC2DC \uC5D4\uB529\uC73C\uB85C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_088
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0\uC740 \uB9AC\uCC98\uB4DC\uC758 \uC8C4\uB97C \uBC29\uD328\uB85C
      \uC37C\uC2B5\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC\uB294 \uC870\uC0AC\uAD00\uC744
      \uB9E4\uC218\uD558\uACE0 \uC9C4\uC2E4\uC744 \uC228\uACBC\uC9C0\uB9CC, \uB2E4\uB2C8\uC5D8\uC744
      \uBC38\uB7EC\uC2A4\uD2B8\uB85C \uC720\uC778\uD558\uACE0 \uC9C8\uC18C\uB97C
      \uD758\uB9B0 \uC0AC\uB78C\uC740 \uC774\uBE14\uB9B0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_089
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uCD08\uB300\uC7A5\uC740 \uBE44\uC11C\uC2E4 \uC11C\uBC84\uC5D0\uC11C \uBC1C\uC1A1\uB410\uACE0,
      \uC775\uBA85 \uC81C\uBCF4\uC758 \uBB38\uCCB4\uB294 \uC774\uBE14\uB9B0\uC758
      \uB9D0\uACFC \uC77C\uCE58\uD569\uB2C8\uB2E4. \uB9C8\uCEE4\uC2A4\uC758 \uD1A0\uD070\uACFC
      \uC774\uBE14\uB9B0\uC758 \uC6B4\uC601 \uAD8C\uD55C\uC774 \uAE08\uACE0\uC640
      \uB808\uC77C\uC744 \uC5F4\uC5C8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_090
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "22\uC2DC 18\uBD84, \uBC30\uB294 86kg\uC744 \uBC38\uB7EC\uC2A4\uD2B8\uC5D0\uC11C
      \uC774 \uBC29 \uC704\uB85C \uC62E\uACBC\uC2B5\uB2C8\uB2E4. \uC2DC\uC2E0\uC774
      \uB5A8\uC5B4\uC9C4 \uB4A4 \uC138\uBA74\uB300\uC640 \uB179\uC74C\uAE30\uAC00
      \uBC29\uC744 \uC644\uC131\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_091
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB9AC\uACE0 \uBCF4\uD638\uBA74 \uC548\uCABD\uC758 \uB2E4\uB2C8\uC5D8
      DNA\uB294 \uB2F9\uC2E0\uC774 \uC0B4\uD574 \uC21C\uAC04 \uADF8\uC640 \uB9C8\uC8FC\uD588\uB2E4\uB294
      \uB9C8\uC9C0\uB9C9 \uC99D\uAC70\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_092
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uBAA8\uB4E0 \uC870\uAC01\uC774 \uB9DE\uB294\uB2E4\uACE0 \uD574\uC11C
      \uB2F9\uC2E0\uC758 \uD574\uC11D\uB9CC \uC815\uB2F5\uC778 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_093
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "DNA\uB294 \uD574\uC11D\uC774 \uC544\uB2C8\uB77C \uC811\uCD09\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_094
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "86kg \uB85C\uADF8\uB3C4 \uD574\uC11D\uC774 \uC544\uB2C8\uB77C \uBB34\uAC8C\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_095
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC904\uB9AC\uC5B8\uC758 \uBAA9\uC18C\uB9AC\uB3C4 \uD574\uC11D\uC774 \uC544\uB2C8\uB77C
      \uAE30\uB85D\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_096
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB9AC\uACE0 \uB0B4 \uC740\uD3D0\uB294 \uB0B4 \uC8C4\uC694. \uADF8\uB140\uC758
      \uC0B4\uC778\uC744 \uB300\uC2E0\uD560 \uC218 \uC5C6\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_097
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBE14\uB9B0 \uC1FC, \uB2E4\uB2C8\uC5D8 \uBA38\uC11C \uC0B4\uD574\uC640
      \uC99D\uAC70 \uD6FC\uC190, \uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uCE68\uBAB0
      \uC870\uC791 \uD610\uC758\uB85C \uB2F9\uC2E0\uC744 \uC9C0\uBAA9\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_098
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB9C8\uC9C0\uB9C9 \uC120\uD0DD: \uB9AC\uCC98\uB4DC\uC758 \uACFC\uAC70
      \uC740\uD3D0\uB97C \uD568\uAED8 \uACF5\uAC1C\uD560\uC9C0 \uACB0\uC815\uD558\uC138\uC694."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_099
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC774\uBE14\uB9B0\uC758 \uBC94\uD589\uACFC \uB9AC\uCC98\uB4DC\uC758 \uC740\uD3D0\uB97C
      \uBAA8\uB450 \uACF5\uAC1C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_100
    speaker:
      character: {fileID: 0}
      overrideName: PLAYER_CHOICE
    text: "\uC774\uBE14\uB9B0\uC758 \uBC94\uD589\uB9CC \uACF5\uAC1C\uD558\uACE0 \uB9AC\uCC98\uB4DC\uC758
      \uC740\uD3D0\uB294 \uBE44\uACF5\uAC1C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_101
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uAE30\uB85D\uC740 \uC804\uBD80 \uACF5\uAC1C\uB429\uB2C8\uB2E4. \uC774\uBE14\uB9B0\uC758
      \uC0B4\uC778\uACFC \uB9AC\uCC98\uB4DC\uC758 \uC740\uD3D0, \uB458 \uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_102
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uADF8\uB807\uAC8C \uD558\uC2DC\uC624. \uC904\uB9AC\uC5B8\uC758 \uC774\uB984\uC744
      \uB418\uCC3E\uB294 \uB370 \uB2E4\uB978 \uBC29\uBC95\uC740 \uC5C6\uB124."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_103
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD68C\uC0AC\uB294 \uBB34\uB108\uC9C8 \uAC70\uC694\u2026 \uD558\uC9C0\uB9CC
      \uC774\uBC88\uC5D0\uB294 \uB0B4\uAC00 \uB9C9\uC9C0 \uC54A\uACA0\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_104
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0B4\uC778 \uC218\uC0AC \uAE30\uB85D\uC5D0\uB294 \uC774\uBE14\uB9B0\uC758
      \uBC94\uD589\uB9CC \uD3EC\uD568\uD569\uB2C8\uB2E4. \uB9AC\uCC98\uB4DC\uC758
      \uC740\uD3D0 \uC790\uB8CC\uB294 \uBCC4\uB3C4 \uBD09\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_105
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uB610 \uD558\uB098\uC758 \uC9C4\uC2E4\uC744 \uBC29 \uC548\uC5D0 \uB0A8\uACA8\uB450\uB294\uAD70\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-01_106
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC774\uBE14\uB9B0\uC774 \uC120\uBBF8 \uAC11\uD310\uC73C\uB85C \uC774\uB3D9\uD588\uC2B5\uB2C8\uB2E4.
      \uB9C8\uC9C0\uB9C9 \uB300\uCE58\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
