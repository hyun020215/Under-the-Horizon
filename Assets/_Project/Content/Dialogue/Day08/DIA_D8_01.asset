      overrideName: OWEN
    text: "86kg \uC548\uC815\uD654 \uB85C\uADF8\uC640 22\uC2DC 18\uBD84 \uAC10\uC9C0\uAE30
      \uC624\uB958\uAC00 \uB808\uC77C \uACBD\uB85C\uC640 \uC815\uD655\uD788 \uACB9\uCE69\uB2C8\uB2E4."
