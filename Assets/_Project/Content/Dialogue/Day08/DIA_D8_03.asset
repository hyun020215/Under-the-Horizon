%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D8_03
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D8_03
  lines:
  - id: D8-03_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC5D8\uB9AC\uC2DC\uC6C0 \uD638\uC774 \uD56D\uAD6C\uC5D0 \uB2FF\uC790
      \uC721\uC9C0\uC758 \uC18C\uC74C\uC774 \uBC30\uC758 \uAE30\uACC4\uC74C\uC744
      \uB36E\uC5C8\uB2E4. \uAC19\uC740 \uC2B9\uAC1D\uB4E4\uC774 \uB0B4\uB838\uC9C0\uB9CC,
      \uCD9C\uD56D \uB54C\uC640 \uAC19\uC740 \uC774\uC57C\uAE30\uB97C \uAC00\uC9C4
      \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_002
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC5D4\uB529 \uACB0\uACFC\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_003
    speaker:
      character: {fileID: 0}
      overrideName: NEWS_REPORT
    text: "\uC18D\uBCF4: \uD638\uC190 \uD574\uC6B4 COO \uC774\uBE14\uB9B0 \uC1FC\uAC00
      \uB2E4\uB2C8\uC5D8 \uBA38\uC11C \uC0B4\uD574\uC640 \uC624\uB974\uD398\uC6B0\uC2A4
      \uD638 \uCE68\uBAB0 \uC870\uC791 \uD610\uC758\uB85C \uCCB4\uD3EC\uB410\uC2B5\uB2C8\uB2E4.
      \uB9AC\uCC98\uB4DC \uD638\uC190 \uD68C\uC7A5\uC740 \uACFC\uAC70 \uC870\uC0AC
      \uBC29\uD574\uC640 \uB1CC\uBB3C \uC81C\uACF5\uC744 \uC778\uC815\uD588\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_004
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uD68C\uC0AC\uB294 \uC774\uC0AC\uD68C \uAD00\uB9AC \uCCB4\uC81C\uB85C
      \uB4E4\uC5B4\uAC11\uB2C8\uB2E4. \uBE44\uC790\uAE08 \uC790\uB8CC\uB3C4 \uB2F9\uAD6D\uC5D0
      \uB118\uACBC\uC5B4\uC694. \uC81C \uBAAB\uC758 \uBCC0\uBA85\uC740 \uBC95\uC815\uC5D0\uC11C
      \uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_005
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC904\uB9AC\uC5B8\uC758 \uACF5\uC2DD \uAE30\uB85D\uC774 \u2018\uC0AC\uACE0
      \uCC45\uC784\uC790\u2019\uC5D0\uC11C \u2018\uCE68\uBAB0 \uBC29\uC9C0 \uC2DC\uB3C4
      \uC911 \uC0AC\uB9DD\u2019\uC73C\uB85C \uC218\uC815\uB410\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_006
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "15\uB144 \uB2A6\uC5C8\uC9C0\uB9CC\u2026 \uB0B4 \uC544\uB4E4\uC774 \uC9D1\uC73C\uB85C
      \uB3CC\uC544\uC654\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_007
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uC0AC\uB9DD\uC9C4\uB2E8\uB3C4 \uC218\uC815\uB410\uC5B4\uC694.
      \uC0AC\uB9DD \uC2DC\uAC01, \uC7A5\uC18C, \uC9C1\uC811 \uC0AC\uC778 \uC804\uBD80\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_008
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uAE30\uACC4 \uB85C\uADF8\uB294 \uCC98\uC74C\uBD80\uD130 \uAC19\uC740
      \uB9D0\uC744 \uD588\uC2B5\uB2C8\uB2E4. \uC6B0\uB9AC\uAC00 \uB4E3\uB294 \uB370
      \uC624\uB798 \uAC78\uB838\uC744 \uBFD0\uC774\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_009
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC81C \uC778\uC99D \uC81C\uACF5\uACFC \uCC44\uBB34\uB3C4 \uC9C4\uC220\uD588\uC2B5\uB2C8\uB2E4.
      \uBA74\uC9C1\uB420 \uAC81\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uC774\uBC88\uC5D4
      \uAE30\uB85D\uC774 \uB0A8\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_010
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "[\uC870\uC0AC: \uB2E4\uB2C8\uC5D8\uC758 \uC218\uC815 \uAE30\uC0AC]"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_011
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC81C\uBAA9\uC740 \u2018\uC624\uB974\uD398\uC6B0\uC2A4 \uD638\uC758 \uC9C4\uBC94\uACFC,
      \uB0B4\uAC00 \uD2C0\uB9B0 \uC0AC\uB78C\u2019. \uCCAB \uBB38\uC7A5\uC740 \uB2E4\uB2C8\uC5D8\uC758
      \uB9AC\uCC98\uB4DC \uC624\uD310\uC744 \uD3B8\uC9D1\uC790 \uC8FC\uB85C \uBA85\uC2DC\uD558\uACE0
      \uC774\uBE14\uB9B0\uC758 \uC124\uACC4\uC640 \uB9AC\uCC98\uB4DC\uC758 \uC740\uD3D0\uB97C
      \uBD84\uB9AC\uD55C\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_012
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uB2E8\uC11C \uD68D\uB4DD: C-18 \uC218\uC815 \uAE30\uC0AC"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC644\uC804\uD55C \uC9C4\uC2E4\uC740 \uC544\uBB34\uB3C4 \uAD6C\uD574
      \uC8FC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uB204\uAD6C\uC758
      \uC8C4\uAC00 \uB204\uAD6C\uC758 \uAC83\uC778\uC9C0 \uB3CC\uB824\uB193\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_014
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC5D4\uB529 \uC5D0\uC774 - \uC644\uC804\uD55C \uADC0\uD658"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_015
    speaker:
      character: {fileID: 0}
      overrideName: NEWS_REPORT
    text: "\uC18D\uBCF4: \uC774\uBE14\uB9B0 \uC1FC\uAC00 \uB2E4\uB2C8\uC5D8 \uBA38\uC11C
      \uC0B4\uD574 \uD610\uC758\uB85C \uCCB4\uD3EC\uB410\uC2B5\uB2C8\uB2E4. \uD638\uC190
      \uD574\uC6B4\uC740 \uB3C5\uB9BD \uC218\uC0AC\uC5D0 \uC804\uBA74 \uD611\uC870\uD588\uB2E4\uACE0
      \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_016
    speaker:
      character: {fileID: 11400000, guid: 99dea77ccfe60e6488bf2f60fd73b4a4, type: 2}
      overrideName: RICHARD
    text: "\uD68C\uC0AC\uB294 \uC0B4\uC544\uB0A8\uC744 \uAC70\uC694. \uC9C1\uC6D0\uACFC
      \uC2B9\uAC1D \uBCF4\uC0C1\uB3C4 \uACC4\uC18D\uD560 \uC218 \uC788\uB124. \uB2F9\uC2E0
      \uC120\uD0DD\uC740 \uC2E4\uC6A9\uC801\uC774\uC5C8\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_017
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC904\uB9AC\uC5B8\uC758 \uAE30\uB85D\uC740 \uB0B4\uBD80 \uC815\uC815\uC5D0
      \uADF8\uCCE4\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C \uBB38\uC11C\uC5D0\uB294 \uC5EC\uC804\uD788
      \u2018\uAD00\uB9AC \uC2E4\uD328\u2019\uB77C\uACE0 \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_018
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC0AC\uB78C\uB4E4\uC740 \uD55C \uBA85\uC758 \uBC94\uC778\uC73C\uB85C
      \uB9CC\uC871\uD560 \uAC70\uC608\uC694. \uD68C\uC0AC\uB3C4, \uC2DC\uC7A5\uB3C4,
      \uAE30\uC0AC\uB3C4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_019
    speaker:
      character: {fileID: 11400000, guid: 27fd81a8d6a20df42936ea19be2665f7, type: 2}
      overrideName: HELENA
    text: "\uB2E4\uB2C8\uC5D8\uC758 \uC0AC\uB9DD \uAE30\uB85D\uC740 \uBC14\uB85C\uC7A1\uD614\uC9C0\uB9CC
      \uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uD53C\uD574\uC790 \uAE30\uB85D\uC740
      \uBD09\uC778\uB410\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_020
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC6B0\uB9AC\uB294 \uC5F4\uB9B0 \uBB38\uC744 \uD574\uACB0\uD558\uACE0,
      \uB2E4\uB978 \uBB38\uC744 \uC7A0\uAC14\uC2B5\uB2C8\uB2E4. \uD754\uC801\uC774
      \uB0A8\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uBA74\uC11C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_021
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC5D4\uB529 \uBE44 - \uD3B8\uB9AC\uD55C \uBC94\uC778"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_022
    speaker:
      character: {fileID: 0}
      overrideName: NEWS_REPORT
    text: "\uB9AC\uCC98\uB4DC \uD638\uC190 \uD68C\uC7A5\uC774 \uB2E4\uB2C8\uC5D8
      \uBA38\uC11C \uC0B4\uD574\uC640 \uC624\uB974\uD398\uC6B0\uC2A4 \uD638 \uC0AC\uAC74
      \uAD00\uB828 \uD610\uC758\uB85C \uAD6C\uAE08\uB410\uC2B5\uB2C8\uB2E4. \uC774\uBE14\uB9B0
      \uC1FC COO\uB294 \uB2E4\uC74C \uAE30\uD56D\uC9C0\uC5D0\uC11C \uD589\uBC29\uC774
      \uD655\uC778\uB418\uC9C0 \uC54A\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_023
    speaker:
      character: {fileID: 11400000, guid: 8582caea0d2b3204bad2ba188e71e46d, type: 2}
      overrideName: CLAIRE
    text: "\uC0BC\uCD0C\uC740 \uBAA8\uB4E0 \uAC78 \uC228\uACBC\uC5B4\uC694. \uADF8\uB7EC\uB2C8
      \uBAA8\uB450\uAC00 \uADF8\uB97C \uBBFF\uB294 \uAC8C \uB2F9\uC5F0\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uC8E0. \uC6B0\uB9AC\uB3C4 \uB2E4\uB2C8\uC5D8\uACFC \uAC19\uC740
      \uC2E4\uC218\uB97C \uD588\uB124\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_024
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uBCF5\uC6D0 \uC74C\uC131\uC740 \uACF5\uAC1C\uB418\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uC904\uB9AC\uC5B8\uC740 \uB610 \uD55C \uBC88 \uBC94\uC778 \uACC1\uC5D0 \uBB3B\uD614\uC18C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_025
    speaker:
      character: {fileID: 11400000, guid: 87372f6a812eed34c9efc03f7f51d8af, type: 2}
      overrideName: OWEN
    text: "\uC548\uC815\uD654 \uB85C\uADF8 22:17, 86kg. \uC0AC\uAC74 \uD30C\uC77C\uC5D0\uB294
      \u2018\uC124\uBA85 \uBD88\uAC00\u2019\uB85C \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_026
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD2C0\uB9B0 \uC0AC\uB78C\uC744 \uC9C0\uBAA9\uD558\uBA74 \uC0AC\uAC74\uC740
      \uB2EB\uD788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uC9C4\uC9DC \uBC94\uC778\uC774
      \uB098\uAC08 \uBB38\uC744 \uC5F4\uC5B4 \uC904 \uBFD0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_027
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC5D4\uB529 \uC2DC - \uC798\uBABB \uC9C0\uBAA9\uB41C \uC0AC\uB78C"
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_028
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC2B9\uAC1D \uBD88\uC548\uC774 \uD3ED\uBC1C\uD558\uC790 \uC81C\uD55C\uAD6C\uC5ED
      \uBB38\uC774 \uAC15\uC81C\uB85C \uC5F4\uB838\uACE0, \uAE08\uACE0 \uD654\uC7AC\uACBD\uBCF4
      \uC18D\uC5D0\uC11C \uC6D0\uBCF8 \uBAA8\uB4C8\uC774 \uD30C\uAD34\uB410\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_029
    speaker:
      character: {fileID: 11400000, guid: 2773ca752447b4543be81c90ef6ddda6, type: 2}
      overrideName: THOMAS
    text: "\uC120\uB0B4 \uC9C8\uC11C\uB97C \uC720\uC9C0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uC218\uC0AC\uB97C \uC911\uB2E8\uD558\uACE0 \uBE44\uC0C1 \uC785\uD56D\uD569\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_030
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC99D\uAC70 \uC5C6\uB294 \uC9C4\uC2E4\uC740 \uC18C\uBB38\uC785\uB2C8\uB2E4.
      \uC18C\uBB38\uC740 \uB204\uAD6C\uB3C4 \uCCB4\uD3EC\uD558\uC9C0 \uBABB\uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-03_031
    speaker:
