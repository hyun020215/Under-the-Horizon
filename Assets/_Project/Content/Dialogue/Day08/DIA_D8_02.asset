%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 095a65fbf799fe24caef37230cb0482e, type: 3}
  m_Name: DIA_D8_02
  m_EditorClassIdentifier: UTH.Runtime::DialogueSequence
  id: DIA_D8_02
  lines:
  - id: D8-02_001
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC120\uBBF8 \uAC11\uD310\uC5D0\uC11C \uBC14\uB78C\uC740 \uBAA8\uB4E0
      \uB9D0\uC744 \uC721\uC9C0 \uBC18\uB300\uCABD\uC73C\uB85C \uBC00\uC5B4\uB0C8\uB2E4.
      \uC774\uBE14\uB9B0\uC740 \uB09C\uAC04 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uC9C0\uB9CC
      \uB3C4\uB9DD\uCE60 \uACF3\uC744 \uACC4\uC0B0\uD558\uB294 \uB208\uC740 \uC544\uB2C8\uC5C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_002
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC624\uB974\uD398\uC6B0\uC2A4 \uD638\uAC00 \uCE68\uBAB0\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74
      \uD68C\uC0AC\uB294 \uD30C\uC0B0\uD588\uC744 \uAC81\uB2C8\uB2E4. \uC870\uC120\uC18C\uC640
      \uD56D\uAD6C \uB3C4\uC2DC, \uC218\uCC9C \uBA85\uC774 \uC77C\uC790\uB9AC\uB97C
      \uC783\uC5C8\uACA0\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_003
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB798\uC11C \uC2B9\uAC1D\uC774 \uD0C4 \uBC30\uB97C \uBCF4\uD5D8\uAE08\uC73C\uB85C
      \uBC14\uAFE8\uC2B5\uB2C8\uAE4C?"
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_004
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uD53C\uD574\uB97C \uC81C\uD55C\uD558\uB824 \uD588\uC2B5\uB2C8\uB2E4.
      \uC904\uB9AC\uC5B8\uC774 \uC808\uCC28\uB97C \uBC29\uD574\uD574 \uADE0\uD615\uC774
      \uBB34\uB108\uC84C\uACE0, \uB9AC\uCC98\uB4DC\uB294 \uADF8 \uB4A4\uC5D0 \uD544\uC694\uD55C
      \uC77C\uC744 \uD588\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_005
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uD544\uC694\uD55C \uC77C\uC774 \uC544\uB2C8\uB77C \uD3B8\uB9AC\uD55C
      \uC77C\uC774\uC5C8\uC2B5\uB2C8\uB2E4. \uC8FD\uC740 \uC0AC\uB78C\uC5D0\uAC8C
      \uCC45\uC784\uC744 \uB118\uAE30\uB294 \uC77C."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_006
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB2E4\uB2C8\uC5D8\uB3C4 \uB611\uAC19\uC558\uC2B5\uB2C8\uB2E4. \uBCF5\uC7A1\uD55C
      \uC9C4\uC2E4\uBCF4\uB2E4 \uB9AC\uCC98\uB4DC\uB77C\uB294 \uC5BC\uAD74\uC744
      \uC6D0\uD588\uC8E0. \uB098\uB294 \uADF8\uAC00 \uC6D0\uD558\uB294 \uAE38\uC744
      \uBCF4\uC5EC \uC92C\uC744 \uBFD0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_007
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uADF8\uB9AC\uACE0 \uADF8 \uAE38 \uB05D\uC5D0\uC11C \uC0B0\uC18C\uB97C
      \uBE7C\uC557\uC558\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_008
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uB098\uB294 \uD68C\uC0AC\uB97C \uC0B4\uB838\uC5B4\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_009
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uC758 \uC218\uAC00 \uC8FD\uC778
      \uC0AC\uB78C\uC758 \uC8C4\uB97C \uB098\uB220 \uAC16\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices:
    - id: D8-02_C1
      text: "\u201C\uB2F9\uC2E0\uC740 \uD68C\uC0AC\uB97C \uC0B4\uB9B0 \uAC8C \uC544\uB2C8\uB77C
        \uC8C4\uB97C \uC5F0\uC7A5\uD588\uC2B5\uB2C8\uB2E4.\u201D"
      conditions: []
      effects:
      - {fileID: 11400000, guid: e4f8f7e29a81db548ae9ad0c003dcf14, type: 2}
      nextLineId: D8-02_013
    - id: D8-02_C2
      text: "\u201C\uB2F9\uC2E0\uC774 \uB9D0\uD55C \uBE44\uC6A9\uC740 \uB298 \uB2E4\uB978
        \uC0AC\uB78C\uC774 \uCE58\uB800\uC2B5\uB2C8\uB2E4.\u201D"
      conditions: []
      effects:
      - {fileID: 11400000, guid: daff835ff2a61c6478d82aae92322f6d, type: 2}
      nextLineId: D8-02_015
    - id: D8-02_C3
      text: "\u201C\uC774\uC81C \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC774
        \uC9C1\uC811 \uC9C4\uC2E4\uC744 \uC120\uD0DD\uD560 \uAC81\uB2C8\uB2E4.\u201D"
      conditions: []
      effects:
      - {fileID: 11400000, guid: 817f4499768d8324494c201bd2f49663, type: 2}
      nextLineId: D8-02_017
  - id: D8-02_013
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC740 \uD68C\uC0AC\uB97C \uC0B4\uB9B0 \uAC8C \uC544\uB2C8\uB77C
      \uC8C4\uB97C \uC5F0\uC7A5\uD588\uC2B5\uB2C8\uB2E4. \uC624\uB974\uD398\uC6B0\uC2A4
      \uD638\uC5D0\uC11C \uC2DC\uC791\uD55C \uBC00\uC2E4\uC744 \uB2E4\uB2C8\uC5D8\uC758
      \uC8FD\uC74C\uC73C\uB85C \uD55C \uBC88 \uB354 \uB2EB\uC558\uC744 \uBFD0\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: a04dd06b34c8e464791aa9b9460fbef4, type: 2}
    effects: []
    choices: []
  - id: D8-02_014
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uC8C4\uB294 \uACB0\uACFC\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC0AC\uB78C\uB4E4\uC740 \uD68C\uC0AC\uAC00 \uC81C\uACF5\uD55C \uC0B6\uC744
      \uAE30\uC5B5\uD560 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: a04dd06b34c8e464791aa9b9460fbef4, type: 2}
    effects: []
    choices: []
  - id: D8-02_015
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uB2F9\uC2E0\uC774 \uB9D0\uD55C \uBE44\uC6A9\uC740 \uB298 \uB2E4\uB978
      \uC0AC\uB78C\uC774 \uCE58\uB800\uC2B5\uB2C8\uB2E4. \uC2B9\uAC1D, \uC904\uB9AC\uC5B8,
      \uB2E4\uB2C8\uC5D8, \uB9C8\uCEE4\uC2A4. \uC774\uBC88 \uBE44\uC6A9\uC740 \uB2F9\uC2E0
      \uBAAB\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 152e1c903a5343c4182bf1b9a76627be, type: 2}
    effects: []
    choices: []
  - id: D8-02_016
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uACF5\uD3C9\uD568\uC740 \uD68C\uACC4 \uC7A5\uBD80\uC5D0\uB9CC \uC874\uC7AC\uD558\uC8E0."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 152e1c903a5343c4182bf1b9a76627be, type: 2}
    effects: []
    choices: []
  - id: D8-02_017
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uC81C \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC9C1\uC811
      \uC9C4\uC2E4\uC744 \uC120\uD0DD\uD560 \uAC81\uB2C8\uB2E4. \uB2F9\uC2E0\uC774
      \uB300\uC2E0 \uACC4\uC0B0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5b7898c6760d26449b5cfcddeed8b7e3, type: 2}
    effects: []
    choices: []
  - id: D8-02_018
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uADF8\uB4E4\uC774 \uC5B4\uB5A4 \uC120\uD0DD\uC744 \uD558\uB294\uC9C0
      \uBCF4\uC138\uC694. \uACB0\uAD6D \uB204\uAD70\uAC00\uB294 \uB2E4\uC2DC \uC815\uB9AC\uD574\uC57C
      \uD560 \uAC81\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions:
    - {fileID: 11400000, guid: 5b7898c6760d26449b5cfcddeed8b7e3, type: 2}
    effects: []
    choices: []
  - id: D8-02_019
    speaker:
      character: {fileID: 11400000, guid: e1e53316d69c50e43ac1baded7ce3c54, type: 2}
      overrideName: MARCUS
    text: "\uC774\uBE14\uB9B0 \uC1FC, \uB4A4\uB85C \uBB3C\uB7EC\uC11C\uC2ED\uC2DC\uC624.
      \uC190\uC744 \uBCF4\uC774\uB294 \uACF3\uC5D0 \uB450\uC138\uC694."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_020
    speaker:
      character: {fileID: 0}
      overrideName: NARRATION
    text: "\uC774\uBE14\uB9B0\uC740 \uB09C\uAC04\uC5D0\uC11C \uD55C \uAC78\uC74C
      \uBB3C\uB7EC\uB0AC\uB2E4. \uCCB4\uD3EC \uC21C\uAC04\uC5D0\uB3C4 \uADF8\uB140\uB294
      \uC800\uD56D\uBCF4\uB2E4 \uC808\uCC28\uB97C \uC120\uD0DD\uD588\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_021
    speaker:
      character: {fileID: 11400000, guid: fdd5bfea0f994cb4f83fdab6046bacb3, type: 2}
      overrideName: EVELYN
    text: "\uAE30\uB85D\uC740 \uB204\uAC00 \uAD00\uB9AC\uD558\uC8E0, \uD0D0\uC815\uB2D8?
      \uC9C4\uC2E4\uB3C4 \uACB0\uAD6D \uD30C\uC77C \uD558\uB098\uC785\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_022
    speaker:
      character: {fileID: 11400000, guid: deea118744593fa4883b9fc7691a6c13, type: 2}
      overrideName: ADRIAN
    text: "\uC774\uBC88\uC5D0\uB294 \uBCF5\uC0AC\uBCF8\uC774 \uB9CE\uC2B5\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 1
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
  - id: D8-02_023
    speaker:
      character: {fileID: 0}
      overrideName: SYSTEM
    text: "\uC774\uBE14\uB9B0 \uCCB4\uD3EC. \uB300\uCE58 \uACFC\uC815\uC758 \uC120\uD0DD\uC774
      \uACB0\uB9D0\uC5D0 \uBC18\uC601\uB429\uB2C8\uB2E4."
    expression: 0
    voiceRequired: 0
    voiceClip: {fileID: 0}
    conditions: []
    effects: []
    choices: []
